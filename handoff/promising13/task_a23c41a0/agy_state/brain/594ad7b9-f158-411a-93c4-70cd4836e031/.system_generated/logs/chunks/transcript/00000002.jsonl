":{"CaseInsensitive":"false","Includes":"[\"*.lean\"]","IsRegex":"false","MatchPerLine":"true","Query":"\"minUpTo\"","SearchPath":"\"/mnt/home/japake298/project/GraphConjecturing\"","toolAction":"\"Searching for minUpTo in repo\"","toolSummary":"\"Grep minUpTo in repo\""}}]}
