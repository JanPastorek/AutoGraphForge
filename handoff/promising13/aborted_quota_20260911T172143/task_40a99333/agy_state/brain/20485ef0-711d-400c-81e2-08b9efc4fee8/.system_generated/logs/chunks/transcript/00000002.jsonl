python -c '\\nimport random, itertools, time\\nimport numpy as np\\nimport scipy.optimize\\n\\ndef check_graph(n, edges):\\n    adj_matrix = np.zeros((n, n))\\n    for u, v in edges:\\n        adj_matrix[u, v] = 1\\n        adj_matrix[v, u] = 1\\n    if any(adj_matrix.sum(axis=1) == 0):\\n        return None, None\\n    \\n    # 1. Total domination\\n    c_t = np.ones(n)\\n    res_t = scipy.optimize.milp(c=c_t, constraints=scipy.optimize.LinearConstraint(adj_matrix, 1, np.inf),\\n                                integrality=np.ones(n), bounds=scipy.optimize.Bounds(0, 1))\\n    gt = int(round(res_t.fun))\\n    \\n    # 2. Roman domination\\n    c_R = np.concatenate([np.ones(n), 2*np.ones(n)])\\n    A1 = np.hstack([np.eye(n), np.eye(n) + adj_matrix])\\n    A2 = np.hstack([np.eye(n), np.eye(n)])\\n    A_R = np.vstack([A1, A2])\\n    b_l = np.concatenate([np.ones(n), np.zeros(n)])\\n    b_u = np.concatenate([np.full(n, np.inf), np.ones(n)])\\n    res_R = scipy.optimize.milp(c=c_R, constraints=scipy.optimize.LinearConstraint(A_R, b_l, b_u),\\n                                integrality=np.ones(2*n), bounds=scipy.optimize.Bounds(0, 1))\\n    gr = int(round(res_R.fun))\\n    return gt, gr\\n\\nprint(\\\"Testing n=11..16...\\\")\\nfor n in [11, 12, 14, 16]:\\n    t0 = time.time()\\n    max_diff = -999\\n    all_pairs = list(itertools.combinations(range(n), 2))\\n    for trial in range(100):\\n        edges = [e for e in all_pairs if random.random() < 0.25]\\n        gt, gr = check_graph(n, edges)\\n        if gt is not None:\\n            if gt - gr > max_diff:\\n                max_diff = gt - gr\\n            if gt > gr:\\n                print(f\\\"COUNTEREXAMPLE FOUND at n={n}! edges={edges}, gt={gt}, gr={gr}\\\")\\n                exit(0)\\n    print(f\\\"n={n} (100 trials): max diff = {max_diff} in {time.time()-t0:.1f}s\\\")\\n'\"","Cwd":"\"/mnt/home/japake298/project/GraphConjecturing/handoff/promising13/task_40a99333\"","WaitMsBeforeAsync":"10000","toolAction":"\"Testing larger n with MILP\"","toolSummary":"\"Check larger n for counterexample\""}}]}
