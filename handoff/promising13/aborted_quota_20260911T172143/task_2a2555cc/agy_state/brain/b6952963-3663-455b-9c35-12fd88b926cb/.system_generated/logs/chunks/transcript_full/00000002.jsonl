\"domination_number \\u003e= 1/2 total_domination_number\\\",\"}\n{\"File\":\"/mnt/home/japake298/project/GraphConjecturing/pipeline/known_relations.py\",\"LineNumber\":222,\"LineContent\":\"    \\\"total_domination_number \\u003e= 1/2 roman_domination_number\\\",\"}\n{\"File\":\"/mnt/home/japake298/project/GraphConjecturing/pipeline/known_relations.py\",\"LineNumber\":226,\"LineContent\":\"    \\\"total_domination_number \\u003c= 2 domination_number\\\",\"}\n{\"File\":\"/mnt/home/japake298/project/GraphConjecturing/pipeline/known_relations.py\",\"LineNumber\":227,\"LineContent\":\"    \\\"total_domination_number \\u003c= 2 independent_domination_number\\\",\"}\n{\"File\":\"/mnt/home/japake298/project/GraphConjecturing/pipeline/known_relations.py\",\"LineNumber\":231,\"LineContent\":\"    \\\"total_domination_number \\u003c= order + -1\\\",\"}\n{\"File\":\"/mnt/home/japake298/project/GraphConjecturing/pipeline/known_relations.py\",\"LineNumber\":240,\"LineContent\":\"    \\\"sub_total_domination_number \\u003c= total_domination_number\\\",\"}\n{\"File\":\"/mnt/home/japake298/project/GraphConjecturing/pipeline/known_relations.py\",\"LineNumber\":241,\"LineContent\":\"    \\\"sub_total_domination_number \\u003e= slater\\\",\"}\n{\"File\":\"/mnt/home/japake298/project/GraphConjecturing/pipeline/known_relations.py\",\"LineNumber\":248,\"LineContent\":\"    \\\"independent_domination_number \\u003e= 1/2 total_domination_number\\\",\"}\n{\"File\":\"/mnt/home/japake298/project/GraphConjecturing/pipeline/known_relations.py\",\"LineNumber\":284,\"LineContent\":\"    \\\"slater \\u003c= sub_total_domination_number\\\",\"}\n{\"File\":\"/mnt/home/japake298/project/GraphConjecturing/pipeline/known_relations.py\",\"LineNumber\":288,\"LineContent\":\"    \\\"total_domination_number \\u003c= 2 edge_domination_number\\\",\"}\n{\"File\":\"/mnt/home/japake298/project/GraphConjecturing/pipeline/known_relations.py\",\"LineNumber\":307,\"LineContent\":\"    \\\"total_domination_number \\