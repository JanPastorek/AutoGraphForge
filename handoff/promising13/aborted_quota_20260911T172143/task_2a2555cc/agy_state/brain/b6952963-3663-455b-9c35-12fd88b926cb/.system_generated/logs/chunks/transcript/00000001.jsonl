             \"G.order\",\n30:     \"size\":                          \"G.size\",\n31:     \"minimum_degree\":                \"G.minDegree\",\n32:     \"maximum_degree\":                \"G.maxDegree\",\n33:     \"cl\n<truncated 1777 bytes>\negular\": \"IsRegularClass\", \"cubic\": \"IsCubicClass\",\n65:     \"subcubic\": \"IsSubcubicClass\", \"triangle_free\": \"IsTriangleFreeClass\",\n66:     \"K_4_free\": \"IsK4FreeClass\", \"bipartite\": \"IsBipartiteClass\",\n67:     \"eulerian\": \"IsEulerianClass\",\n68:     # mathlib has these directly (`Connected`, `IsTree`)\n69:     \"connected\": \"IsConnectedClass\", \"tree\": \"IsTreeClass\",\n70:     # forbidden induced subgraph on four vertices: K₁,₃ and P₄ respectively\n71:     \"claw_free\": \"IsClawFreeClass\", \"cograph\": \"IsCographClass\",\n72:     # graphcalc's auto-base hypothesis on every Graffiti3 conjecture: |V| ≥ 2.\n73:     \"nontrivial\": \"IsNontrivialClass\",\n74: }\n75: _REL_LEAN = {\"≤\": \"≤\", \"≥\": \"≥\", \"<=\": \"≤\", \">=\": \"≥\", \"=\": \"=\"}\n76: \n77: \n78: def _condition_classes(cond: str, columns) -> List[str]:\n79:     return [c for c in columns if re.search(r\"\\b\" + re.escape(c) + r\"\\b\", cond)]\n80: \n81: \n82: def _bare_invariant(side: str, columns) -> Optional[str]:\n83:     \"\"\"A side that is exactly one supported invariant (no coefficient/offset/\n84:     product), else None.\"\"\"\n85:     invs = [c for c in columns if re.search(r\"\\b\" + re.escape(c) + r\"\\b\", side)]\n86:     if len(invs) != 1 or invs[0] not in SUPPORTED:\n87:         return None\n88:     leftover = re.sub(r\"\\b\" + re.escape(invs[0]) + r\"\\b\", \" \", side)\n89:     leftover = re.sub(r\"[()\\s]\", \"\", leftover)        # parens/space ok\n90:     return invs[0] if not leftover else None           # any coeff/const → reject\n91: \n92: \n93: def render_conditioned(native, columns) -> Optional[str]:\n94:     \"\"\"Self-rendered theorem for a class-conditioned conjecture with a simple\n95:     ``invariant REL invariant`` body, else None. The hypothesis is the conjunction\n96:     of supported class predicates.\"\"\"\n97:     try:\n98:         pretty = native.pretty()\n99:     except Exception:\n100:         return None\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n","truncated_fields":["content"]}
