nset.card_univ] at h_sum_ge\n40:   have h2 : 2 ≤ ∑ v : V, (f v : ℕ) := hnt.trans h_sum_ge\n41:   omega\n42: \n43: lemma two_le_romanDominationNumber {V : Type} [Fintype V] [DecidableEq V]\n44:     (G : SimpleGraph V) [DecidableRel G.Adj]\n45:     (hnt : GraphCalc.IsNontrivialClass G) :\n46:     2 ≤ GraphCalc.romanDominationNumber G := by\n47:   unfold GraphCalc.romanDominationNumber\n48:   let S := (Finset.univ.filter (GraphCalc.IsRomanDominatingFunction G)).image GraphCalc.romanWeight\n49:   have hconst : (fun _ : V => (2 : Fin 3)) ∈ Finset.univ.filter (GraphCalc.IsRomanDominatingFunction G) := by\n50:     rw [Finset.mem_filter]\n51:     refine ⟨Finset.mem_univ _, ?_⟩\n52:     intro v hv\n53:     have h20 : (2 : Fin 3) ≠ 0 := by decide\n54:     exact False.elim (h20 hv)\n55:   have hSne : S.Nonempty := by\n56:     use GraphCalc.romanWeight (fun _ : V => (2 : Fin 3))\n57:     apply Finset.mem_image_of_mem\n58:     exact hconst\n59:   obtain ⟨m, hm⟩ := Finset.min_of_nonempty hSne\n60:   rw [hm]\n61:   dsimp\n62:   have hmem : m ∈ S := Finset.mem_of_min hm\n63:   rw [Finset.mem_image] at hmem\n64:   obtain ⟨f, hf, rfl⟩ := hmem\n65:   rw [Finset.mem_filter] at hf\n66:   exact two_le_romanWeight G hnt f hf.2\n67: \n68: \nThe above content shows the entire, complete file contents of the requested file.\n"}
