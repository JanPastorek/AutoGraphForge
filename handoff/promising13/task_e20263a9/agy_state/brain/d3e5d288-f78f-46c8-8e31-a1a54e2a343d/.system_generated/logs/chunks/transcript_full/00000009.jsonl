ce\\n490: \\n491: def doubleRomanWeight (f : V → Fin 4) : ℕ := ∑ v : V, (f v : ℕ)\\n492: \\n493: /-- Total, for the same reason as `romanDominationNumber`: constant `3` works. -/\\n494: def doubleRomanDominationNumber (G : SimpleGraph V) [DecidableRel G.Adj] : ℕ :=\\n495:   (((univ.filter (IsDoubleRomanDominatingFunction G)).image\\n496:     doubleRomanWeight).min).getD 0\\n497: \\n498: /- ── radius ───────────────────────────────────────────────────────────────── -/\\n499: \\n500: /-- Vertices within `k` steps of `v`, by iterated neighbourhood expansion.\\n501: Distance is not available to the kernel directly (`SimpleGraph.dist` is defined\\n502: through `sInf` over walk lengths), so it is reconstructed as reachability. -/\\n503: def ballWithin (G : SimpleGraph V) [DecidableRel G.Adj] : ℕ → V → Finset V\\n504:   | 0,       v => {v}\\n505:   | (k + 1), v =>\\n506:       let B := ballWithin G k v\\n507:       B ∪ B.biUnion (fun u => univ.filter (fun w => G.Adj u w))\\n508: \\n509: /-- Eccentricity of `v`: least `k` with every vertex within `k` steps. -/\\n510: def eccentricity (G : SimpleGraph V) [DecidableRel G.Adj] (v : V) : ℕ :=\\n511:   minUpTo (Fintype.card V) (fun k => ballWithin G k v = univ)\\n512: \\n513: def radius (G : SimpleGraph V) [DecidableRel G.Adj] : ℕ :=\\n514:   ((univ.image (eccentricity G)).min).getD 0\\n515: \\n516: /-- Undefined on a disconnected graph, where some vertex never reaches all of\\n517: `univ` and `minUpTo` would fall back to `n`. networkx raises there. -/\\n518: def HasRadius (G : SimpleGraph V) [DecidableRel G.Adj] : Prop :=\\n519:   ∀ v : V, ballWithin G (Fintype.card V) v = univ\\n520: \\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\\n\",\"truncated_fields\":[\"content\"]}\n25: {\"step_index\":24,\"source\":\"MODEL\",\"type\":\"PLANNER_RESPONSE\",\"status\":\"DONE\",\"created_at\":\"2026-09