adius\n36:   have hmem : GraphCalc.eccentricity G v ∈ Finset.image (GraphCalc.eccentricity G) Finset.univ := by\n37:     apply Finset.mem_image_of_mem\n38:     exact Finset.mem_univ v\n39:   obtain ⟨b, hb⟩ := Finset.min_of_mem hmem\n40:   rw [hb]\n41:   have hle : (Finset.image (GraphCalc.eccentricity G) Finset.univ).min ≤ ↑(GraphCalc.eccentricity G v) :=\n42:     Finset.min_le hmem\n43:   rw [hb] at hle\n44:   exact WithTop.coe_le_coe.mp hle\n45: \n46: lemma le_romanDominationNumber {V : Type} [Fintype V] [DecidableEq V]\n47:     (G : SimpleGraph V) [DecidableRel G.Adj] (k : ℕ)\n48:     (h : ∀ f : V → Fin 3, GraphCalc.IsRomanDominatingFunction G f → k ≤ GraphCalc.romanWeight f) :\n49:     k ≤ GraphCalc.romanDominationNumber G := by\n50:   unfold GraphCalc.romanDominationNumber\n51:   have h_ex : ∃ f : V → Fin 3, GraphCalc.IsRomanDominatingFunction G f := by\n52:     use (fun _ => 2)\n53:     intro v hv\n54:     dsimp at hv\n55:     have h_false : False := by\n56:       revert hv\n57:       decide\n58:     contradiction\n59:   rcases h_ex with ⟨f₀, hf₀⟩\n60:   have h_mem : GraphCalc.romanWeight f₀ ∈ (Finset.univ.filter (GraphCalc.IsRomanDominatingFunction G)).image GraphCalc.romanWeight := by\n61:     rw [Finset.mem_image]\n62:     exact ⟨f₀, Finset.mem_filter.mpr ⟨Finset.mem_univ f₀, hf₀⟩, rfl⟩\n63:   have h_nonempty : ((Finset.univ.filter (GraphCalc.IsRomanDominatingFunction G)).image GraphCalc.romanWeight).Nonempty :=\n64:     ⟨GraphCalc.romanWeight f₀, h_mem⟩\n65:   obtain ⟨m, hm⟩ := Finset.min_of_nonempty h_nonempty\n66:   rw [hm]\n67:   dsimp\n68:   have hm_in := Finset.mem_of_min hm\n69:   rw [Finset.mem_image] at hm_in\n70:   rcases hm_in with ⟨f_min, hf_min, rfl⟩\n71:   rw [Finset.mem_filter] at hf_min\n72:   exact h f_min hf_min.2\n73: \n74: lemma two_le_romanWeight {V : Type} [Fintype V] [DecidableEq V]\n75:     (G : SimpleGraph V) [DecidableRel G.Adj]\n76:     (hnt : GraphCalc.IsNontrivialClass G) (f : V → Fin 3)\n77:     (hf : GraphCalc.IsRomanDominatingFunction G f) :\n78:     2 ≤ GraphCalc.romanWeight f := by\n79:   unfold GraphCalc.romanWeight\n80:   unfold GraphCalc.IsNontrivialClass at hnt\n81:   unfold GraphCalc.order at hnt\n82:   by_contra hc\n83:   have h_le1 : ∑ v : V, (f v : ℕ) ≤ 1 := by omega\n84:   have h_no2 : ∀ v : V, (f v : ℕ) ≠ 2 := by\n85:     intro v hv\n86:     have h_mem := Finset.single_le_sum (fun u _ => Nat.zero_le (f u : ℕ)) (Finset.mem_univ v)\n87:     rw [hv] at h_mem\n88:     omega\n89:   have h_no0 : ∀ v : V, (f v : ℕ) ≠ 0 := by\n90:     intro v hv\n91:     have h_f0 : f v = 0 := by\n92:       ext\n93:       exact hv\n94:     obtain ⟨u, _, hu2⟩ := hf v h_f0\n95:     have hu2_nat : (f u : ℕ) = 2 := by\n96:       rw [hu2]\n97:       rfl\n98:     exact h_no2 u hu2_nat\n99:   have h_ge1 : ∀ v : V, 1 ≤ (f v : ℕ) := by\n100:     intro v\n101:     have h0 := h_no0 v\n102:     omega\n103:   have h_sum_ge : ∑ v : V, 1 ≤ ∑ v : V, (f v : ℕ) :=\n104:     Finset.sum_le_sum (fun v _ => h_ge1 v)\n105:   rw [Finset.sum_const, nsmul_eq_mul, mul_one] at h_sum_ge\n106:   rw [Finset.card_univ] at h_sum_ge\n107:   have h2 : 2 ≤ ∑ v : V, (f v : ℕ) := hnt.trans h_sum_ge\n108:   omega\n109: \n110: lemma ballWithin_subset_succ {V : Type} [Fintype V] [DecidableEq V]\n111:     (G : SimpleGraph V) [DecidableRel G.Adj] (k : ℕ) (v : V) :\n112:     ballWithin G k v ⊆ ballWithin G (k + 1) v := by\n113:   intro x hx\n114:   dsimp [ballWithin]\n115:   exact Finset.mem_union_left _ hx\n116: \n117: lemma ballWithin_subset_add {V : Type} [Fintype V] [DecidableEq V]\n118:     (G : SimpleGraph V) [DecidableRel G.Adj] (k m : ℕ) (v : V) :\n119:     ballWithin G k v ⊆ ballWithin G (k + m) v := by\n120:   induction m with\n121:   | zero => exact Finset.Subset.refl _\n122:   | succ m ih =>\n123:     have h1 := ballWithin_subset_succ G (k + m) v\n124:     exact Finset.Subset.trans ih h1\n125: \n126: lemma ballWithin_succ_eq_self_implies_add {V : Type} [Fintype V] [DecidableEq V]\n127:     (G : SimpleGraph V) [DecidableRel G.Adj] 