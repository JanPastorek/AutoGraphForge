mma ballWithin_subset_succ {V : Type} [Fintype V] [DecidableEq V]\n37:     (G : SimpleGraph V) [DecidableRel G.Adj] (k : ℕ) (v : V) :\n38:     ballWithin G k v ⊆ ballWithin G (k + 1) v := by\n39:   intro x hx\n40:   dsimp [ballWithin]\n41:   exact Finset.mem_union_left _ hx\n42: \n43: lemma ballWithin_subset_add {V : Type} [Fintype V] [DecidableEq V]\n44:     (G : SimpleGraph V) [DecidableRel G.Adj] (k m : ℕ) (v : V) :\n45:     ballWithin G k v ⊆ ballWithin G (k + m) v := by\n46:   induction m with\n47:   | zero => exact Finset.Subset.refl _\n48:   | succ m ih =>\n49:     have h1 := ballWithin_subset_succ G (k + m) v\n50:     exact Finset.Subset.trans ih h1\n51: \n52: lemma ballWithin_succ_eq_self_implies_add {V : Type} [Fintype V] [DecidableEq V]\n53:     (G : SimpleGraph V) [DecidableRel G.Adj] (k : ℕ) (v : V)\n54:     (h : ballWithin G (k + 1) v = ballWithin G k v) (m : ℕ) :\n55:     ballWithin G (k + m) v = ballWithin G k v := by\n56:   induction m with\n57:   | zero => rfl\n58:   | succ m ih =>\n59:     have heq : k + (m + 1) = (k + m) + 1 := by omega\n60:     rw [heq]\n61:     dsimp [ballWithin]\n62:     rw [ih]\n63:     exact h\n64: \n65: lemma ballWithin_succ_eq_self_implies_univ {V : Type} [Fintype V] [DecidableEq V]\n66:     (G : SimpleGraph V) [DecidableRel G.Adj] (k : ℕ) (v : V)\n67:     (hrad : GraphCalc.HasRadius G)\n68:     (h : ballWithin G (k + 1) v = ballWithin G k v) :\n69:     ballWithin G k v = Finset.univ := by\n70:   have h_add := ballWithin_succ_eq_self_implies_add G k v h (Fintype.card V)\n71:   have h_sub : ballWithin G (Fintype.card V) v ⊆ ballWithin G (k + Fintype.card V) v := by\n72:     have heq : k + Fintype.card V = Fintype.card V + k := by omega\n73:     rw [heq]\n74:     exact ballWithin_subset_add G (Fintype.card V) k v\n75:   rw [hrad v] at h_sub\n76:   rw [h_add] at h_sub\n77:   ext x\n78:   exact ⟨fun _ => Finset.mem_univ x, fun _ => h_sub (Finset.mem_univ x)⟩\n79: \n80: lemma card_ballWithin_succ_of_ne_univ {V : Type} [Fintype V] [DecidableEq V]\n81:     (G : SimpleGraph V) [DecidableRel G.Adj] (k : ℕ) (v : V)\n82:     (hrad : GraphCalc.HasRadius G)\n83:     (hne : ballWithin G k v ≠ Finset.univ) :\n84:     (ballWithin G k v).card + 1 ≤ (ballWithin G (k + 1) v).card := by\n85:   have h_ne_self : ballWithin G (k + 1) v ≠ ballWithin G k v := by\n86:     intro h_eq\n87:     have h_univ := ballWithin_succ_eq_self_implies_univ G k v hrad h_eq\n88:     exact hne h_univ\n89:   have h_sub := ballWithin_subset_succ G k v\n90:   have h_ssub : ballWithin G k v ⊂ ballWithin G (k + 1) v :=\n91:     Finset.ssubset_iff_subset_ne.mpr ⟨h_sub, Ne.symm h_ne_self⟩\n92:   exact Finset.card_lt_card h_ssub\n93: \n94: lemma card_ballWithin_add {V : Type} [Fintype V] [DecidableEq V]\n95:     (G : SimpleGraph V) [DecidableRel G.Adj] (v : V)\n96:     (hrad : GraphCalc.HasRadius G) (k m : ℕ) :\n97:     ballWithin G (k + m) v = Finset.univ ∨ (ballWithin G k v).card + m ≤ (ballWithin G (k + m) v).card := by\n98:   induction m with\n99:   | zero => right; simp only [add_zero]; exact le_rfl\n100:   | succ m ih =>\n101:     cases ih with\n102:     | inl h_univ =>\n103:       left\n104:       have hsub := ballWithin_subset_succ G (k + m) v\n105:       rw [h_univ] at hsub\n106:       ext x\n107:       exact ⟨fun _ => Finset.mem_univ x, fun _ => hsub (Finset.mem_univ x)⟩\n108:     | inr h_card =>\n109:       by_cases hne : ballWithin G (k + m) v = Finset.univ\n110:       · left\n111:         have hsub := ballWithin_subset_succ G (k + m) v\n112:         rw [hne] at hsub\n113:         ext x\n114:         exact ⟨fun _ => Finset.mem_univ x, fun _ => hsub (Finset.mem_univ x)⟩\n115:       · right\n116:         have heq : k + (m + 1) = (k + m) + 1 := by omega\n117:         rw [heq]\n118:         have hstep := card_ballWithin_succ_of_ne_univ G (k + m) v hrad hne\n119:         omega\n120: \n121: lemma ballWithin_eq_univ_of_card_add {V : Type} [Fintype V] [DecidableEq V]\n122:     (G : SimpleGraph V) [DecidableRel G.Adj] (v : V)\n123:     (hrad : GraphCalc.HasRadius G) (k m : ℕ)\n124:     (h : Fintype.card V ≤ (ballWithin G k v).card + m) :\n125:     ballWithin G (k + m) v = Finset.univ := by\n126:   have h_cases := card_ballWithin_add G v hrad k m\n127:   cases h_cases with\n128:   | inl h_univ => exact h_univ\n129:   | inr h_card =>\n130:     by_contra hc\n131:     have h_ssub : ballWithin G (k + m) v ⊂ Finset.univ := Finset.ssubset_univ_iff.mpr hc\n132:     have h_lt := Finset.card_lt_card h_ssub\n133:     rw [Finset.card_univ] at h_lt\n134:     omega\n135: \n136: lemma ballWithin_univ_or_card_ge {V : Type} [Fintype V] [DecidableEq V]\n137:     (G : SimpleGraph V) [DecidableRel G.Adj] (v : V)\n138:     (hrad : GraphCalc.HasRadius G) (k : ℕ) :\n139:     ballWithin G k v = Finset.univ ∨ k + 1 ≤ (ballWithin G k v).card := by\n140:   have h_add := card_ballWithin_add G v hrad 0 k\n141:   have heq : 0 + k = k := by omega\n142:   rw [heq] at h_add\n143:   cases h_add with\n144:   | inl h_univ => left; exact h_univ\n145:   | inr h_card =>\n146:     right\n147:     have h0 : (ballWithin G 0 v).card = 1 := by\n148:       dsimp [ballWithin]\n149:       exact Finset.card_singleton v\n150:     omega\n151: \n152: lemma ballWithin_card_pred_eq_univ {V : Type} [Fintype V] [DecidableEq V]\n153:     (G : SimpleGraph V) [DecidableRel G.Adj] (v : V)\n154:     (hrad : GraphCalc.HasRadius G) (hnt : GraphCalc.IsNontrivialClass G) :\n155:     ballWithin G (Fintype.card V - 1) v = Finset.univ := by\n156:   unfold GraphCalc.IsNontrivialClass at hnt\n157:   unfold GraphCalc.order at hnt\n158:   have h_cases := ballWithin_univ_or_card_ge G v hrad (Fintype.card V - 1)\n159:   cases h_cases with\n160:   | inl h_univ => exact h_univ\n161:   | inr h_card =>\n162:     have h2 : (Fintype.card V - 1) + 1 ≤ (ballWithin G (Fintype.card V - 1) v).card := h_card\n163:     have h_card_eq : (Fintype.card V - 1) + 1 = Fintype.card V := by omega\n164:     rw [h_card_eq] at h2\n165:     by_contra hc\n166:     have h_ssub : ballWithin