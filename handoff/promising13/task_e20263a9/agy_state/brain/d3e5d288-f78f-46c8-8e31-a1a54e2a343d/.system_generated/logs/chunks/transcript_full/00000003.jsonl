 T = nx.random_tree(n)\n    rad = nx.radius(T)\n    val = rdn(T)\n    if rad + 1 > val:\n        print(f\"COUNTEREXAMPLE TREE: n={n}, rad={rad}, rdn={val}\")\n        exit(0)\n\n# Test random connected graphs\nfor i in range(1000):\n    n = random.randint(4, 18)\n    p = random.uniform(0.1, 0.5)\n    G = nx.erdos_renyi_graph(n, p)\n    if not nx.is_connected(G):\n        continue\n    rad = nx.radius(G)\n    val = rdn(G)\n    if rad + 1 > val:\n        print(f\"COUNTEREXAMPLE GRAPH: n={n}, rad={rad}, rdn={val}\")\n        exit(0)\n\nprint(\"1000 trees and 1000 graphs tested with zero counterexamples!\")\n'","Cwd":"/mnt/home/japake298/project/GraphConjecturing/handoff/promising13/task_e20263a9","WaitMsBeforeAsync":10000,"toolAction":"Testing random trees and graphs in python","toolSummary":"Test random trees and graphs"}}]}
