 : SimpleGraph α) (u : α) : ℕ∞ :=\n42:   ⨆ v, G.edist u v\n43: \n44: lemma eccent_def : G.eccent = fun u ↦ ⨆ v, G.edist u v := rfl\n45: \n46: lemma edist_le_eccent {u v : α} : G.edist u v ≤ G.eccent u :=\n47:   le_iSup (G.edist u) v\n48: \n49: lemma exists_edist_eq_eccent_of_finite [Finite α] (u : α) :\n50:     ∃ v, G.edist u v = G.eccent u :=\n51:   have : Nonempty α := Nonempty.intro u\n52:   exists_eq_ciSup_of_finite\n53: \n54: lemma eccent_eq_top_of_not_connected (h : ¬ G.Connected) (u : α) :\n55:     G.eccent u = ⊤ := by\n56:   rw [connected_iff_exists_forall_reachable] at h\n57:   push Not at h\n58:   obtain ⟨v, h⟩ := h u\n59:   rw [eq_top_iff, ← edist_eq_top_of_not_reachable h]\n60:   exact le_iSup (G.edist u) v\n61: \n62: lemma eccent_eq_zero_of_subsingleton [Subsingleton α] (u : α) : G.eccent u = 0 := by\n63:   simpa [eccent, edist_eq_zero_iff] using subsingleton_iff.mp ‹_› u\n64: \n65: lemma eccent_ne_zero [Nontrivial α] (u : α) : G.eccent u ≠ 0 := by\n66:   obtain ⟨v, huv⟩ := exists_ne ‹_›\n67:   contrapose huv\n68:   simp only [eccent, ENat.iSup_eq_zero, edist_eq_zero_iff] at huv\n69:   exact (huv v).symm\n70: \n71: lemma eccent_eq_zero_iff (u : α) : G.eccent u = 0 ↔ Subsingleton α := by\n72:   refine ⟨fun h ↦ ?_, fun _ ↦ eccent_eq_zero_of_subsingleton u⟩\n73:   contrapose! h\n74:   exact eccent_ne_zero u\n75: \n76: lemma eccent_pos_iff (u : α) : 0 < G.eccent u ↔ Nontrivial α := by\n77:   rw [pos_iff_ne_zero, ← not_subsingleton_iff_nontrivial, ← eccent_eq_zero_iff]\n78: \n79: @[simp]\n80: lemma eccent_bot [Nontrivial α] (u : α) : (⊥ : SimpleGraph α).eccent u = ⊤ :=\n81:   eccent_eq_top_of_not_connected not_connected_bot u\n82: \n83: @[simp]\n84: lemma eccent_top [Nontrivial α] (u : α) : (⊤ : SimpleGraph α).eccent u = 1 := by\n85:   apply le_an