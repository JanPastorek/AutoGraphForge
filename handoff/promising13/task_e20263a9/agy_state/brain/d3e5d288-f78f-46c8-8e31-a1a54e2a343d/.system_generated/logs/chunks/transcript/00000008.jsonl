hTop.coe_le_coe.mp hle\n37: \n38: lemma ballWithin_subset_succ {V : Type} [Fintype V] [DecidableEq V]\n39:     (G : SimpleGraph V) [DecidableRel G.Adj] (k : ℕ) (v : V) :\n40:    \n<truncated 5354 bytes>\n      omega\n164: \n165: lemma ballWithin_card_pred_eq_univ {V : Type} [Fintype V] [DecidableEq V]\n166:     (G : SimpleGraph V) [DecidableRel G.Adj] (v : V)\n167:     (hrad : GraphCalc.HasRadius G) (hnt : GraphCalc.IsNontrivialClass G) :\n168:     ballWithin G (Fintype.card V - 1) v = Finset.univ := by\n169:   have h := ballWithin_univ_or_card_ge G v hrad (Fintype.card V - 1)\n170:   cases h with\n171:   | inl h1 => exact h1\n172:   | inr h2 =>\n173:     unfold GraphCalc.IsNontrivialClass at hnt\n174:     unfold GraphCalc.order at hnt\n175:     have h_card_eq : (Fintype.card V - 1) + 1 = Fintype.card V := by omega\n176:     rw [h_card_eq] at h2\n177:     by_contra hc\n178:     have h_ssub : ballWithin G (Fintype.card V - 1) v ⊂ Finset.univ :=\n179:       Finset.ssubset_univ_iff.mpr hc\n180:     have h_lt := Finset.card_lt_card h_ssub\n181:     rw [Finset.card_univ] at h_lt\n182:     omega\n183: \n184: lemma eccentricity_le_card_pred {V : Type} [Fintype V] [DecidableEq V]\n185:     (G : SimpleGraph V) [DecidableRel G.Adj] (v : V)\n186:     (hrad : GraphCalc.HasRadius G) (hnt : GraphCalc.IsNontrivialClass G) :\n187:     GraphCalc.eccentricity G v ≤ Fintype.card V - 1 := by\n188:   unfold GraphCalc.eccentricity\n189:   unfold GraphCalc.IsNontrivialClass at hnt\n190:   unfold GraphCalc.order at hnt\n191:   apply minUpTo_le (Fintype.card V - 1) (by omega) (ballWithin_card_pred_eq_univ G v hrad hnt)\n192: \n193: lemma radius_add_one_le_card {V : Type} [Fintype V] [DecidableEq V]\n194:     (G : SimpleGraph V) [DecidableRel G.Adj]\n195:     (hrad : GraphCalc.HasRadius G) (hnt : GraphCalc.IsNontrivialClass G) :\n196:     GraphCalc.radius G + 1 ≤ Fintype.card V := by\n197:   unfold GraphCalc.IsNontrivialClass at hnt\n198:   unfold GraphCalc.order at hnt\n199:   obtain ⟨v⟩ :=