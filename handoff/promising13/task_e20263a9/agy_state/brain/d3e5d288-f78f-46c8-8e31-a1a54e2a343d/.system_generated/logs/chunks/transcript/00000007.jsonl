nected ∧ ∀ v : V, G.degree v % 2 = 0\n299: \n300: instance (G : SimpleGraph V) [Dec\n<truncated 11742 bytes>\nlity. -/\n503: def ballWithin (G : SimpleGraph V) [DecidableRel G.Adj] : ℕ → V → Finset V\n504:   | 0,       v => {v}\n505:   | (k + 1), v =>\n506:       let B := ballWithin G k v\n507:       B ∪ B.biUnion (fun u => univ.filter (fun w => G.Adj u w))\n508: \n509: /-- Eccentricity of `v`: least `k` with every vertex within `k` steps. -/\n510: def eccentricity (G : SimpleGraph V) [DecidableRel G.Adj] (v : V) : ℕ :=\n511:   minUpTo (Fintype.card V) (fun k => ballWithin G k v = univ)\n512: \n513: def radius (G : SimpleGraph V) [DecidableRel G.Adj] : ℕ :=\n514:   ((univ.image (eccentricity G)).min).getD 0\n515: \n516: /-- Undefined on a disconnected graph, where some vertex never reaches all of\n517: `univ` and `minUpTo` would fall back to `n`. networkx raises there. -/\n518: def HasRadius (G : SimpleGraph V) [DecidableRel G.Adj] : Prop :=\n519:   ∀ v : V, ballWithin G (Fintype.card V) v = univ\n520: \n521: instance (G : SimpleGraph V) [DecidableRel G.Adj] :\n522:     Decidable (HasRadius G) := by unfold HasRadius; infer_instance\n523: \n524: /- ── graph construction from an explicit edge list ────────────────────────── -/\n525: \n526: /-- The graph on `Fin n` with the given edge list, symmetrised and loop-free.\n527: This is the shape the disproof exporter emits for a refuting witness.\n528: \n529: `SimpleGraph.fromRel` supplies the symmetry and irreflexivity proofs, so this\n530: stays a definition rather than a bundle of obligations that would have to be\n531: re-discharged (and re-adjusted across mathlib versions) in generated code. It is\n532: an `abbrev` so that `DecidableRel` synthesis can see through it at the use site. -/\n533: abbrev ofEdges (n : ℕ) (es : List (Fin n × Fin n)) : SimpleGraph (Fin n) :=\n534:   SimpleGraph.fromRel (fun u v => (u, v) ∈ es)\n535: \n536: end GraphCalc\n537: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n","truncated_fields":["content"]}
