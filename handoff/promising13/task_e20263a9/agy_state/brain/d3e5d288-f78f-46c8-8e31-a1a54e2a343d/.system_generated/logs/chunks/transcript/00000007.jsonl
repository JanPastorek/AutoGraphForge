  n = len(nodes)\\n    c = []\\n    for v in nodes:\\n        c.extend([1, 2])\\n    A_ub = []\\n    b_ub = []\\n    for i in range(n):\\n        row = [0] * (2 * n)\\n        row[2*i] = 1\\n        row[2*i+1] = 1\\n        A_ub.append(row)\\n        b_ub.append(1)\\n    for i, v in enumerate(nodes):\\n        row = [0] * (2 * n)\\n        row[2*i] = -1\\n        row[2*i+1] = -1\\n        for u in G.neighbors(v):\\n            j = nodes.index(u)\\n            row[2*j+1] = -1\\n        A_ub.append(row)\\n        b_ub.append(-1)\\n    res = scipy.optimize.milp(c=np.array(c), integrality=np.ones(2*n),\\n                              bounds=scipy.optimize.Bounds(0, 1),\\n                              constraints=scipy.optimize.LinearConstraint(np.array(A_ub), -np.inf, np.array(b_ub)))\\n    return int(round(res.fun))\\n\\n# Check: Can we have rdn = 4 and rad >= 4?\\n# What if two stars whose centers are connected by a long path?\\n# Suppose a path of length L, with leaves attached?\\n# No, leaves attached to endpoints doesn't help if the path is long.\\n# If the path is long, say P_k, the path itself needs to be Roman dominated!\\n# For P_k: rdn(P_k) = ceil(2k/3).\\n# What if we have 2 vertices of label 2? They can only dominate their closed neighborhoods.\\n# Their closed neighborhoods have radius 1 around them.\\n# The distance between any vertex dominated by u1 and any vertex dominated by u2\\n# is at most d(u1, u2) + 2.\\nprint('Testing specific families...')\\nfor k in range(3, 15):\\n    # Broom graphs, spider graphs, combs\\n    # Comb graph:\\n    G = nx.grid_2d_graph(2, k)\\n    assert nx.radius(G) + 1 <= rdn(G)\\n    # Ladder graph\\n    G = nx.ladder_graph(k)\\n    assert nx.radius(G) + 1 <= rdn(G)\\n    # Circular ladder\\n    G = nx.circular_ladder_graph(k)\\n    assert nx.radius(G) + 1 <= rdn(G)\\n\\nprint('Specific families all passed!')\\n\\\"\"","Cwd":"\"/mnt/home/japake298/project/GraphConjecturing/handoff/promising13/task_e20263a9\"","RunPersistent":"