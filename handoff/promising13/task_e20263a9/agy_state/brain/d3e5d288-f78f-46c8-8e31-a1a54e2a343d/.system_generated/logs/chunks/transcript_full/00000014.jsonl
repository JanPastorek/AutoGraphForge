ependentDominatingSet (G : SimpleGraph V) [DecidableRel G.Adj]\n110:     (s : Finset V) : Prop :=\n111:   IsDominatingSet G s ∧ IsIndependentFinset G s\n112: \n113: instance (G : SimpleGraph V) [DecidableRel G.Adj] (s : Finset V) :\n114:     Decidable (IsIndependentDominatingSet G s) := by\n115:   unfold IsIndependentDominatingSet; infer_instance\n116: \n117: def independentDominationNumber (G : SimpleGraph V) [DecidableRel G.Adj] : ℕ :=\n118:   minCard (IsIndependentDominatingSet G)\n119: \n120: /- ── degree-sequence invariants ───────────────────────────────────────────── -/\n121: \n122: /-- Sum of the `k` smallest degrees.\n123: \n124: Stated as a minimum over `k`-element subsets rather than by sorting the degree\n125: sequence: the two agree (a `k`-subset of minimum degree-sum is exactly a choice\n126: of `k` smallest degrees), and this form stays decidable, whereas both\n127: `Multiset.sort` and `Finset.toList` are noncomputable and stall kernel\n128: reduction. -/\n129: def smallestDegreeSum (G : SimpleGraph V) [DecidableRel G.Adj] (k : ℕ) : ℕ :=\n130:   (((univ.powersetCard k).image (fun s => ∑ v ∈ s, G.degree v)).min).getD 0\n131: \n132: /-- Sum of the `k` largest degrees (dual of `smallestDegreeSum`). -/\n133: def largestDegreeSum (G : SimpleGraph V) [DecidableRel G.Adj] (k : ℕ) : ℕ :=\n134:   (((univ.powersetCard k).image (fun s => ∑ v ∈ s, G.degree v)).max).getD 0\n135: \n136: /-- Annihilation number: largest `k` whose `k` smallest degrees sum to `≤ m`. -/\n137: def annihilationNumber (G : SimpleGraph V) [DecidableRel G.Adj] : ℕ :=\n138:   maxUpTo (Fintype.card V) (fun k => smallestDegreeSum G k ≤ size G)\n139: \n140: /-- Slater number: least `t` with `t +` (sum of the `t` largest degrees) `≥ n`. -/\n141: def slaterNumber (G : SimpleGraph V) [DecidableRel G.Adj] : ℕ :=\n142:   minUpTo (Fintype.card V)\n143:     (fun t => Fintype.card V ≤ t + largestDegreeSum G t)\n144: \n145: /- ── bipartite ────────────────────────────────────────────────────────────── -