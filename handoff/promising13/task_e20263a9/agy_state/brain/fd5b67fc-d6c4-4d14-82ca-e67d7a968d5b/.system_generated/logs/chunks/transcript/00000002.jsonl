   for d in sorted(glob.glob(os.path.join(\n332:                 root, \".lake\", \"packages\", \"*\", \".lake\", \"build\", \"lib\", \"lean\"))):\n333:             if os.path.isdir(d):\n334:                 dirs.append(d)\n335:         # Only usable if\n<truncated 4349 bytes>\n4: \n415: class ClaudeProver(BaseProver):\n416:     \"\"\"\n417:     Prove Lean 4 ``sorry`` goals with an LLM (Anthropic Claude).\n418: \n419:     Claude is prompted with the theorem statement and asked to return a complete\n420:     Lean 4 proof. Crucially, the LLM's output is only a *candidate*: when a Lean\n421:     binary is available it is **kernel-verified** (compiled against mathlib) and\n422:     accepted only if it type-checks — so a `success` here is a real proof, not an\n423:     LLM assertion. Without a Lean binary the candidate is returned but\n424:     ``success=False`` (honestly unverified).\n425: \n426:     This is the default neural backend: it needs no GPU, only ``ANTHROPIC_API_KEY``.\n427:     For maximal automation on hard goals, swap in a local GPU prover (see\n428:     ``LocalEndpointProver`` and the registry below) — e.g. DeepSeek-Prover-V2\n429:     or Goedel-Prover-V2 served over HTTP.\n430:     \"\"\"\n431: \n432:     name = \"claude-prover\"\n433: \n434:     _SYSTEM = (\n435:         \"You are an expert Lean 4 / mathlib4 theorem prover. You are given a \"\n436:         \"theorem with `sorry`. Return ONLY the full theorem with `sorry` replaced \"\n437:         \"by a complete, compiling Lean 4 proof, inside a single ```lean code block. \"\n438:         \"Use mathlib lemmas and tactics (simp, omega, gcongr, nlinarith, exact?, \"\n439:         \"aesop). Do not invent definitions. If unprovable, return the statement \"\n440:         \"with `sorry` unchanged.\"\n441:     )\n442: \n443:     def __init__(self, cfg: Config = CONFIG):\n444:         self.cfg = cfg\n445:         self._client = None\n446:         if cfg.anthropic_api_key:\n447:             try:\n448:                 import anthropic\n449:                 self._client = anthropic.Anthropic(api_key=cfg.anthropic_api_key)\n450:             except Exception as e:                       # pragma: no cover\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n","truncated_fields":["content"]}
