ost\n278:     informative counterexamples.\n279:     \"\"\"\n280:     ranked = sorted(\n281:         (r for r in refutations if r.get(\"witness_graph6\")),\n282:         key=lambda r: (r.get(\"witness_order\") or 99, r.get(\"witness_size\") or 99))\n283:     out: List[Tuple[dict, str]] = []\n284:     for rec in ranked:\n285:         src = render(rec.get(\"statement\", \"\"), columns, rec.get(\"witness_graph6\"))\n286:         if src is not None:\n287:             out.append((rec, src))\n288:             if limit and len(out) >= limit:\n289:                 break\n290:     return out\n291: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
