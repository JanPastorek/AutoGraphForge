{"step_index":100,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-11T14:57:38Z","content":"Created At: 2026-09-11T16:57:38+02:00\nCompleted At: 2026-09-11T16:57:38+02:00\nFile Path: `file:///mnt/home/japake298/project/GraphConjecturing/pipeline/lean_disproof.py`\nTotal Lines: 291\nTotal Bytes: 13556\nShowing lines 100 to 250\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n100: # default depth fails on cograph (connected/tree/claw-free still pass), this\n101: # value succeeds.\n102: # `maxHeartbeats 0` removes the elaborator's *time* limit, not any soundness\n103: # check — the kernel still rechecks the finished term. Without it the default\n104: # budget expires after roughly 26 s, which silently capped the usable witness\n105: # size: an order-9 disproof that needs 387 s of honest evaluation was being\n106: # reported as a failure indistinguishable from a false statement.\n107: _PREAMBLE = (\"import Mathlib\\n\"\n108:              \"import LeanProject.GraphInvariantsComputable\\n\\n\"\n109:              \"set_option maxRecDepth 100000\\n\"\n110:              \"set_option maxHeartbeats 0\\n\\n\"\n111:              \"open SimpleGraph\\n\")\n112: \n113: \n114: # Invariants whose `minCard` has no witness on some graphs — `connectedZeroForcingNumber`\n115: # on any disconnected graph, `totalZeroForcingNumber` whenever a vertex has no\n116: # neighbour in any forcing set. There `minCard` falls back to 0 while graphcalc\n117: # reports nothing, so a conjecture like `Z_c + 2 <= 2 * Z_t` degenerates to\n118: # `2 <= 0` and is refutable with no mathematics. The generator never claimed\n119: # anything about those graphs, so the export carries the definedness hypothesis.\n120: PARTIAL_INVARIANTS = {\n121:     \"connected_zero_forcing_number\": \"HasConnectedZeroForcingNumber\",\n122:     \"total_zero_forcing_number\":     \"HasTotalZeroForcingNumber\",\n123:     # graphcalc raises rather than returning a number on these; `minCard` /\n124:     # `minUpTo` would silently read 0 (resp. n), so the statement must be\n125:     # scoped to the graphs the conjecture actually spoke about.\n126:     \"total_domination_number\":       \"HasTotalDominationNumber\",\n127:     \"edge_cover_number\":             \"HasEdgeCover\",\n128:     \"sub_total_domination_number\":   \"HasSubTotalDominationNumber\",\n129:     \"radius\":                        \"HasRadius\",\n130: }\n131: \n132: \n133: def definedness_hyps(names, qualify):\n134:     \"\"\"Definedness predicates required by the invariants in `names`.\"\"\"\n135:     return [qualify(PARTIAL_INVARIANTS[n]) for n in sorted(names)\n136:             if n in PARTIAL_INVARIANTS]\n137: \n138: \n139: def _edge_list(graph6: str) -> Optional[Tuple[int, List[Tuple[int, int]]]]:\n140:     \"\"\"(order, edges) for a graph6 string, else None.\"\"\"\n141:     try:\n142:         import networkx as nx\n143:         G = nx.from_graph6_bytes(graph6.encode(\"ascii\"))\n144:         G = nx.convert_node_labels_to_integers(G)\n145:         return G.number_of_nodes(), sorted(tuple(sorted(e)) for e in G.edges())\n146:     except Exception:\n147:         return None\n148: \n149: \n150: \n151: \n152: def _parse(statement: str, columns) -> Optional[Tuple[List[str], str]]:\n153:     \"\"\"(classes, lean_body) for a class-conditioned inequality.\n154: \n155:     The body is any rational linear comparison, not just ``invariant REL\n156:     invariant``. Restricting it to bare invariants rejected most of what the\n157:     generator actually produces — constant bounds like ``zero_forcing_number ≤\n158:     8`` and scaled forms like ``maximum_degree ≤ 2 · independence_number`` — so\n159:     conjectures went unrefuted for want of a parser rather than for want of a\n160:     counterexample.\n161: \n162:     ``linear_form`` does the rewriting, the same module the necessary-condition\n163:     branch uses. It scales by the lcm of the denominators and moves negative\n164:     terms across, so every coefficient ends up non-negative and the ℕ statement\n165:     is equivalent rather than merely truncated.\n166:     \"\"\"\n167:     if \"⇒\" not in statement:\n168:         return None\n169:     cond, body = statement.split(\"⇒\", 1)\n170:     classes = [c for c in columns if re.search(r\"\\b\" + re.escape(c) + r\"\\b\", cond)]\n171:     if not classes or any(c not in CLASS_PREDICATES for c in classes):\n172:         return None\n173:     # A body that is itself all classes is the necessary-condition shape.\n174:     names = set(linear_form.invariants(body))\n175:     if not names or names <= set(CLASS_PREDICATES):\n176:         return None\n177:     if any(n not in SUPPORTED for n in names):\n178:         return None\n179:     rendered = linear_form.render_comparison(body, SUPPORTED)\n180:     if rendered is None:\n181:         return None\n182:     return classes, rendered, definedness_hyps(names, lambda h: f\"GraphCalc.{h} G\")\n183: \n184: \n185: def _parse_necessary(statement: str) -> Optional[Tuple[str, str]]:\n186:     \"\"\"(lean_hypothesis, lean_conclusion) for an ``(inequality) ⇒ classes``\n187:     survivor, else None.\n188: \n189:     The hypothesis is normalised to ℕ by ``linear_form`` — the same rewriting the\n190:     positive exporter applies, so the theorem and its disproof are statements\n191:     about the same proposition.\n192:     \"\"\"\n193:     if \"⇒\" not in statement:\n194:         return None\n195:     cond, concl = statement.split(\"⇒\", 1)\n196:     clauses = linear_form.parse_class_conclusion(concl)\n197:     if not clauses or any(c not in CLASS_PREDICATES for _, c in clauses):\n198:         return None\n199:     names = set(linear_form.invariants(cond))\n200:     if not names or names <= set(CLASS_PREDICATES):\n201:         return None                        # class-conditioned shape, not this one\n202:     if any(n not in SUPPORTED for n in names):\n203:         return None\n204:     hyp = linear_form.render_comparison(cond, SUPPORTED)\n205:     if hyp is None:\n206:         return None\n207:     goal = \" ∧ \".join(\n208:         f\"¬ {CLASS_PREDICATES[c]} G\" if neg else f\"{CLASS_PREDICATES[c]} G\"\n209:         for neg, c in clauses)\n210:     # Mirror the theorem: the conjecture is about non-trivial graphs, so a\n211:     # disproof must exhibit one. Omitting this made every statement of this\n212:     # shape refutable by Fin 0, where the class predicates hold vacuously.\n213:     guards = [f\"{CLASS_PREDICATES['nontrivial']} G\"] + \\\n214:         definedness_hyps(names, lambda h: f\"GraphCalc.{h} G\")\n215:     return \" → \".join(guards + [hyp]), goal\n216: \n217: \n218: def is_supported(statement: str, columns, witness_graph6: Optional[str]) -> bool:\n219:     \"\"\"True iff ``render`` would produce a disproof for this refutation.\"\"\"\n220:     return render(statement, columns, witness_graph6) is not None\n221: \n222: \n223: def render(statement: str, columns, witness_graph6: Optional[str],\n224:            name: Optional[str] = None) -> Optional[str]:\n225:     \"\"\"A self-contained Lean 4 disproof file, or None if out of scope.\"\"\"\n226:     if not witness_graph6:\n227:         return None\n228:     parsed = _parse(statement, columns)\n229:     necessary = _parse_necessary(statement) if parsed is None else None\n230:     if parsed is None and necessary is None:\n231:         return None\n232:     built = _edge_list(witness_graph6)\n233:     if built is None:\n234:         return None\n235:     n, edges = built\n236:     if n < 1 or n > MAX_WITNESS_ORDER:\n237:         return None\n238: \n239:     if name is None:\n240:         name = \"CEGIS_disproof_\" + hashlib.sha1(statement.encode()).hexdigest()[:8]\n241: \n242:     es = \", \".join(f\"({a}, {b})\" for a, b in edges)\n243:     if parsed is not None:\n244:         classes, body, defined = parsed\n245:         parts = [f\"{CLASS_PREDICATES[c]} G\" for c in classes] + defined\n246:         hyp_types = \" → \".join(parts)\n247:         # One `(by decide)` per hypothesis, discharged on the witness.\n248:         hyp_args = \" \".join(\"(by decide)\" for _ in parts)\n249:     else:\n250:         # (inequality) ⇒ classes. The hypothesis is about the graph rather than\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
