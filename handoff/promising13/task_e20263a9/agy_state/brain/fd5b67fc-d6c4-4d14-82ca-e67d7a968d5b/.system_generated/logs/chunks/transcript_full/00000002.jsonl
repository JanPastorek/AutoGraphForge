the Lean 4 statement compiles and for trivial conjectures.\n267:     \"\"\"\n268: \n269:     name = \"lean-subprocess\"\n270: \n271:     _SIMPLE_TACTICS = [\"decide\", \"simp\", \"norm_num\", \"omega\", \"ring\", \"tauto\"]\n272: \n273:     def __init__(self, cfg: Config = CONFIG):\n274:         self.cfg = cfg\n275:         self._available = bool(shutil.which(cfg.lean_binary))\n276: \n277:     def prove(self, conjecture: Conjecture) -> ProverResponse:\n278:         if not self._available:\n279:             return ProverResponse(\n280:                 success=False,\n281:                 error=f\"Lean binary not found: {self.cfg.lean_binary}\",\n282:                 model_name=self.name,\n283:             )\n284:         if conjecture.lean_statement is None:\n285:             return ProverResponse(success=False, error=\"No statement\", model_name=self.name)\n286: \n287:         t0 = time.time()\n288:         for tactic in self._SIMPLE_TACTICS:\n289:             proof = self._try_tactic(conjecture.lean_statement, tactic)\n290:             if proof:\n291:                 elapsed = time.time() - t0\n292:                 logger.info(\n293:                     \"[LeanSubprocess] Proved %s with tactic `%s`\", conjecture.id, tactic\n294:                 )\n295:                 return ProverResponse(\n296:                     success=True,\n297:                     proof_tactics=proof,\n298:                     model_name=self.name,\n299:                     elapsed_s=elapsed,\n300:                 )\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
