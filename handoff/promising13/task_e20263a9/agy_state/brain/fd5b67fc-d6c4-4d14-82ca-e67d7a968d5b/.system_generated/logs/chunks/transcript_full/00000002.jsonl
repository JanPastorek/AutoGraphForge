Lean's output that signal an incomplete / uncertified proof. A zero\n41: # exit code alone is NOT sufficient: inside a lake project `apply?`/`exact?` leave\n42: # \"Try this\" suggestions with unsolved subgoals yet `lean` may still exit 0, and\n43: # `sorry`/`admit` only warn. (This is the false-positive that once mis-certified a\n44: # false `domination = slater` theorem.)\n45: _BAD_PROOF_MARKERS = (\"sorry\", \"Try this\", \"unsolved goals\", \"found a partial proof\",\n46:                       \"error:\", \"declaration uses\")\n47: \n48: \n49: def _proof_certified(returncode: int, lean_output: str) -> bool:\n50:     \"\"\"True only for a genuinely kernel-checked proof: clean (zero) exit AND no\n51:     marker of an incomplete/uncertified proof in Lean's output.\"\"\"\n52:     return returncode == 0 and not any(m in lean_output for m in _BAD_PROOF_MARKERS)\n53: \n54: \n55: # ---------------------------------------------------------------------------\n56: # Prover response schema\n57: # ---------------------------------------------------------------------------\n58: \n59: @dataclass\n60: class ProverResponse:\n61:     \"\"\"\n62:     Expected response from a neural theorem prover API.\n63: \n64:     Fields match what Goedel-Prover-SB / DeepSeek-Prover-V2 would return\n65:     (schema inferred from published papers; adapt when APIs go public).\n66:     \"\"\"\n67: \n68:     success: bool = False\n69:     proof_text: Optional[str] = None       # complete Lean 4 proof term\n70:     proof_tactics: Optional[str] = None    # tactic proof (if available)\n71:     model_name: str = \"\"\n72:     tokens_used: int = 0\n73:     elapsed_s: float = 0.0\n74:     error: Optional[str] = None\n75: \n76:     # Internal routing\n77:     _stub: bool = False\n78: \n79:     def to_dict(self) -> dict:\n80:         return {\n81:             \"success\": self.success,\n82:             \"proof_text\": self.proof_text,\n83:             \"proof_tactics\": self.proof_tactics,\n84:             \"model_name\": self.model_name,\n85:             \"tokens_used\": self.tokens_used,\n86:             \"elapsed_s\": self.elapsed_s,\n87:             \"error\": self.error,\n88:             \"stub\": self._stub,\n89:         }\n90: \n91: \n92: # ---------------------------------------------------------------------------\n93: # Base class\n94: # ---------------------------------------------------------------------------\n95: \n96: class BaseProver:\n97:     \"\"\"Abstract interface; concrete provers inherit and override `prove_one`.\"\"\"\n98: \n99:     name: str = \"base\"\n100: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
