{"step_index":1408,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-11T23:50:40Z","content":"Created At: 2026-09-12T01:50:40+02:00\nCompleted At: 2026-09-12T01:50:40+02:00\nFile Path: `file:///mnt/home/japake298/project/GraphConjecturing/tools/validate_known_relations.py`\nTotal Lines: 93\nTotal Bytes: 3437\nShowing lines 1 to 93\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: #!/usr/bin/env python\n2: \"\"\"Empirically validate the curated known relations against the battery.\n3: \n4: Every relation in ``pipeline.known_relations`` claims a universal (or\n5: class-restricted) bound between graph invariants. This script checks each one\n6: against the precomputed invariant battery (connected, non-trivial graphs) and\n7: reports any relation with a counterexample, so the novelty table never trusts an\n8: unverified bound. Relations whose invariants are not in the battery are reported\n9: as untestable (kept on the curator's authority).\n10: \n11: Usage:  python tools/validate_known_relations.py\n12: \"\"\"\n13: from __future__ import annotations\n14: \n15: import glob\n16: import os\n17: import sys\n18: \n19: import pandas as pd\n20: \n21: sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))\n22: \n23: from pipeline import known_relations as kr  # noqa: E402\n24: \n25: # novelty symbol -> battery column (classical short names differ from columns)\n26: SYM2COL = {\n27:     \"n\": \"order\", \"m\": \"size\", \"Delta\": \"maximum_degree\", \"delta\": \"minimum_degree\",\n28:     \"avg_deg\": \"average_degree\", \"omega\": \"clique_number\",\n29:     \"alpha\": \"independence_number\", \"chi\": \"chromatic_number\",\n30:     \"gamma\": \"domination_number\", \"ind_dom\": \"independent_domination_number\",\n31:     \"vertex_cover\": \"vertex_cover_number\", \"nu\": \"matching_number\",\n32:     \"diam\": \"diameter\", \"rad\": \"radius\", \"min_edge_cover\": \"edge_cover_number\",\n33: }\n34: \n35: TOL = 1e-6\n36: \n37: \n38: def _load_battery() -> pd.DataFrame:\n39:     paths = sorted(set(glob.glob(\"database/cache/battery_*.parquet\")))\n40:     if not paths:\n41:         raise SystemExit(\"no battery parquet found under database/cache/\")\n42:     df = pd.concat([pd.read_parquet(p) for p in paths], ignore_index=True, sort=False)\n43:     if \"connected\" in df:\n44:         df = df[df[\"connected\"] == True]  # noqa: E712\n45:     if \"nontrivial\" in df:\n46:         df = df[df[\"nontrivial\"] == True]  # noqa: E712\n47:     # derive the order-threshold predicates (older parquets predate them)\n48:     if \"order\" in df.columns:\n49:         o = pd.to_numeric(df[\"order\"], errors=\"coerce\")\n50:         df[\"order_bigger_than_2\"] = (o > 2).fillna(False)\n51:         df[\"order_bigger_than_3\"] = (o > 3).fillna(False)\n52:     return df\n53: \n54: \n55: def main() -> int:\n56:     df = _load_battery()\n57:     print(f\"battery (connected, non-trivial): {len(df)} graphs\")\n58: \n59:     def col(sym):\n60:         c = SYM2COL.get(sym, sym)\n61:         return c if c in df.columns else None\n62: \n63:     ok = untestable = 0\n64:     false_rels = []\n65:     for lhs, rhs, off, cls, name in kr.load_relations():\n66:         needed = [lhs] + list(rhs)\n67:         if any(col(x) is None for x in needed):\n68:             untestable += 1\n69:             continue\n70:         sub = df if cls is None else (df[df[cls] == True] if cls in df.columns else None)  # noqa: E712\n71:         if sub is None or len(sub) == 0:\n72:             untestable += 1\n73:             continue\n74:         viol = sub[col(lhs)].astype(float) - off\n75:         for k, c in rhs.items():\n76:             viol = viol - c * sub[col(k)].astype(float)\n77:         nbad = int((viol > TOL).sum())\n78:         if nbad:\n79:             false_rels.append((name, nbad, len(sub), float(viol.max())))\n80:         else:\n81:             ok += 1\n82: \n83:     print(f\"verified (no counterexample): {ok}\")\n84:     print(f\"untestable (missing column) : {untestable}\")\n85:     print(f\"FALSE (counterexamples)     : {len(false_rels)}\")\n86:     for name, nbad, ntot, worst in sorted(false_rels, key=lambda x: -x[1]):\n87:         print(f\"  [{nbad}/{ntot}, worst +{worst:g}]  {name}\")\n88:     return 1 if false_rels else 0\n89: \n90: \n91: if __name__ == \"__main__\":\n92:     raise SystemExit(main())\n93: \nThe above content shows the entire, complete file contents of the requested file.\n"}
