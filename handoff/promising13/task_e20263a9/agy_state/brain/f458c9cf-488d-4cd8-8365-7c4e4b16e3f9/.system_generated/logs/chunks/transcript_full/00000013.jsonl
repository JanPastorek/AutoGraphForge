le_romanDominationNumber {V : Type} [Fintype V] [DecidableEq V]\n37:     (G : SimpleGraph V) [DecidableRel G.Adj] (k : ℕ)\n38:     (h : ∀ f : V → Fin 3, GraphCalc.IsRomanDominatingFunction G f → k ≤ GraphCalc.romanWeight f) :\n39:     k ≤ GraphCalc.romanDominationNumber G := by\n40:   unfold GraphCalc.romanDominationNumber\n41:   have h_ex : ∃ f : V → Fin 3, GraphCalc.IsRomanDominatingFunction G f := by\n42:     use (fun _ => 2)\n43:     intro v hv\n44:     dsimp at hv\n45:     have h_false : False := by\n46:       revert hv\n47:       decide\n48:     contradiction\n49:   rcases h_ex with ⟨f₀, hf₀⟩\n50:   have h_mem : GraphCalc.romanWeight f₀ ∈ (Finset.univ.filter (GraphCalc.IsRomanDominatingFunction G)).image GraphCalc.romanWeight := by\n51:     rw [Finset.mem_image]\n52:     exact ⟨f₀, Finset.mem_filter.mpr ⟨Finset.mem_univ f₀, hf₀⟩, rfl⟩\n53:   have h_nonempty : ((Finset.univ.filter (GraphCalc.IsRomanDominatingFunction G)).image GraphCalc.romanWeight).Nonempty :=\n54:     ⟨GraphCalc.romanWeight f₀, h_mem⟩\n55:   obtain ⟨m, hm⟩ := Finset.min_of_nonempty h_nonempty\n56:   rw [hm]\n57:   dsimp\n58:   have hm_in := Finset.mem_of_min hm\n59:   rw [Finset.mem_image] at hm_in\n60:   rcases hm_in with ⟨f_min, hf_min, rfl⟩\n61:   rw [Finset.mem_filter] at hf_min\n62:   exact h f_min hf_min.2\n63: \n64: lemma two_le_romanWeight {V : Type} [Fintype V] [DecidableEq V]\n65:     (G : SimpleGraph V) [DecidableRel G.Adj]\n66:     (hnt : GraphCalc.IsNontrivialClass G) (f : V → Fin 3)\n67:     (hf : GraphCalc.IsRomanDominatingFunction G f) :\n68:     2 ≤ GraphCalc.romanWeight f := by\n69:   unfold GraphCalc.romanWeight\n70:   unfold GraphCalc.IsNontrivialClass at hnt\n71:   unfold GraphCalc.order at hnt\n72:   by_contra hc\n73:   have h_le1 : ∑ v : V, (f v : ℕ) ≤ 1 := by omega\n74:   have h_no2 : ∀ v : V, (f v : ℕ) ≠ 2 := by\n75:     intro v hv\n76:     have h_mem := Finset.single_le_sum (fun u _ => Nat.zero_le (f u : ℕ)) (Finset.mem_univ v)\n77:     rw [hv] at h_mem\n78:     omeg