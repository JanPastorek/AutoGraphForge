: lemma ballWithin_subset_succ {V : Type} [Fintype V] [DecidableEq V]\n37:     (G : SimpleGraph V) [DecidableRel G.Adj] (k : ℕ) (v : V) :\n38:     ballWithin G k v ⊆ ballWithin G (k + 1) v := by\n39:   intro x hx\n40:   dsimp [ballWithin]\n41:   exact Finset.mem_union_left _ hx\n42: \n43: lemma ballWithin_subset_add {V : Type} [Fintype V] [DecidableEq V]\n44:     (G : SimpleGraph V) [DecidableRel G.Adj] (k m : ℕ) (v : V) :\n45:     ballWithin G k v ⊆ ballWithin G (k + m) v := by\n46:   induction m with\n47:   | zero => exact Finset.Subset.refl _\n48:   | succ m ih =>\n49:     have h1 := ballWithin_subset_succ G (k + m) v\n50:     exact Finset.Subset.trans ih h1\n51: \n52: lemma ballWithin_succ_eq_self_implies_add {V : Type} [Fintype V] [DecidableEq V]\n53:     (G : SimpleGraph V) [DecidableRel G.Adj] (k : ℕ) (v : V)\n54:     (h : ballWithin G (k + 1) v = ballWithin G k v) (m : ℕ) :\n55:     ballWithin G (k + m) v = ballWithin G k v := by\n56:   induction m with\n57:   | zero => rfl\n58:   | succ m ih =>\n59:     have heq : k + (m + 1) = (k + m) + 1 := by omega\n60:     rw [heq]\n61:     dsimp [ballWithin]\n62:     rw [ih]\n63:     exact h\n64: \n65: lemma ballWithin_succ_eq_self_implies_univ {V : Type} [Fintype V] [DecidableEq V]\n66:     (G : SimpleGraph V) [DecidableRel G.Adj] (k : ℕ) (v : V)\n67:     (hrad : GraphCalc.HasRadius G)\n68:     (h : ballWithin G (k + 1) v = ballWithin G k v) :\n69:     ballWithin G k v = Finset.univ := by\n70:   have h_add := ballWithin_succ_eq_self_implies_add G k v h (Fintype.card V)\n71:   have h_sub : ballWithin G (Fintype.card V) v ⊆ ballWithin G (k + Fintype.card V) v := by\n72:     have heq : k + Fintype.card V = Fintype.card V + k := by omega\n73:     rw [heq]\n74:     exact ballWithin_subset_add G (Fintype.card V) k v\n75:   rw [hrad v] at h_sub\n76:   rw [h_add] at h_sub\n77:   ext x\n78:   exact ⟨fun _ => Finset.mem_univ x, fun _ => h_sub (Finset.mem_univ x)⟩\n79: \n80: lemma card_ballWithin_succ_of_ne_univ {V : Type} [Fint