{"step_index":1299,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-11T23:42:56Z","content":"Created At: 2026-09-12T01:42:56+02:00\nCompleted At: 2026-09-12T01:42:56+02:00\nFile Path: `file:///mnt/home/japake298/project/GraphConjecturing/handoff/promising13/task_e20263a9/reference/GraphInvariantsComputable.lean`\nTotal Lines: 537\nTotal Bytes: 27292\nShowing lines 450 to 537\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n450: \n451: graphcalc solves this as a MIP over binaries `x, y` with `f = x + 2y`,\n452: constraint `x v + y v + Σ_{u ∈ N(v)} y u ≥ 1` and exclusion `x v + y v ≤ 1`;\n453: that is exactly the condition below. -/\n454: def IsRomanDominatingFunction (G : SimpleGraph V) [DecidableRel G.Adj]\n455:     (f : V → Fin 3) : Prop := ∀ v : V, f v = 0 → ∃ u : V, G.Adj v u ∧ f u = 2\n456: \n457: instance (G : SimpleGraph V) [DecidableRel G.Adj] (f : V → Fin 3) :\n458:     Decidable (IsRomanDominatingFunction G f) := by\n459:   unfold IsRomanDominatingFunction; infer_instance\n460: \n461: def romanWeight (f : V → Fin 3) : ℕ := ∑ v : V, (f v : ℕ)\n462: \n463: /-- Total, not partial: the constant function `2` is always Roman dominating\n464: (no vertex is labelled `0`), so a witness always exists. -/\n465: def romanDominationNumber (G : SimpleGraph V) [DecidableRel G.Adj] : ℕ :=\n466:   (((univ.filter (IsRomanDominatingFunction G)).image romanWeight).min).getD 0\n467: \n468: /- ── double Roman domination ──────────────────────────────────────────────── -/\n469: \n470: /-- `f : V → {0,1,2,3}` is double Roman dominating when a vertex labelled `0`\n471: has either a neighbour labelled `3` or two neighbours labelled `2`, and a vertex\n472: labelled `1` has a neighbour labelled `≥ 2`.\n473: \n474: The first clause is written as graphcalc's linearisation\n475: `0.5·|N₂(v)| + |N₃(v)| ≥ 1`, but as two existentials rather than as\n476: `Finset.card` of a filter: \"at least two neighbours labelled 2\" is \"two distinct\n477: neighbours labelled 2\", and the kernel reduces a pair of quantifiers over `V`\n478: far more cheaply than it builds and counts a `Finset`. Written the counting way\n479: first, all seven order-5 checks exhausted their heartbeat budget. -/\n480: def IsDoubleRomanDominatingFunction (G : SimpleGraph V) [DecidableRel G.Adj]\n481:     (f : V → Fin 4) : Prop :=\n482:   (∀ v : V, f v = 0 →\n483:       (∃ u : V, G.Adj v u ∧ f u = 3) ∨\n484:       (∃ u : V, ∃ w : V, u ≠ w ∧ G.Adj v u ∧ G.Adj v w ∧ f u = 2 ∧ f w = 2)) ∧\n485:   (∀ v : V, f v = 1 → ∃ u : V, G.Adj v u ∧ 2 ≤ (f u : ℕ))\n486: \n487: instance (G : SimpleGraph V) [DecidableRel G.Adj] (f : V → Fin 4) :\n488:     Decidable (IsDoubleRomanDominatingFunction G f) := by\n489:   unfold IsDoubleRomanDominatingFunction; infer_instance\n490: \n491: def doubleRomanWeight (f : V → Fin 4) : ℕ := ∑ v : V, (f v : ℕ)\n492: \n493: /-- Total, for the same reason as `romanDominationNumber`: constant `3` works. -/\n494: def doubleRomanDominationNumber (G : SimpleGraph V) [DecidableRel G.Adj] : ℕ :=\n495:   (((univ.filter (IsDoubleRomanDominatingFunction G)).image\n496:     doubleRomanWeight).min).getD 0\n497: \n498: /- ── radius ───────────────────────────────────────────────────────────────── -/\n499: \n500: /-- Vertices within `k` steps of `v`, by iterated neighbourhood expansion.\n501: Distance is not available to the kernel directly (`SimpleGraph.dist` is defined\n502: through `sInf` over walk lengths), so it is reconstructed as reachability. -/\n503: def ballWithin (G : SimpleGraph V) [DecidableRel G.Adj] : ℕ → V → Finset V\n504:   | 0,       v => {v}\n505:   | (k + 1), v =>\n506:       let B := ballWithin G k v\n507:       B ∪ B.biUnion (fun u => univ.filter (fun w => G.Adj u w))\n508: \n509: /-- Eccentricity of `v`: least `k` with every vertex within `k` steps. -/\n510: def eccentricity (G : SimpleGraph V) [DecidableRel G.Adj] (v : V) : ℕ :=\n511:   minUpTo (Fintype.card V) (fun k => ballWithin G k v = univ)\n512: \n513: def radius (G : SimpleGraph V) [DecidableRel G.Adj] : ℕ :=\n514:   ((univ.image (eccentricity G)).min).getD 0\n515: \n516: /-- Undefined on a disconnected graph, where some vertex never reaches all of\n517: `univ` and `minUpTo` would fall back to `n`. networkx raises there. -/\n518: def HasRadius (G : SimpleGraph V) [DecidableRel G.Adj] : Prop :=\n519:   ∀ v : V, ballWithin G (Fintype.card V) v = univ\n520: \n521: instance (G : SimpleGraph V) [DecidableRel G.Adj] :\n522:     Decidable (HasRadius G) := by unfold HasRadius; infer_instance\n523: \n524: /- ── graph construction from an explicit edge list ────────────────────────── -/\n525: \n526: /-- The graph on `Fin n` with the given edge list, symmetrised and loop-free.\n527: This is the shape the disproof exporter emits for a refuting witness.\n528: \n529: `SimpleGraph.fromRel` supplies the symmetry and irreflexivity proofs, so this\n530: stays a definition rather than a bundle of obligations that would have to be\n531: re-discharged (and re-adjusted across mathlib versions) in generated code. It is\n532: an `abbrev` so that `DecidableRel` synthesis can see through it at the use site. -/\n533: abbrev ofEdges (n : ℕ) (es : List (Fin n × Fin n)) : SimpleGraph (Fin n) :=\n534:   SimpleGraph.fromRel (fun u v => (u, v) ∈ es)\n535: \n536: end GraphCalc\n537: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
