 in range(n))\n        if rad + 1 > W:\n            print(f'VIOLATION OF CONJECTURE! n={n}, rad={rad}, W={W}, f={f}')\n            return False\n        # check if exists u with f[u]==2 having ecc(u) <= W - 1\n        centers_2 = [v for v in range(n) if f[v] == 2]\n        if centers_2:\n            min_ecc_2 = min(bfs_ecc(adj, n, v) for v in centers_2)\n            # is min_ecc_2 <= W - 1?\n            # print if not\n            pass\n    return True\n\n# Test P_4, P_5, P_6, P_7, P_8\nfor n in range(2, 9):\n    adj = {i: [] for i in range(n)}\n    for i in range(n - 1):\n        adj[i].append(i + 1)\n        adj[i + 1].append(i)\n    assert test_all_f(adj, n)\nprint('All Roman dominating functions on paths up to P_8 satisfy rad + 1 <= W!')\n\"","Cwd":"/mnt/home/japake298/project/GraphConjecturing/handoff/promising13/task_e20263a9","WaitMsBeforeAsync":10000,"toolAction":"Check all Roman dominating functions on paths","toolSummary":"Check all f on paths"}}]}
