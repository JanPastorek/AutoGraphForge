; deg[y] -= 1; break\n    u, v = [i for i in range(n) if deg[i] == 1]\n    adj[u].append(v); adj[v].append(u)\n    rad = min(bfs_ecc(adj, n, i) for i in range(n))\n    # We want to know if there is ANY Roman dominating function f with weight W <= rad!\n    # If there is, that means rad >= W!\n    # Does any f have W <= rad?\n    # Test greedy / random or optimal f:\n    # If the MINIMUM Roman domination number rdn <= rad, then YES!\n    # Otherwise NO!\n\"","Cwd":"/mnt/home/japake298/project/GraphConjecturing/handoff/promising13/task_e20263a9","WaitMsBeforeAsync":5000,"toolAction":"Test if radius >= W is ever possible","toolSummary":"Test radius >= W"}}]}
