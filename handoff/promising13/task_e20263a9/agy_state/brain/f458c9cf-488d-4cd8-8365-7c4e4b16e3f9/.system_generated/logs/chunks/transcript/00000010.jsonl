ance (G : SimpleGraph V) [DecidableRel G.Adj] (s : Finset V) :\n90:     Decidable (IsCliqueFinset G s) := by\n91:   unfold IsCliqueFinset; infer_instance\n92: \n93: /-- Clique number: the largest clique. -/\n94: def cliqueNum (G : SimpleGraph V) [DecidableRel G.Adj] : ℕ :=\n95:   (((univ.powerset.filter (IsCliqueFinset G)).image Finset.card).max).getD 0\n96: \n97: /- ── domination family ────────────────────────────────────────────────────── -/\n98: \n99: def IsDominatingSet (G : SimpleGraph V) [DecidableRel G.Adj] (s : Finset V) : Prop :=\n100:   ∀ v : V, v ∈ s ∨ ∃ w ∈ s, G.Adj v w\n101: \n102: instance (G : SimpleGraph V) [DecidableRel G.Adj] (s : Finset V) :\n103:     Decidable (IsDominatingSet G s) := by\n104:   unfold IsDominatingSet; infer_instance\n105: \n106: def dominationNumber (G : SimpleGraph V) [DecidableRel G.Adj] : ℕ :=\n107:   minCard (IsDominatingSet G)\n108: \n109: def IsIndependentDominatingSet (G : SimpleGraph V) [DecidableRel G.Adj]\n110:     (s : Finset V) : Prop :=\n111:   IsDominatingSet G s ∧ IsIndependentFinset G s\n112: \n113: instance (G : SimpleGraph V) [DecidableRel G.Adj] (s : Finset V) :\n114:     Decidable (IsIndependentDominatingSet G s) := by\n115:   unfold IsIndependentDominatingSet; infer_instance\n116: \n117: def independentDominationNumber (G : SimpleGraph V) [DecidableRel G.Adj] : ℕ :=\n118:   minCard (IsIndependentDominatingSet G)\n119: \n120: /- ── degree-sequence invariants ───────────────────────────────────────────── -/\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
