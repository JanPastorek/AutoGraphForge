emma mem_ballWithin_of_walk {V : Type} [Fintype V] [DecidableEq V]\n37:     (G : SimpleGraph V) [DecidableRel G.Adj] {v w : V} (p : G.Walk v w) :\n38:     w ∈ ballWithin G p.length v := by\n39:   induction p using SimpleGraph.Walk.concatRec with\n40:   | Hnil =>\n41:     dsimp [ballWithin]\n42:     exact Finset.mem_singleton_self _\n43:   | Hconcat p hadj ih =>\n44:     rw [SimpleGraph.Walk.length_concat]\n45:     dsimp [ballWithin]\n46:     rw [Finset.mem_union]\n47:     right\n48:     rw [Finset.mem_biUnion]\n49:     refine ⟨_, ih, ?_⟩\n50:     rw [Finset.mem_filter]\n51:     exact ⟨Finset.mem_univ _, hadj⟩\n52: \n53: lemma mem_ballWithin_one_of_adj {V : Type} [Fintype V] [DecidableEq V]\n54:     (G : SimpleGraph V) [DecidableRel G.Adj] (c u : V) (hadj : G.Adj c u) :\n55:     u ∈ ballWithin G 1 c :=\n56:   mem_ballWithin_of_walk G (SimpleGraph.Walk.cons hadj SimpleGraph.Walk.nil)\n57: \n58: lemma ballWithin_subset_succ {V : Type} [Fintype V] [DecidableEq V]\n59:     (G : SimpleGraph V) [DecidableRel G.Adj] (k : ℕ) (v : V) :\n60:     ballWithin G k v ⊆ ballWithin G (k + 1) v := by\n61:   intro x hx\n62:   dsimp [ballWithin]\n63:   exact Finset.mem_union_left _ hx\n64: \n65: lemma mem_ballWithin_one_self {V : Type} [Fintype V] [DecidableEq V]\n66:     (G : SimpleGraph V) [DecidableRel G.Adj] (c : V) :\n67:     c ∈ ballWithin G 1 c :=\n68:   ballWithin_subset_succ G 0 c (Finset.mem_singleton_self c)\n69: \n70: lemma ballWithin_one_eq_univ_of_adj_all {V : Type} [Fintype V] [DecidableEq V]\n71:     (G : SimpleGraph V) [DecidableRel G.Adj] (u : V)\n72:     (h : ∀ w : V, w = u ∨ G.Adj u w) :\n73:     ballWithin G 1 u = Finset.univ := by\n74:   ext w\n75:   simp only [Finset.mem_univ, iff_true]\n76:   cases h w with\n77:   | inl heq => rw [heq]; exact mem_ballWithin_one_self G u\n78:   | inr hadj => exact mem_ballWithin_one_of_adj G u w hadj\n79: \n80: lemma radius_le_one_of_adj_all {V : Type} [Fintype V] [DecidableEq V]\n81:     (G : SimpleGraph V) [DecidableRel G.Adj]\n