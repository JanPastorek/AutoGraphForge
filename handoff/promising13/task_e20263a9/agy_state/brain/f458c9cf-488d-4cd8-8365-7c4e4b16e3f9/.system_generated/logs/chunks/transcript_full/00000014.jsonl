{"step_index":1484,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-11T23:53:25Z","content":"Created At: 2026-09-12T01:53:25+02:00\nCompleted At: 2026-09-12T01:53:25+02:00\nFile Path: `file:///mnt/home/japake298/project/GraphConjecturing/handoff/promising13/task_e20263a9/reference/GraphInvariantsComputable.lean`\nTotal Lines: 537\nTotal Bytes: 27292\nShowing lines 401 to 500\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n401: \n402: def totalDominationNumber (G : SimpleGraph V) [DecidableRel G.Adj] : ℕ :=\n403:   minCard (IsTotalDominatingSet G)\n404: \n405: /-- Undefined on a graph with an isolated vertex: nothing dominates it, so not\n406: even `univ` is a total dominating set and `minCard` would read `0`. graphcalc\n407: raises there rather than returning a number. -/\n408: def HasTotalDominationNumber (G : SimpleGraph V) [DecidableRel G.Adj] : Prop :=\n409:   HasWitness (IsTotalDominatingSet G)\n410: \n411: instance (G : SimpleGraph V) [DecidableRel G.Adj] :\n412:     Decidable (HasTotalDominationNumber G) := by\n413:   unfold HasTotalDominationNumber; infer_instance\n414: \n415: /- ── edge cover ───────────────────────────────────────────────────────────── -/\n416: \n417: /-- A set of edges meeting every vertex. -/\n418: def IsEdgeCoverFinset (G : SimpleGraph V) [DecidableRel G.Adj]\n419:     (s : Finset (Sym2 V)) : Prop := ∀ v : V, ∃ e ∈ s, v ∈ e\n420: \n421: instance (G : SimpleGraph V) [DecidableRel G.Adj] (s : Finset (Sym2 V)) :\n422:     Decidable (IsEdgeCoverFinset G s) := by\n423:   unfold IsEdgeCoverFinset; infer_instance\n424: \n425: /-- Edge cover number: least `k ≤ n` such that some `k` edges meet every vertex.\n426: \n427: Searched by size over `edgeFinset`, not over its whole powerset. A minimum edge\n428: cover never needs more than `n - 1` edges (Gallai: `ρ = n − ν`, and `ν ≥ 1` once\n429: there is an edge), so bounding `k` by `n` loses nothing. It matters: the full\n430: powerset of `K₆`'s 15 edges is 32,768 subsets and exhausted the kernel's\n431: recursion depth, while the subsets of size at most 6 number 9,949. -/\n432: def edgeCoverNumber (G : SimpleGraph V) [DecidableRel G.Adj] : ℕ :=\n433:   minUpTo (Fintype.card V)\n434:     (fun k => ∃ s ∈ G.edgeFinset.powersetCard k, IsEdgeCoverFinset G s)\n435: \n436: /-- Undefined exactly when some vertex is isolated — networkx raises \"no edge\n437: cover exists\" there, and `minUpTo`'s fallback would read `n`. An edge cover\n438: exists iff every vertex has a neighbour (take one incident edge per vertex), so\n439: this is stated directly instead of by a second subset search. -/\n440: def HasEdgeCover (G : SimpleGraph V) [DecidableRel G.Adj] : Prop :=\n441:   ∀ v : V, ∃ u : V, G.Adj v u\n442: \n443: instance (G : SimpleGraph V) [DecidableRel G.Adj] :\n444:     Decidable (HasEdgeCover G) := by unfold HasEdgeCover; infer_instance\n445: \n446: /- ── Roman domination ─────────────────────────────────────────────────────── -/\n447: \n448: /-- `f : V → {0,1,2}` is a Roman dominating function when every vertex labelled\n449: `0` has a neighbour labelled `2`.\n450: \n451: graphcalc solves this as a MIP over binaries `x, y` with `f = x + 2y`,\n452: constraint `x v + y v + Σ_{u ∈ N(v)} y u ≥ 1` and exclusion `x v + y v ≤ 1`;\n453: that is exactly the condition below. -/\n454: def IsRomanDominatingFunction (G : SimpleGraph V) [DecidableRel G.Adj]\n455:     (f : V → Fin 3) : Prop := ∀ v : V, f v = 0 → ∃ u : V, G.Adj v u ∧ f u = 2\n456: \n457: instance (G : SimpleGraph V) [DecidableRel G.Adj] (f : V → Fin 3) :\n458:     Decidable (IsRomanDominatingFunction G f) := by\n459:   unfold IsRomanDominatingFunction; infer_instance\n460: \n461: def romanWeight (f : V → Fin 3) : ℕ := ∑ v : V, (f v : ℕ)\n462: \n463: /-- Total, not partial: the constant function `2` is always Roman dominating\n464: (no vertex is labelled `0`), so a witness always exists. -/\n465: def romanDominationNumber (G : SimpleGraph V) [DecidableRel G.Adj] : ℕ :=\n466:   (((univ.filter (IsRomanDominatingFunction G)).image romanWeight).min).getD 0\n467: \n468: /- ── double Roman domination ──────────────────────────────────────────────── -/\n469: \n470: /-- `f : V → {0,1,2,3}` is double Roman dominating when a vertex labelled `0`\n471: has either a neighbour labelled `3` or two neighbours labelled `2`, and a vertex\n472: labelled `1` has a neighbour labelled `≥ 2`.\n473: \n474: The first clause is written as graphcalc's linearisation\n475: `0.5·|N₂(v)| + |N₃(v)| ≥ 1`, but as two existentials rather than as\n476: `Finset.card` of a filter: \"at least two neighbours labelled 2\" is \"two distinct\n477: neighbours labelled 2\", and the kernel reduces a pair of quantifiers over `V`\n478: far more cheaply than it builds and counts a `Finset`. Written the counting way\n479: first, all seven order-5 checks exhausted their heartbeat budget. -/\n480: def IsDoubleRomanDominatingFunction (G : SimpleGraph V) [DecidableRel G.Adj]\n481:     (f : V → Fin 4) : Prop :=\n482:   (∀ v : V, f v = 0 →\n483:       (∃ u : V, G.Adj v u ∧ f u = 3) ∨\n484:       (∃ u : V, ∃ w : V, u ≠ w ∧ G.Adj v u ∧ G.Adj v w ∧ f u = 2 ∧ f w = 2)) ∧\n485:   (∀ v : V, f v = 1 → ∃ u : V, G.Adj v u ∧ 2 ≤ (f u : ℕ))\n486: \n487: instance (G : SimpleGraph V) [DecidableRel G.Adj] (f : V → Fin 4) :\n488:     Decidable (IsDoubleRomanDominatingFunction G f) := by\n489:   unfold IsDoubleRomanDominatingFunction; infer_instance\n490: \n491: def doubleRomanWeight (f : V → Fin 4) : ℕ := ∑ v : V, (f v : ℕ)\n492: \n493: /-- Total, for the same reason as `romanDominationNumber`: constant `3` works. -/\n494: def doubleRomanDominationNumber (G : SimpleGraph V) [DecidableRel G.Adj] : ℕ :=\n495:   (((univ.filter (IsDoubleRomanDominatingFunction G)).image\n496:     doubleRomanWeight).min).getD 0\n497: \n498: /- ── radius ───────────────────────────────────────────────────────────────── -/\n499: \n500: /-- Vertices within `k` steps of `v`, by iterated neighbourhood expansion.\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
