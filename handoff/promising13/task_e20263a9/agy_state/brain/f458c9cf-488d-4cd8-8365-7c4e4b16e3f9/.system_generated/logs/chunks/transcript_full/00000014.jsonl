328:     Finset.card_le_card h_compl_subset\n329:   have h_card_split : Fintype.card V = (ballWithin G 1 u).card + (Finset.univ \\ (ballWithin G 1 u)).card := by\n330:     rw [← Finset.card_univ]\n331:     have hsub : ballWithin G 1 u ⊆ Finset.univ := Finset.subset_univ _\n332:     exact (Finset.card_sdiff_add_card_eq hsub).symm\n333:   have h_sum_ones : (Finset.univ.filter (fun v => (f v : ℕ) = 1)).card = ∑ v ∈ Finset.univ.filter (fun v => (f v : ℕ) = 1), (f v : ℕ) := by\n334:     rw [Finset.sum_congr rfl (fun x hx => (Finset.mem_filter.mp hx).2.symm)]\n335:     simp\n336:   have h_sum_le : (Finset.univ.filter (fun v => (f v : ℕ) = 1)).card + 2 ≤ GraphCalc.romanWeight f := by\n337:     unfold GraphCalc.romanWeight\n338:     have hu_not_one : u ∉ Finset.univ.filter (fun v => (f v : ℕ) = 1) := by\n339:       rw [Finset.mem_filter]\n340:       push Not\n341:       intro _\n342:       omega\n343:     have hsub : insert u (Finset.univ.filter (fun v => (f v : ℕ) = 1)) ⊆ Finset.univ := Finset.subset_univ _\n344:     have h2sub : ∑ v ∈ insert u (Finset.univ.filter (fun v => (f v : ℕ) = 1)), (f v : ℕ) ≤ ∑ v : V, (f v : ℕ) :=\n345:       Finset.sum_le_sum_of_subset_of_nonneg hsub (fun _ _ _ => Nat.zero_le _)\n346:     rw [Finset.sum_insert hu_not_one, hu2] at h2sub\n347:     rw [h_sum_ones]\n348:     omega\n349:   have h_card_bound : Fintype.card V ≤ (ballWithin G 1 u).card + (GraphCalc.romanWeight f - 2) := by\n350:     rw [h_card_split]\n351:     omega\n352:   have h_ball_univ := ballWithin_eq_univ_of_card_add G u hrad 1 (GraphCalc.romanWeight f - 2) h_card_bound\n353:   have heq : 1 + (GraphCalc.romanWeight f - 2) = GraphCalc.romanWeight f - 1 := by omega\n354:   rw [heq] at h_ball_univ\n355:   unfold GraphCalc.IsNontrivialClass at hnt\n356:   unfold GraphCalc.order at hnt\n357:   have h_ecc_le : GraphCalc.eccentricity G u ≤ GraphCalc.romanWeight f - 1 := by\n358:     unfold GraphCalc.eccentricity\n359:     by_cases h_le_n : GraphCalc.romanWeight f - 1 ≤ Fintype.card V\n3