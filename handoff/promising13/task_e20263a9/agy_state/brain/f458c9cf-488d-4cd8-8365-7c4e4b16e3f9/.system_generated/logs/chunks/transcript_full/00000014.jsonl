{"step_index":1478,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-11T23:53:21Z","content":"Created At: 2026-09-12T01:53:21+02:00\nCompleted At: 2026-09-12T01:53:21+02:00\nFile Path: `file:///mnt/home/japake298/project/GraphConjecturing/handoff/promising13/task_e20263a9/reference/GraphInvariantsComputable.lean`\nTotal Lines: 537\nTotal Bytes: 27292\nShowing lines 121 to 200\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n121: \n122: /-- Sum of the `k` smallest degrees.\n123: \n124: Stated as a minimum over `k`-element subsets rather than by sorting the degree\n125: sequence: the two agree (a `k`-subset of minimum degree-sum is exactly a choice\n126: of `k` smallest degrees), and this form stays decidable, whereas both\n127: `Multiset.sort` and `Finset.toList` are noncomputable and stall kernel\n128: reduction. -/\n129: def smallestDegreeSum (G : SimpleGraph V) [DecidableRel G.Adj] (k : ℕ) : ℕ :=\n130:   (((univ.powersetCard k).image (fun s => ∑ v ∈ s, G.degree v)).min).getD 0\n131: \n132: /-- Sum of the `k` largest degrees (dual of `smallestDegreeSum`). -/\n133: def largestDegreeSum (G : SimpleGraph V) [DecidableRel G.Adj] (k : ℕ) : ℕ :=\n134:   (((univ.powersetCard k).image (fun s => ∑ v ∈ s, G.degree v)).max).getD 0\n135: \n136: /-- Annihilation number: largest `k` whose `k` smallest degrees sum to `≤ m`. -/\n137: def annihilationNumber (G : SimpleGraph V) [DecidableRel G.Adj] : ℕ :=\n138:   maxUpTo (Fintype.card V) (fun k => smallestDegreeSum G k ≤ size G)\n139: \n140: /-- Slater number: least `t` with `t +` (sum of the `t` largest degrees) `≥ n`. -/\n141: def slaterNumber (G : SimpleGraph V) [DecidableRel G.Adj] : ℕ :=\n142:   minUpTo (Fintype.card V)\n143:     (fun t => Fintype.card V ≤ t + largestDegreeSum G t)\n144: \n145: /- ── bipartite ────────────────────────────────────────────────────────────── -/\n146: \n147: /-- `G` is bipartite: some vertex set has every edge crossing it.\n148: \n149: The specification says `G.Colorable 2`, which quantifies over colourings and has\n150: no `Decidable` instance, so `decide` cannot touch it — leaving `bipartite` a\n151: class that could be *stated* in an exported theorem but never refuted on a\n152: witness. Searching the powerset is decidable and finite; `isBipartiteClass_iff`\n153: proves the two agree. -/\n154: def IsBipartiteClass (G : SimpleGraph V) [DecidableRel G.Adj] : Prop :=\n155:   ∃ s ∈ (univ : Finset V).powerset,\n156:     ∀ u ∈ (univ : Finset V), ∀ v ∈ (univ : Finset V), G.Adj u v → (u ∈ s ↔ v ∉ s)\n157: \n158: instance (G : SimpleGraph V) [DecidableRel G.Adj] :\n159:     Decidable (IsBipartiteClass G) := by\n160:   unfold IsBipartiteClass; infer_instance\n161: \n162: /- ── vertex cover ─────────────────────────────────────────────────────────── -/\n163: \n164: /-- `s` covers every edge. This is mathlib's `SimpleGraph.IsVertexCover`\n165: restricted to a `Finset`, which is what makes it decidable: mathlib quantifies\n166: over `Set V` and its `vertexCoverNum` is an `⨅` over that, hence noncomputable.\n167: `isVertexCoverFinset_iff` below proves the two agree, so the mathlib definition\n168: remains the specification and nothing is taken on trust. -/\n169: def IsVertexCoverFinset (G : SimpleGraph V) [DecidableRel G.Adj] (s : Finset V) :\n170:     Prop :=\n171:   ∀ u ∈ (univ : Finset V), ∀ v ∈ (univ : Finset V), G.Adj u v → u ∈ s ∨ v ∈ s\n172: \n173: instance (G : SimpleGraph V) [DecidableRel G.Adj] (s : Finset V) :\n174:     Decidable (IsVertexCoverFinset G s) := by\n175:   unfold IsVertexCoverFinset; infer_instance\n176: \n177: theorem isVertexCoverFinset_iff (G : SimpleGraph V) [DecidableRel G.Adj]\n178:     (s : Finset V) : IsVertexCoverFinset G s ↔ G.IsVertexCover (↑s : Set V) := by\n179:   simp [IsVertexCoverFinset, SimpleGraph.IsVertexCover]\n180: \n181: def vertexCoverNumber (G : SimpleGraph V) [DecidableRel G.Adj] : ℕ :=\n182:   minCard (IsVertexCoverFinset G)\n183: \n184: /- ── zero-forcing family ──────────────────────────────────────────────────── -/\n185: \n186: def forcingStep (G : SimpleGraph V) [DecidableRel G.Adj] (S : Finset V) : Finset V :=\n187:   S ∪ univ.filter (fun w => w ∉ S ∧ ∃ v ∈ S, G.neighborFinset v \\ S = {w})\n188: \n189: def forcingClosure (G : SimpleGraph V) [DecidableRel G.Adj] (S : Finset V) : Finset V :=\n190:   (forcingStep G)^[Fintype.card V] S\n191: \n192: def IsZeroForcingSet (G : SimpleGraph V) [DecidableRel G.Adj] (S : Finset V) : Prop :=\n193:   forcingClosure G S = univ\n194: \n195: instance (G : SimpleGraph V) [DecidableRel G.Adj] (S : Finset V) :\n196:     Decidable (IsZeroForcingSet G S) := by\n197:   unfold IsZeroForcingSet; infer_instance\n198: \n199: def zeroForcingNumber (G : SimpleGraph V) [DecidableRel G.Adj] : ℕ :=\n200:   minCard (IsZeroForcingSet G)\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
