x as nx\nimport numpy as np\nfrom scipy.optimize import milp, LinearConstraint, Bounds\nimport random\n\ndef roman_domination(G):\n    n = G.number_of_nodes()\n    nodes = list(G.nodes())\n    node_idx = {v: i for i, v in enumerate(nodes)}\n    c = np.array([1]*n + [2]*n, dtype=float)\n    integrality = np.ones(2*n)\n    A_rows = []\n    lhs = []\n    rhs = []\n    for i, v in enumerate(nodes):\n        row1 = [0]*(2*n)\n        row1[i] = 1\n        row1[n + i] = 1\n        A_rows.append(row1)\n        lhs.append(0)\n        rhs.append(1)\n        \n        row2 = [0]*(2*n)\n        row2[i] = 1\n        row2[n + i] = 1\n        for u in G.neighbors(v):\n            row2[n + node_idx[u]] = 1\n        A_rows.append(row2)\n        lhs.append(1)\n        rhs.append(np.inf)\n        \n    constraints = LinearConstraint(A_rows, lhs, rhs)\n    bounds = Bounds(0, 1)\n    res = milp(c=c, integrality=integrality, constraints=constraints, bounds=bounds)\n    return int(round(res.fun))\n\n# Test random trees\nfound = False\nfor n in range(4, 25):\n    for trial in range(200):\n        T = nx.random_labeled_tree(n)\n        r = nx.radius(T)\n        rd = roman_domination(T)\n        if r + 1 > rd:\n            print(f'Counterexample tree: n={n}, r={r}, rd={rd}')\n            found = True\n            break\n    if found:\n        break\n\n# Test random graphs with low density (to maximize radius)\nfor n in range(5, 25):\n    for p in [0.1, 0.15, 0.2, 0.25]:\n        for trial in range(100):\n            G = nx.erdos_renyi_graph(n, p)\n            if nx.is_connected(G):\n                r = nx.radius(G)\n                rd = roman_domination(G)\n                if r + 1 > rd:\n                    print(f'Counterexample ER: n={n}, r={r}, rd={rd}')\n                    found = True\n                    break\n        if found:\n            break\n    if found:\n        break\n\nif not found:\n    print('No counterexample found in random tests!')\n\"\nTask logs are available at: file:///tmp/agyhome.NWyWnj/.gemini/antigravity-cli/brain/92752dbc-e919-4b9e-b022-202726747cbe/.system_generated/tasks/task-54.log\nYOU MUST TAKE ONE OF THE FOLLOWING TWO ACTIONS: A) either proceed to other relevant work (if any) or, B) simply update the user with a short message (that you have launched the command and will wait for it to finish) and end the turn.\n DO NOTHING ELSE."}
