od=\"curated\", lean_statement=thm(name, body))\n35:         log.info(\"[prove] %s\", informal)\n36:         r = prover.prove(c)\n37:         if r.success:\n38:             proved.append((informal, r))\n39:             log.info(\"[prove] ✓ KERNEL-VERIFIED by %s (%.1fs)\", r.model_name, r.elapsed_s or 0)\n40:         else:\n41:             log.info(\"[prove] ✗ %s\", r.error)\n42:     print(\"\\n\" + \"=\" * 70)\n43:     print(\"KERNEL-VERIFIED: %d / %d\" % (len(proved), len(CASES)))\n44:     for informal, r in proved:\n45:         print(\"-\" * 70); print(informal); print(r.proof_tactics)\n46:     return 0\n47: \n48: if __name__ == \"__main__\":\n49:     sys.exit(main())\n50: \nThe above content shows the entire, complete file contents of the requested file.\n"}
