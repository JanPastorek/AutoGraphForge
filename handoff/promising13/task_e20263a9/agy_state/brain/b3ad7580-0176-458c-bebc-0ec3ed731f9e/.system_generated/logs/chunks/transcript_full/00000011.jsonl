 : ℕ∞}\\n410: \\n411: @[simp]\\n412: theorem mem_ball : v ∈ G.ball c r ↔ G.edist v c < r := .rfl\\n413: \\n414: /-- The ball of radius zero is empty. -/\\n415: @[simp]\\n416: theorem ball_zero : G.ball c 0 = ∅ := by simp [ball]\\n417: \\n418: /-- The ball of radius one consists of just the center. -/\\n419: @[simp]\\n420: theorem ball_one : G.ball c 1 = {c} := by\\n421:   simp [ball]\\n422: \\n423: /-- The ball of radius two consists of the center and its neighbors. -/\\n424: @[simp]\\n425: theorem ball_two : G.ball c 2 = insert c (G.neighborSet c) := by\\n426:   ext v\\n427:   simp [one_add_one_eq_two.symm, ENat.lt_add_one_iff ENat.one_ne_top,\\n428:     edist_le_one_iff_adj_or_eq, adj_comm, or_comm]\\n429: \\n430: /-- The ball of radius `⊤` is the connected component of the center. -/\\n431: theorem ball_top :\\n432:     G.ball c ⊤ = (G.connectedComponentMk c).supp := by\\n433:   simp [Set.ext_iff, lt_top_iff_ne_top, edist_ne_top_iff_reachable]\\n434: \\n435: /-- A vertex is in the ball of radius `⊤` iff it is reachable from the center. -/\\n436: theorem mem_ball_top : v ∈ G.ball c ⊤ ↔ G.Reachable v c := by\\n437:   simp [lt_top_iff_ne_top, edist_ne_top_iff_reachable]\\n438: \\n439: /-- Balls are monotone in the radius. -/\\n440: @[gcongr]\\n441: theorem ball_mono (h : r₁ ≤ r₂) : G.ball c r₁ ⊆ G.ball c r₂ :=\\n442:   fun _ hv ↦ lt_of_lt_of_le hv h\\n443: \\n444: /-- The center vertex belongs to any ball of positive radius. -/\\n445: theorem mem_ball_self (hr : 0 < r) : c ∈ G.ball c r := by\\n446:   simp [ball, hr]\\n447: \\n448: /-- Ball membership is symmetric in center and point. -/\\n449: theorem mem_ball_comm : v ∈ G.ball c r ↔ c ∈ G.ball v r := by\\n450:   simp [ball, edist_comm]\\n451: \\n452: end ball\\n453: \\n454: end SimpleGraph\\n455: \\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\\n\",\"truncated_fields\":[\"cont