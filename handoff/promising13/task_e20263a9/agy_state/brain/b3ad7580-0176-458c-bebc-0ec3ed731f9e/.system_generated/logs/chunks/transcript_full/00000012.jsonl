order\\\", \\\"m\\\": \\\"size\\\", \\\"Delta\\\": \\\"maximum_degree\\\", \\\"delta\\\": \\\"minimum_degree\\\",\\n28:     \\\"avg_deg\\\": \\\"average_degree\\\", \\\"omega\\\": \\\"clique_number\\\",\\n29:     \\\"alpha\\\": \\\"independence_number\\\", \\\"chi\\\": \\\"chromatic_number\\\",\\n30:     \\\"gamma\\\": \\\"domination_number\\\", \\\"ind_dom\\\": \\\"independent_domination_number\\\",\\n31:     \\\"vertex_cover\\\": \\\"vertex_cover_number\\\", \\\"nu\\\": \\\"matching_number\\\",\\n32:     \\\"diam\\\": \\\"diameter\\\", \\\"rad\\\": \\\"radius\\\", \\\"min_edge_cover\\\": \\\"edge_cover_number\\\",\\n33: }\\n34: \\n35: TOL = 1e-6\\n36: \\n37: \\n38: def _load_battery() -> pd.DataFrame:\\n39:     paths = sorted(set(glob.glob(\\\"database/cache/battery_*.parquet\\\")))\\n40:     if not paths:\\n41:         raise SystemExit(\\\"no battery parquet found under database/cache/\\\")\\n42:     df = pd.concat([pd.read_parquet(p) for p in paths], ignore_index=True, sort=False)\\n43:     if \\\"connected\\\" in df:\\n44:         df = df[df[\\\"connected\\\"] == True]  # noqa: E712\\n45:     if \\\"nontrivial\\\" in df:\\n46:         df = df[df[\\\"nontrivial\\\"] == True]  # noqa: E712\\n47:     # derive the order-threshold predicates (older parquets predate them)\\n48:     if \\\"order\\\" in df.columns:\\n49:         o = pd.to_numeric(df[\\\"order\\\"], errors=\\\"coerce\\\")\\n50:         df[\\\"order_bigger_than_2\\\"] = (o > 2).fillna(False)\\n51:         df[\\\"order_bigger_than_3\\\"] = (o > 3).fillna(False)\\n52:     return df\\n53: \\n54: \\n55: def main() -> int:\\n56:     df = _load_battery()\\n57:     print(f\\\"battery (connected, non-trivial): {len(df)} graphs\\\")\\n58: \\n59:     def col(sym):\\n60:         c = SYM2COL.get(sym, sym)\\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\\n\"}\n138: {\"step_index\