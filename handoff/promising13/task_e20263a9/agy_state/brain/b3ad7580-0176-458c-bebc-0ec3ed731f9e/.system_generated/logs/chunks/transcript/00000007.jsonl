n1: import Mathlib\n2: import LeanProject.GraphInvariantsComputable\n3: \n4: open SimpleGraph\n5: open GraphCalc\n6: \n7: lemma ballWithin_subset_succ {V : Type} [Fintype V] [DecidableEq V]\n8:     (G : SimpleGraph V) [DecidableRel G.Adj] (k : ℕ) (v : V) :\n9:     ballWithin G k v ⊆ ballWithin G (k + 1) v := by\n10:   intro x hx\n11:   dsimp [ballWithin]\n12:   exact Finset.mem_union_left _ hx\n13: \n14: lemma ballWithin_subset_add {V : Type} [Fintype V] [DecidableEq V]\n15:     (G : SimpleGraph V) [DecidableRel G.Adj] (k m : ℕ) (v : V) :\n16:     ballWithin G k v ⊆ ballWithin G (k + m) v := by\n17:   induction m with\n18:   | zero => exact Finset.Subset.refl _\n19:   | succ m ih =>\n20:     have h1 := ballWithin_subset_succ G (k + m) v\n21:     exact Finset.Subset.trans ih h1\n22: \n23: lemma ballWithin_succ_eq_self_implies_add {V : Type} [Fintype V] [DecidableEq V]\n24:     (G : SimpleGraph V) [DecidableRel G.Adj] (k : ℕ) (v : V)\n25:     (h : ballWithin G (k + 1) v = ballWithin G k v) (m : ℕ) :\n26:     ballWithin G (k + m) v = ballWithin G k v := by\n27:   induction m with\n28:   | zero => rfl\n29:   | succ m ih =>\n30:     have heq : k + (m + 1) = (k + m) + 1 := by omega\n31:     rw [heq]\n32:     dsimp [ballWithin]\n33:     rw [ih]\n34:     exact h\n35: \n36: lemma ballWithin_succ_eq_self_implies_univ {V : Type} [Fintype V] [DecidableEq V]\n37:     (G : SimpleGraph V) [DecidableRel G.Adj] (k : ℕ) (v : V)\n38:     (hrad : GraphCalc.HasRadius G)\n39:     (h : ballWithin G (k + 1) v = ballWithin G k v) :\n40:     ballWithin G k v = Finset.univ := by\n41:   have h_add := ballWithin_succ_eq_self_implies_add G k v h (Fintype.card V)\n42:   have h_sub : ballWithin G (Fintype.card V) v ⊆ ballWithin G (k + Fintype.card V) v := by\n43:     have heq : k + Fintype.card V = Fintype.card V + k := by omega\n44:     rw [heq]\n45:     exact ballWithin_subset_add G (Fintype.card V) k v\n46:   rw [hrad v] at h_sub\n47:   rw [h_add] at h_sub\n48:   exact Finset.subset_antisymm (Finset.subset_univ _) h_sub\n49: \n50: lemma card_ballWithin_succ_of_ne_univ {V : Type} [Fintype V] [DecidableEq V]\n51:     (G : SimpleGraph V) [DecidableRel G.Adj] (k : ℕ) (v : V)\n52:     (hrad : GraphCalc.HasRadius G)\n53:     (hne : ballWithin G k v ≠ Finset.univ) :\n54:     (ballWithin G k v).card + 1 ≤ (ballWithin G (k + 1) v).card := by\n55:   have h_not_eq : ballWithin G (k + 1) v ≠ ballWithin G k v := by\n56:     intro heq\n57:     exact hne (ballWithin_succ_eq_self_implies_univ G k v hrad heq)\n58:   have h_sub := ballWithin_subset_succ G k v\n59:   have h_ssub : ballWithin G k v ⊂ ballWithin G (k + 1) v :=\n60:     Finset.ssubset_iff_subset_ne.mpr ⟨h_sub, h_not_eq.symm⟩\n61:   exact Finset.card_lt_card h_ssub\n62: \nThe above content shows the entire, complete file contents of the requested file.\n"}
