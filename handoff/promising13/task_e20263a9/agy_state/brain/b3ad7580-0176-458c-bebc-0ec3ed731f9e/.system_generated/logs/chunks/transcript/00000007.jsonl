 lemma ballWithin_subset_succ {V : Type} [Fintype V] [DecidableEq V]\n37:     (G : SimpleGraph V) [DecidableRel G.Adj] (k : ℕ) (v : V) :\n38:     ballWithin G k v ⊆ ballWith\n<truncated 3470 bytes>\n         omega\n120: \n121: lemma ballWithin_card_pred_eq_univ {V : Type} [Fintype V] [DecidableEq V]\n122:     (G : SimpleGraph V) [DecidableRel G.Adj] (v : V)\n123:     (hrad : GraphCalc.HasRadius G) (hnt : GraphCalc.IsNontrivialClass G) :\n124:     ballWithin G (Fintype.card V - 1) v = Finset.univ := by\n125:   have h := ballWithin_univ_or_card_ge G v hrad (Fintype.card V - 1)\n126:   cases h with\n127:   | inl h1 => exact h1\n128:   | inr h2 =>\n129:     unfold GraphCalc.IsNontrivialClass at hnt\n130:     unfold GraphCalc.order at hnt\n131:     have h_card_eq : (Fintype.card V - 1) + 1 = Fintype.card V := by omega\n132:     rw [h_card_eq] at h2\n133:     by_contra hc\n134:     have h_ssub : ballWithin G (Fintype.card V - 1) v ⊂ Finset.univ :=\n135:       Finset.ssubset_univ_iff.mpr hc\n136:     have h_lt := Finset.card_lt_card h_ssub\n137:     rw [Finset.card_univ] at h_lt\n138:     omega\n139: \n140: lemma eccentricity_le_card_pred {V : Type} [Fintype V] [DecidableEq V]\n141:     (G : SimpleGraph V) [DecidableRel G.Adj] (v : V)\n142:     (hrad : GraphCalc.HasRadius G) (hnt : GraphCalc.IsNontrivialClass G) :\n143:     GraphCalc.eccentricity G v ≤ Fintype.card V - 1 := by\n144:   unfold GraphCalc.eccentricity\n145:   apply minUpTo_le (Fintype.card V) (by omega) (ballWithin_card_pred_eq_univ G v hrad hnt)\n146: \n147: lemma radius_add_one_le_card {V : Type} [Fintype V] [DecidableEq V]\n148:     (G : SimpleGraph V) [DecidableRel G.Adj]\n149:     (hrad : GraphCalc.HasRadius G) (hnt : GraphCalc.IsNontrivialClass G) :\n150:     GraphCalc.radius G + 1 ≤ Fintype.card V := by\n151:   unfold GraphCalc.IsNontrivialClass at hnt\n152:   unfold GraphCalc.order at hnt\n153:   have h_nonempty : Nonempty V := by\n154:     by_contra hc\n155:     have : Fintype.card V = 0 := Fintype.ca