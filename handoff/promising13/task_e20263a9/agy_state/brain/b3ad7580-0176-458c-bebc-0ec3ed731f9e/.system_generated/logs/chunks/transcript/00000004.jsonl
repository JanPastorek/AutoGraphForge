{"step_index":680,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-11T18:32:02Z","content":"Created At: 2026-09-11T20:32:02+02:00\nCompleted At: 2026-09-11T20:32:02+02:00\nFile Path: `file:///mnt/home/japake298/project/GraphConjecturing/pipeline/lean_export.py`\nTotal Lines: 244\nTotal Bytes: 11198\nShowing lines 1 to 100\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: \"\"\"\n2: pipeline/lean_export.py — well-formed Lean 4 export for the *supported* subset of\n3: CEGIS survivors.\n4: \n5: graffiti3 will happily render any conjecture to a Lean stub, but a stub over\n6: undefined symbols (``domination_number G``) can never be kernel-verified. This\n7: module restricts export to conjectures whose invariants are backed by the\n8: ``LeanProject.GraphInvariants`` preamble (mathlib defs + a small domination\n9: layer), maps each invariant to its real Lean name, and emits a self-contained,\n10: compilable ``theorem … := sorry`` (imports + binders + ``open SimpleGraph``) that\n11: a prover can actually close.\n12: \n13: Out of scope (silently skipped, not mis-formalized): invariants with no faithful\n14: mathlib definition yet (zero forcing, residue, Roman domination, …) and\n15: conjectures conditioned on a graph class with no formalization (chordal, planar).\n16: \"\"\"\n17: from __future__ import annotations\n18: \n19: import re\n20: from typing import Dict, List, Optional\n21: \n22: from pipeline import linear_form\n23: from pipeline.lean_disproof import definedness_hyps\n24: \n25: # pipeline invariant column  →  Lean expression over `(G : SimpleGraph V)`.\n26: # Only invariants with a faithful definition in LeanProject.GraphInvariants (or\n27: # mathlib, re-exported there) appear here.\n28: SUPPORTED: Dict[str, str] = {\n29:     \"order\":                         \"G.order\",\n30:     \"size\":                          \"G.size\",\n31:     \"minimum_degree\":                \"G.minDegree\",\n32:     \"maximum_degree\":                \"G.maxDegree\",\n33:     \"cl\n<truncated 1777 bytes>\negular\": \"IsRegularClass\", \"cubic\": \"IsCubicClass\",\n65:     \"subcubic\": \"IsSubcubicClass\", \"triangle_free\": \"IsTriangleFreeClass\",\n66:     \"K_4_free\": \"IsK4FreeClass\", \"bipartite\": \"IsBipartiteClass\",\n67:     \"eulerian\": \"IsEulerianClass\",\n68:     # mathlib has these directly (`Connected`, `IsTree`)\n69:     \"connected\": \"IsConnectedClass\", \"tree\": \"IsTreeClass\",\n70:     # forbidden induced subgraph on four vertices: K₁,₃ and P₄ respectively\n71:     \"claw_free\": \"IsClawFreeClass\", \"cograph\": \"IsCographClass\",\n72:     # graphcalc's auto-base hypothesis on every Graffiti3 conjecture: |V| ≥ 2.\n73:     \"nontrivial\": \"IsNontrivialClass\",\n74: }\n75: _REL_LEAN = {\"≤\": \"≤\", \"≥\": \"≥\", \"<=\": \"≤\", \">=\": \"≥\", \"=\": \"=\"}\n76: \n77: \n78: def _condition_classes(cond: str, columns) -> List[str]:\n79:     return [c for c in columns if re.search(r\"\\b\" + re.escape(c) + r\"\\b\", cond)]\n80: \n81: \n82: def _bare_invariant(side: str, columns) -> Optional[str]:\n83:     \"\"\"A side that is exactly one supported invariant (no coefficient/offset/\n84:     product), else None.\"\"\"\n85:     invs = [c for c in columns if re.search(r\"\\b\" + re.escape(c) + r\"\\b\", side)]\n86:     if len(invs) != 1 or invs[0] not in SUPPORTED:\n87:         return None\n88:     leftover = re.sub(r\"\\b\" + re.escape(invs[0]) + r\"\\b\", \" \", side)\n89:     leftover = re.sub(r\"[()\\s]\", \"\", leftover)        # parens/space ok\n90:     return invs[0] if not leftover else None           # any coeff/const → reject\n91: \n92: \n93: def render_conditioned(native, columns) -> Optional[str]:\n94:     \"\"\"Self-rendered theorem for a class-conditioned conjecture with a simple\n95:     ``invariant REL invariant`` body, else None. The hypothesis is the conjunction\n96:     of supported class predicates.\"\"\"\n97:     try:\n98:         pretty = native.pretty()\n99:     except Exception:\n100:         return None\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n","truncated_fields":["content"]}
