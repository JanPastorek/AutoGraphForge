ble\",\n141:                     \"LeanProject.GraphInvariants\"}\n142: \n143: \n144: def _norm(text: str) -> str:\n145:     return \"\\n\".join(line.rstrip() for line in text.replace(\"\\r\\n\", \"\\n\").split(\"\\n\"))\n146: \n147: \n148: def _strip_comments(src: str) -> str:\n149:     src = re.sub(r\"/-.*?-/\", \" \", src, flags=re.S)\n150:     return re.sub(r\"--[^\\n]*\", \" \", src)\n151: \n152: \n153: def _prefix(original: str):\n154:     \"\"\"Everything up to the first theorem: imports, options, `Candidate`.\"\"\"\n155:     i = original.find(\"abbrev Candidate\")\n156:     j = original.find(\"\\n\\ntheorem \", i) if i >= 0 else -1\n157:     return original[:j] if j >= 0 else None\n158: \n159: \n160: def structural_check(original: str, returned: str):\n161:     \"\"\"(ok, reason): may the returned file be compiled as an answer at all?\"\"\"\n162:     orig, ret = _norm(original), _norm(returned)\n163:     pre = _prefix(orig)\n164:     if pre is None:\n165:         return False, \"original challenge is malformed\"\n166:     if not ret.startswith(pre):\n167:         return False, \"statement changed: text above the first theorem differs\"\n168:     rest = ret[len(pre):]\n169:     if rest and not rest.startswith(\"\\n\"):\n170:         return False, \"statement changed: Candidate's last line was extended\"\n171:     code = _strip_comments(rest)\n172:     head = code.lstrip()\n173:     if head and not head.startswith(_CMD_START):\n174:         return False, \"statement changed: Candidate continues past its original end\"\n175:     m = _FORBIDDEN_CMD.search(code)\n176:     if m:\n177:         return False, f\"forbidden command `{m.group(1)}`\"\n178:     m = _FORBIDDEN_TOKEN.search(code)\n179:     if m:\n180:         return False, f\"forbidden construct `{m.group(0)}`\"\n181:     return True, \"\"\n182: \n183: \n184: def lint_text(text: str, original=None):\n185:     \"\"\"(ok, reason) for any Lean file an agent asks to elaborate.\n186: \n187:     A challenge file is held to `structural_check` against its original. Any\n188:     other file (scratch lemmas) gets the same code-execution screen plus an\n189:     import whitelist, since `import` is the other way to pull in code.\n190:     \"\"\"\n191:     if original is not None:\n192:         return structural_check(original, text)\n193:     code = _strip_comments(_norm(text))\n194:     for m in re.finditer(r\"(?m)^\\s*import\\s+(\\S+)\", code):\n195:         if m.group(1) not in _ALLOWED_IMPORTS:\n196:             return False, f\"import `{m.group(1)}` is not allowed\"\n197:     m = _FORBIDDEN_CMD.search(code)\n198:     if m:\n199:         return False, f\"forbidden command `{m.group(1)}`\"\n200:     m = _FORBIDDEN_TOKEN.search(code)\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
