 is at least 1, implying $rad(G)+1 \\\\le \\\\gamma_R(G)$. A critical question remains: Can a graph with $rad(G) \\\\ge 2$ violate this inequality?\\n\\n\\n\",\"tool_calls\":[{\"name\":\"run_command\",\"args\":{\"CommandLine\":\"\\\"/mnt/home/japake298/project/GraphConjecturing/.venv/bin/python -c '\\\\nimport networkx as nx\\\\nimport random\\\\nfrom scipy.optimize import milp, LinearConstraint\\\\n\\\\ndef roman_domination_number_milp(G):\\\\n    # MIP for Roman domination\\\\n    # Nodes 0..n-1\\\\n    # For each v: x_v in {0,1}, y_v in {0,1}\\\\n    # f(v) = x_v + 2*y_v\\\\n    # Exclusion: x_v + y_v <= 1\\\\n    # Condition: x_v + y_v + sum_{u in N(v)} y_u >= 1\\\\n    # Objective: sum (x_v + 2*y_v)\\\\n    n = G.number_of_nodes()\\\\n    nodes = list(G.nodes())\\\\n    node_to_idx = {nodes[i]: i for i in range(n)}\\\\n    # variables: 2*n (x_0..x_{n-1}, y_0..y_{n-1})\\\\n    c = [1.0]*n + [2.0]*n\\\\n    \\\\n    # Constraints:\\\\n    # 1) x_v + y_v <= 1  =>  x_v + y_v <= 1\\\\n    # 2) x_v + y_v + sum_{u in N(v)} y_u >= 1\\\\n    import numpy as np\\\\n    num_constraints = 2 * n\\\\n    A = np.zeros((num_constraints, 2*n))\\\\n    lhs = np.zeros(num_constraints)\\\\n    rhs = np.zeros(num_constraints)\\\\n    \\\\n    # Exclusion:\\\\n    for i in range(n):\\\\n        A[i, i] = 1.0\\\\n        A[i, n + i] = 1.0\\\\n        lhs[i] = 0.0\\\\n        rhs[i] = 1.0\\\\n        \\\\n    # Dominating:\\\\n    for i in range(n):\\\\n        row = n + i\\\\n        A[row, i] = 1.0\\\\n        A[row, n + i] = 1.0\\\\n        for u in G.neighbors(nodes[i]):\\\\n            A[row, n + node_to_idx[u]] = 1.0\\\\n        lhs[row] = 1.0\\\\n        rhs[row] = np.inf\\\\n        \\\\n    constraints = LinearConstraint(A, lhs, rhs)\\\\n    integrality = np.ones(2*n) # all binary\\\\n    res = milp(c=c, constraints=constraints, integrality=integrality, bounds=(0, 1))\\\\n    return int(round(res.fun))\\\\n\\\\n# Test on various graph families:\\\\nprint(\\\\\\\"Testing trees