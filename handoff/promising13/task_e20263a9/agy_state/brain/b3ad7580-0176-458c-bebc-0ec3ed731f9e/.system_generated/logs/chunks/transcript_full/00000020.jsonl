is the\\n22: only error that matters here.\\n23: \\\"\\\"\\\"\\n24: from __future__ import annotations\\n25: \\n26: import logging\\n27: import re\\n28: from collections import defaultdict\\n29: from typing import Dict, L\\n<truncated 1721 bytes>\\nn_number\\\",\\n63:     \\\"edge_domination_number\\\",\\n64:     # independence / matching / cover extras\\n65:     \\\"annihilation_number\\\", \\\"residue\\\", \\\"square_residue\\\",\\n66:     \\\"slater\\\", \\\"LG_slater\\\", \\\"min_maximal_matching_number\\\", \\\"min_edge_cover\\\",\\n67:     # zero-forcing family\\n68:     \\\"zero_forcing_number\\\", \\\"total_zero_forcing_number\\\",\\n69:     \\\"connected_zero_forcing_number\\\", \\\"positive_semidefinite_zero_forcing_number\\\",\\n70:     # distance / misc\\n71:     \\\"triameter\\\",\\n72:     \\\"power_min_degree_residue_sum\\\", \\\"power_min_degree_annihilation_sum\\\",\\n73:     \\\"power_2_annihilation_sum\\\", \\\"power_3_annihilation_sum\\\",\\n74: ]\\n75: for _t in _NEW_INVARIANTS:\\n76:     TOKEN2SYM.setdefault(_t, _t)\\n77: \\n78: # Tokens, longest first, so e.g. ``total_domination_number`` is preferred over a\\n79: # spurious ``domination_number`` substring (underscores already block most of\\n80: # these, but length ordering is a cheap belt-and-braces).\\n81: INV_TOKENS = sorted(TOKEN2SYM, key=len, reverse=True)\\n82: \\n83: # graphcalc column -> symbol, for extending pipeline.cegis_novelty._GC2TABLE so\\n84: # that *generated* conjectures over these invariants parse into Inequalities.\\n85: GC_COLUMNS: Dict[str, str] = {t: TOKEN2SYM[t] for t in _NEW_INVARIANTS}\\n86: \\n87: # Graph-class words we model; anything else in a hypothesis -> skip the relation.\\n88: _CLASS_WORDS = {\\n89:     \\\"well-covered\\\": \\\"well_covered\\\",\\n90:     \\\"bipartite\\\": \\\"bipartite\\\",\\n91:     \\\"claw-free\\\": \\\"claw_free\\\",\\n92:     \\\"tree\\\": \\\"tree\\\",\\n93:     \\\"triangle-free\\\": \\\"triangle_free\\\",\\n94:     \\\"cubic\\\": \\