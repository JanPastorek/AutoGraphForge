ingSet G)\\n259: \\n260: /-- `connectedZeroForcingNumber` is meaningful: a connected zero-forcing set\\n261: exists. False on every disconnected graph, which is precisely where graphcalc\\n262: reports no value and where the conjectures never made a claim. -/\\n263: def HasConnectedZeroForcingNumber (G : SimpleGraph V) [DecidableRel G.Adj] : Prop :=\\n264:   HasWitness (IsConnectedZeroForcingSet G)\\n265: \\n266: instance (G : SimpleGraph V) [DecidableRel G.Adj] :\\n267:     Decidable (HasConnectedZeroForcingNumber G) := by\\n268:   unfold HasConnectedZeroForcingNumber; infer_instance\\n269: \\n270: /- ── graph-class predicates ───────────────────────────────────────────────── -/\\n271: \\n272: def IsNontrivialClass (G : SimpleGraph V) : Prop := 2 ≤ order G\\n273: \\n274: instance (G : SimpleGraph V) : Decidable (IsNontrivialClass G) := by\\n275:   unfold IsNontrivialClass; infer_instance\\n276: \\n277: def IsRegularClass (G : SimpleGraph V) [DecidableRel G.Adj] : Prop :=\\n278:   ∀ u v : V, G.degree u = G.degree v\\n279: \\n280: instance (G : SimpleGraph V) \\n<truncated 7560 bytes>\\nSym2 V)) : Prop := ∀ v : V, ∃ e ∈ s, v ∈ e\\n420: \\n421: instance (G : SimpleGraph V) [DecidableRel G.Adj] (s : Finset (Sym2 V)) :\\n422:     Decidable (IsEdgeCoverFinset G s) := by\\n423:   unfold IsEdgeCoverFinset; infer_instance\\n424: \\n425: /-- Edge cover number: least `k ≤ n` such that some `k` edges meet every vertex.\\n426: \\n427: Searched by size over `edgeFinset`, not over its whole powerset. A minimum edge\\n428: cover never needs more than `n - 1` edges (Gallai: `ρ = n − ν`, and `ν ≥ 1` once\\n429: there is an edge), so bounding `k` by `n` loses nothing. It matters: the full\\n430: powerset of `K₆`'s 15 edges is 32,768 subsets and exhausted the kernel's\\n431: recursion depth, while the subsets of size at most 6 number 9,949. -/\\n432: def edgeCoverNumber (G : SimpleGraph V) [DecidableRel G.Adj] : ℕ :=\\n433:   minUpTo (Fintype.card V)\\n434:     (fun k => ∃ s ∈ G.edgeFinset.powersetCard k, IsEdgeCoverFinset G s)\\n435: \\n436: /-- Undefined exactly when some vertex is isolated — networkx raises \\\"no edge\\n437: cover exists\\\" there, and `minUpTo`'s fallback would read `n`. An edge cover\\n438: exists iff every vertex has a neighbour (take one incident edge per vertex), so\\n439: this is stated directly instead of by a second subset search. -/\\n440: def HasEdgeCover (G : SimpleGraph V) [DecidableRel G.Adj] : Prop :=\\n441:   ∀ v : V, ∃ u : V, G.Adj v u\\n442: \\n443: instance (G : SimpleGraph V) [DecidableRel G.Adj] :\\n444:     Decidable (HasEdgeCover G) := by unfold HasEdgeCover; infer_instance\\n445: \\n446: /- ── Roman domination ─────────────────────────────────────────────────────── -/\\n447: \\n448: /-- `f : V → {0,1,2}` is a Roman dominating function when every vertex labelled\\n449: `0` has a neighbour labelled `2`.\\n450: \\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\\n\",\"truncated_fields\":[\"content\"]}\n20: {\"step_index\":19,\"source\":\"MODEL\",\"type\":\"PLANNER_RESPONSE\",\"status\":\"DONE\",\"created_at\":\"2026-09-11T18:29:26Z\",\"tool_calls\":[{\"name\":\"view_file\",\"args\":{\"AbsolutePath\":\"\\\"/mnt/home/japake298/project/GraphConjecturing/handoff/promising13/task_e20263a9/reference/GraphInvariantsComputable.lean\\\"\",\"EndLine\":\"537\",\"StartLine\":\"450\",\"toolAction\":\"\\\"Viewing GraphInvariantsComputable.lean lines 450-537\\\"\",\"toolSummary\":\"\\\"View Roman domination and radius definitions\\\"\"}}]}\n21: {\"step_index\":20,\"source\":\"MODEL\",\"type\":\"GENERIC\",\"status\":\"DONE\",\"created_at\":\"2026-09-11T18:29:27Z\",\"content\":\"Created At: 2026-09-11T20:29:27+02:00\\nCompleted At: 2026-09-11T20:29:27+02:00\\nFile Path: `file:///mnt/home/japake298/project/GraphConjecturing/handoff/promising13/task_e20263a9/reference/GraphInvariantsComputable.lean`\\nTotal Lines: 537\\nTotal Bytes: 27292\\nShowing lines 450 to 537\\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\\n450: \\n451: graphcalc solves this as a MIP over binaries `x, y` with `f = x + 2y`,\\n452: constraint `x v + y v + Σ_{u ∈ N(v)} y u ≥ 1` and exclusion `x v + y v ≤ 1`;\\n453: that is exactly the condition below. -/\\n454: def IsRomanDominatingFunction (G : SimpleGraph V) [DecidableRel G.Adj]\\n455:     (f : V → Fin 3) : Prop := ∀ v : V, f v = 0 → ∃ u : V, G.Adj v u ∧ f u = 2\\n456: \\n457: instance (G : SimpleGraph V) [DecidableRel G.Adj] (f : V → Fin 3) :\\n458:     Decidable (IsRomanDominatingFunction G f) := by\\n459:   unfold IsRomanDominatingFunction; infer_instance\\n460: \\n461: def romanWeight (f : V → Fin 3) : ℕ := ∑ v : V, (f v : ℕ)\\n462: \\n463: /-- Total, not partial: the constant function `2` is always Roman dominating\\n464: (no vertex is labelled `0`), so a witness always exists. -/\\n465: def romanDominationNumber (G : SimpleGraph V) [DecidableRel G.Adj] : ℕ :=\\n466:   (((univ.filter (IsRomanDominatingFunction G)).image romanWeight).min).getD 0\\n467: \\n468: /- ── double Roman domination ──────────────────────────────────────────────── -/\\n469: \\n470: /-- `f : V → {0,1,2,3}` is double Roman dominating when a vertex labelled `0`\\n471: has either a neighbour labelled `3` or two neighbours labelled `2`, and a vertex\\n472: labelled `1` has a neighbour labelled `≥ 2`.\\n473: \\n474: The first clause is written as graphcalc's linearisation\\n475: `0.5·|N₂(v)| + |N₃(v)| ≥ 1`, but as two existentia\\n<truncated 1767 bytes>\\nlity. -/\\n503: def ballWithin (G : SimpleGraph V) [DecidableRel G.Adj] : ℕ → V → Finset V\\n504:   | 0,       v => {v}\\n505:   | (k + 1), v =>\\n506:       let B := ballWithin G k v\\n507:       B ∪ B.biUnion (fun u => univ.filter (fun w => G.Adj u w))\\n508: \\n509: /-- Eccentricity of `v`: least `k` with every vertex within `k` steps. -/\\n510: def eccentricity (G : SimpleGraph V) [DecidableRel G.Adj] (v : V) : ℕ :=\\n511:   minUpTo (Fintype.card V) (fun k => ballWithin G k v = univ)\\n512: \\n513: def radius (G : SimpleGraph V) [DecidableRel G.Adj] : ℕ :=\\n514:   ((univ.image (eccentricity G)).min).getD 0\\n515: \\n516: /-- Undefined on a disconnected graph, where some vertex never reaches all of\\n517: `univ` and `minUpTo` would fall back to `n`. networkx raises there. -/\\n518: def HasRadius (G : SimpleGraph V) [DecidableRel G.Adj] : Prop :=\\n519:   ∀ v : V, ballWithin G (Fintype.card V) v = univ\\n520: \\n521: instance (G : SimpleGraph V) [DecidableRel G.Adj] :\\n522:     Decidable (HasRadius G) := by unfold HasRadius; infer_instance\\n523: \\n524: /- ── graph construction from an explicit edge list ────────────────────────── -/\\n525: \\n526: /-- The graph on `Fin n` with the given edge list, symmetrised and loop-free.\\n527: This is the shape the disproof exporter emits for a refuting witness.\\n528: \\n529: `SimpleGraph.fromRel` supplies the symmetry and irreflexivity proofs, so this\\n530: stays a definition rather than a bundle of obligations that would have to be\\n531: re-discharged (and re-adjusted across mathlib versions) in generated code. It is\\n532: an `abbrev` so that `DecidableRel` synthesis can see through it at the use site. -/\\n533: abbrev ofEdges (n : ℕ) (es : List (Fin n × Fin n)) : SimpleGraph (Fin n) :=\\n534:   SimpleGraph.fromRel (fun u v => (u, v) ∈ es)\\n535: \\n536: end GraphCalc\\n537: \\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\\n\",\"truncated_fields\":[\"content\"]}\n22: {\"step_index\":21,\"source\":\"MODEL\",\"type\":\"PLANNER_RESPONSE\",\"status\":\"DONE\",\"created_at\":\"2026-09-11T18