{"step_index":656,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-11T18:31:15Z","content":"Created At: 2026-09-11T20:31:15+02:00\nCompleted At: 2026-09-11T20:31:15+02:00\nFile Path: `file:///mnt/home/japake298/project/GraphConjecturing/tools/verify_proofs.py`\nTotal Lines: 120\nTotal Bytes: 4985\nShowing lines 1 to 100\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: #!/usr/bin/env python3\n2: \"\"\"tools/verify_proofs.py — authoritative, independent re-verification of every\n3: proof the prover shim persisted to results/verified_proofs/.\n4: \n5: Why this exists (run 53863): the live reprove count is gated by the HTTP client\n6: (LocalEndpointProver), whose timeout (prover_timeout_s + 30) can be SHORTER than a\n7: multi-round agentic proof, so a genuinely kernel-verified proof gets dropped from\n8: the job-level tally even though it passed. The shim now persists each verified\n9: proof the instant it passes; this script re-checks those saved artifacts with the\n10: SAME sound bare-`lean` + LEAN_PATH kernel check (LeanSubprocessProver._run_lean,\n11: canary-tested true/false), decoupling the trustworthy count from the orchestration.\n12: \n13: This is the number to cite: a proof counts iff its self-contained `.lean` file\n14: (mathlib + GraphInvariants preamble + the proof) elaborates cleanly here, with no\n15: network, no model, and no client in the loop.\n16: \n17: Usage:\n18:     .venv/bin/python tools/verify_proofs.py [--dir results/verified_proofs]\n19: Exit code is the number of proofs that FAILED re-verification (0 = all good).\n20: \"\"\"\n21: import argparse\n22: import glob\n23: import os\n24: import sys\n25: \n26: sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))\n27: \n28: from config import CONFIG\n29: from pipeline.theorem_prover import LeanSubprocessProver\n30: from pipeline import proof_audit\n31: \n32: \n33: def _program(text: str) -> str:\n34:     \"\"\"Return just the self-contained Lean program, dropping any metadata header.\n35:     A persisted file is a comment header + the wrapped proof; the proof always\n36:     begins with `import Mathlib` (LeanSubprocessProver/_wrap guarantees it). Taking\n37:     from the first standalone `import Mathlib` line skips the header — and also\n38:     salvages files written before the persistence header was line-comment-safe\n39:     (where a multi-line statement leaked in as bare code above the real proof).\"\"\"\n40:     lines = text.splitlines()\n41:     for i, ln in enumerate(lines):\n42:         if ln.strip() == \"import Mathlib\":\n43:             return \"\\n\".join(lines[i:])\n44:     return text\n45: \n46: \n47: def _requested_statement(text: str) -> str:\n48:     \"\"\"The statement the prover was asked about, recovered from the header.\n49: \n50:     Two header formats exist. The current one comments every statement line\n51:     (``-- stmt: …``). Older artifacts commented only the first line\n52:     (``-- statement: import Mathlib``) and leaked the rest as bare code above the\n53:     proof; there the statement runs to the standalone ``import Mathlib`` that\n54:     starts the proof proper. Returns \"\" when neither header is present.\n55:     \"\"\"\n56:     lines = text.splitlines()\n57:     tagged = [ln[len(\"-- stmt:\"):].lstrip() for ln in lines if ln.startswith(\"-- stmt:\")]\n58:     if tagged:\n59:         return \"\\n\".join(tagged)\n60:     for i, ln in enumerate(lines):\n61:         if ln.startswith(\"-- statement:\"):\n62:             head = [ln[len(\"-- statement:\"):].lstrip()]\n63:             for rest in lines[i + 1:]:\n64:                 if rest.strip() == \"import Mathlib\":     # start of the proof file\n65:                     return \"\\n\".join(head)\n66:                 head.append(rest)\n67:             return \"\\n\".join(head)\n68:     return \"\"\n69: \n70: \n71: def main() -> int:\n72:     ap = argparse.ArgumentParser()\n73:     ap.add_argument(\"--dir\", default=os.path.join(\"results\", \"verified_proofs\"),\n74:                     help=\"directory of persisted *.lean proofs to re-verify\")\n75:     args = ap.parse_args()\n76: \n77:     lean = LeanSubprocessProver(CONFIG)\n78:     if not lean._available:\n79:         print(\"ERROR: no Lean binary available to kernel-check — aborting \"\n80:               \"(an unverifiable run must not report success).\")\n81:         return 2\n82: \n83:     files = sorted(glob.glob(os.path.join(args.dir, \"*.lean\")))\n84:     if not files:\n85:         print(f\"No persisted proofs found in {args.dir} (nothing to verify).\")\n86:         return 0\n87: \n88:     passed, failed = [], []\n89:     for path in files:\n90:         with open(path) as f:\n91:             text = f.read()\n92:         code = _program(text)\n93:         name = os.path.basename(path)\n94:         # Identity first: a proof of the wrong statement must not be counted even\n95:         # if it elaborates perfectly. Skipped only for artifacts with no recorded\n96:         # request (pre-header files), where there is nothing to compare against.\n97:         want = _requested_statement(text)\n98:         if want.strip():\n99:             ok, why = proof_audit.static_audit(want, code)\n100:             if not ok:\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
