{"step_index":682,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-11T18:32:03Z","content":"Created At: 2026-09-11T20:32:03+02:00\nCompleted At: 2026-09-11T20:32:04+02:00\nFile Path: `file:///mnt/home/japake298/project/GraphConjecturing/pipeline/theorem_prover.py`\nTotal Lines: 890\nTotal Bytes: 40615\nShowing lines 1 to 100\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: \"\"\"\n2: pipeline/theorem_prover.py — Stage 4: Automated Theorem Proving\n3: \n4: Provides a clean interface to neural theorem provers (Goedel-Prover,\n5: DeepSeek-Prover-V2).  These systems are cutting-edge research prototypes\n6: with no stable public API as of 2025; the implementations below are\n7: well-documented stubs that wire the correct request/response schema.\n8: \n9: To connect a real prover:\n10:   1. Set cfg.prover_api_url and cfg.prover_api_key in config.py (or env vars).\n11:   2. Replace the `_STUB_RESPONSE` logic in `_call_prover_api` with real HTTP calls.\n12:   3. The response schema is documented in `ProverResponse`.\n13: \n14: The module also supports a `LeanSubprocessProver` that tries to search for\n15: a proof using the `lean` binary + `exact?` / `decide` tactics (works for\n16: very simple arithmetic statements).\n17: \"\"\"\n18: \n19: from __future__ import annotations\n20: \n21: import json\n22: import logging\n23: import os\n24: import shutil\n25: import subprocess\n26: import tempfile\n27: import textwrap\n28: import time\n29: from dataclasses import dataclass, field\n30: from pathlib import Path\n31: from typing import List, Optional\n32: \n33: from config import Config, CONFIG\n34: from conjecture import Conjecture, ConjectureStatus\n35: from pipeline import proof_audit\n36: \n37: logger = logging.getLogger(__name__)\n38: \n39: \n40: # Markers in Lean's output that signal an incomplete / uncertified proof. A zero\n41: # exit code alone is NOT sufficient: inside a lake project `apply?`/`exact?` leave\n42: # \"Try this\" suggestions with unsolved subgoals yet `lean` may still exit 0, and\n43: # `sorry`/`admit` only warn. (This is the false-positive that once mis-certified a\n44: # false `domination = slater` theorem.)\n45: _BAD_PROOF_MARKERS = (\"sorry\", \"Try this\", \"unsolved goals\", \"found a partial proof\",\n46:                       \"error:\", \"declaration uses\")\n47: \n48: \n49: def _proof_certified(returncode: int, lean_output: str) -> bool:\n50:     \"\"\"True only for a genuinely kernel-checked proof: clean (zero) exit AND no\n51:     marker of an incomplete/uncertified proof in Lean's output.\"\"\"\n52:     return returncode == 0 and not any(m in lean_output for m in _BAD_PROOF_MARKERS)\n53: \n54: \n55: # ---------------------------------------------------------------------------\n56: # Prover response schema\n57: # ---------------------------------------------------------------------------\n58: \n59: @dataclass\n60: class ProverResponse:\n61:     \"\"\"\n62:     Expected response from a neural theorem prover API.\n63: \n64:     Fields match what Goedel-Prover-SB / DeepSeek-Prover-V2 would return\n65:     (schema inferred from published papers; adapt when APIs go public).\n66:     \"\"\"\n67: \n68:     success: bool = False\n69:     proof_text: Optional[str] = None       # complete Lean 4 proof term\n70:     proof_tactics: Optional[str] = None    # tactic proof (if available)\n71:     model_name: str = \"\"\n72:     tokens_used: int = 0\n73:     elapsed_s: float = 0.0\n74:     error: Optional[str] = None\n75: \n76:     # Internal routing\n77:     _stub: bool = False\n78: \n79:     def to_dict(self) -> dict:\n80:         return {\n81:             \"success\": self.success,\n82:             \"proof_text\": self.proof_text,\n83:             \"proof_tactics\": self.proof_tactics,\n84:             \"model_name\": self.model_name,\n85:             \"tokens_used\": self.tokens_used,\n86:             \"elapsed_s\": self.elapsed_s,\n87:             \"error\": self.error,\n88:             \"stub\": self._stub,\n89:         }\n90: \n91: \n92: # ---------------------------------------------------------------------------\n93: # Base class\n94: # ---------------------------------------------------------------------------\n95: \n96: class BaseProver:\n97:     \"\"\"Abstract interface; concrete provers inherit and override `prove_one`.\"\"\"\n98: \n99:     name: str = \"base\"\n100: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
