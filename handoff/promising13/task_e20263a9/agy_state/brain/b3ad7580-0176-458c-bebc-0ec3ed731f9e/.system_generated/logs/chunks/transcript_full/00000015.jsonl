ons.py\\n12: \\\"\\\"\\\"\\n13: from __future__ import annotations\\n14: \\n15: import glob\\n16: import os\\n17: import sys\\n18: \\n19: import pandas as pd\\n20: \\n21: sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))\\n22: \\n23: from pipeline import known_relations as kr  # noqa: E402\\n24: \\n25: # novelty symbol -> battery column (classical short names differ from columns)\\n26: SYM2COL = {\\n27:     \\\"n\\\": \\\"order\\\", \\\"m\\\": \\\"size\\\", \\\"Delta\\\": \\\"maximum_degree\\\", \\\"delta\\\": \\\"minimum_degree\\\",\\n28:     \\\"avg_deg\\\": \\\"average_degree\\\", \\\"omega\\\": \\\"clique_number\\\",\\n29:     \\\"alpha\\\": \\\"independence_number\\\", \\\"chi\\\": \\\"chromatic_number\\\",\\n30:     \\\"gamma\\\": \\\"domination_number\\\", \\\"ind_dom\\\": \\\"independent_domination_number\\\",\\n31:     \\\"vertex_cover\\\": \\\"vertex_cover_number\\\", \\\"nu\\\": \\\"matching_number\\\",\\n32:     \\\"diam\\\": \\\"diameter\\\", \\\"rad\\\": \\\"radius\\\", \\\"min_edge_cover\\\": \\\"edge_cover_number\\\",\\n33: }\\n34: \\n35: TOL = 1e-6\\n36: \\n37: \\n38: def _load_battery() -> pd.DataFrame:\\n39:     paths = sorted(set(glob.glo\\n<truncated 263 bytes>\\n4:         df = df[df[\\\"connected\\\"] == True]  # noqa: E712\\n45:     if \\\"nontrivial\\\" in df:\\n46:         df = df[df[\\\"nontrivial\\\"] == True]  # noqa: E712\\n47:     # derive the order-threshold predicates (older parquets predate them)\\n48:     if \\\"order\\\" in df.columns:\\n49:         o = pd.to_numeric(df[\\\"order\\\"], errors=\\\"coerce\\\")\\n50:         df[\\\"order_bigger_than_2\\\"] = (o > 2).fillna(False)\\n51:         df[\\\"order_bigger_than_3\\\"] = (o > 3).fillna(False)\\n52:     return df\\n53: \\n54: \\n55: def main() -> int:\\n56:     df = _load_battery()\\n57:     print(f\\\"battery (connected, non-trivial): {len(df)} graphs\\\")\\n58: \\n59:     def col(sym):\\n60:         c = SYM2COL.get(sym, sym)\\n61:         return c if c in df.columns else None\\n62: \\n63:     ok = untestable = 0\\n64:     false_rels = []\\n65:     for lhs, rhs, off, cls, name in kr.load_relations():\\n66:         needed = [lhs] + list(rhs)\\n67:         if any(col(x) is None for x in needed):\\n68:             untestable += 1\\n69:             continue\\n70:         sub = df if cls is None else (df[df[cls] == True] if cls in df.columns else None)  # noqa: E712\\n71:         if sub is None or len(sub) == 0:\\n72:             untestable += 1\\n73:             continue\\n74:         viol = sub[col(lhs)].astype(float) - off\\n75:         for k, c in rhs.items():\\n76:             viol = viol - c * sub[col(k)].astype(float)\\n77:         nbad = int((viol > TOL).sum())\\n78:         if nbad:\\n79:             false_rels.append((name, nbad, len(sub), float(viol.max())))\\n80:         else:\\n81:             ok += 1\\n82: \\n83:     print(f\\\"verified (no counterexample): {ok}\\\")\\n84:     print(f\\\"untestable (missing column) : {untestable}\\\")\\n85:     print(f\\\"FALSE (counterexamples)     : {len(false_rels)}\\\")\\n86:     for name, nbad, ntot, worst in sorted(false_rels, key=lambda x: -x[1]):\\n87:         print(f\\\"  [{nbad}/{ntot}, worst +{worst:g}]  {name}\\\")\\n88:     return 1 if false_rels else 0\\n89: \\n90: \\n91: if __name__ == \\\"__main__\\\":\\n92:     raise SystemExit(main())\\n93: \\nThe above content shows the entire, complete file contents of the requested file.\\n\",\"truncated_fields\":[\"content\"]}\n19: {\"step_index\":48,\"source\":\"MODEL\",\"type\":\"PLANNER_RESPONSE\",\"status\":\"DONE\",\"created_at\":\"2026-09-11T18:31:05Z\",\"tool_calls\":[{\"name\":\"view_file\",\"args\":{\"AbsolutePath\":\"\\\"/mnt/home/japake298/project/GraphConjecturing/pipeline/known_relations.py\\\"\",\"EndLine\":\"100\",\"StartLine\":\"1\",\"toolAction\":\"\\\"Viewing pipeline/known_relations.py\\\"\",\"toolSummary\":\"\\\"View known relations file\\\"\"}}]}\n20: {\"step_index\":49,\"source\":\"MODEL\",\"type\":\"GENERIC\",\"status\":\"DONE\",\"created_at\":\"2026-09-11T18:31:12Z\",\"content\":\"Created At: 2026-09-11T20:31:12+02:00\\nCompleted At: 2026-09-11T20:31:13+02:00\\nFile Path: `file:///mnt/home/japake298/project/GraphConjecturing/pipeline/known_relations.py`\\nTotal Lines: 510\\nTotal Bytes: 23725\\nShowing lines 1 to 100\\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\\n1: \\\"\\\"\\\"\\n2: pipeline/known_relations.py — curated known relations for the novelty filter.\\n3: \\n4: The base table in :mod:`pipeline.novelty` speaks a small symbolic vocabulary\\n5: (``alpha``, ``gamma``, ``omega``, …) and covers the classical chains\\n6: (Whitney, König–Egerváry, Gallai, …). This module *extends* it with a large,\\n7: domain-curated list of known graph-invariant relations over the **domination**\\n8: and **zero-forcing** families (``total_domination_number``,\\n9: ``zero_forcing_number``, ``annihilation_number``, ``slater``, …) that the base\\n10: table does not name — the relations a graph theorist already considers folklore\\n11: or published, so that a CEGIS survivor restating one of them is flagged\\n12: *known* rather than *novel*.\\n13: \\n14: The relations are kept here as **human-readable strings** (exactly the form a\\n15: domain expert writes them), and parsed at import time into the\\n16: ``(lhs, {rhs: coeff}, offset, class, name)`` tuples that\\n17: ``pipeline.novelty.KNOWN_THEOREMS`` consumes. Parsing is deliberately\\n18: conservative: anything that does not parse cleanly to a linear relation over the\\n19: known vocabulary (nonlinear ``ceil`` forms, multi-class hypotheses, unsupported\\n20: \\\"not K_n\\\" / degree-bounded hypotheses, malformed fragments) is **skipped** and\\n21: left *novel* — the safe direction, since wrongly hiding a real conjecture is the\\n22: only error that matters here.\\n23: \\\"\\\"\\\"\\n24: from __future__ import annotations\\n25: \\n26: import logging\\n27: import re\\n28: from collections import defaultdict\\n29: from typing import Dict, L\\n<truncated 1721 bytes>\\nn_number\\\",\\n63:     \\\"edge_domination_number\\\",\\n64:     # independence / matching / cover extras\\n65:     \\\"annihilation_number\\\", \\\"residue\\\", \\\"square_residue\\\",\\n66:     \\\"slater\\\", \\\"LG_slater\\\", \\\"min_maximal_matching_number\\\", \\\"min_edge_cover\\\",\\n67:     # zero-forcing family\\n68:     \\\"zero_forcing_number\\\", \\\"total_zero_forcing_number\\\",\\n69:     \\\"connected_zero_forcing_number\\\", \\\"positive_semidefinite_zero_forcing_number\\\",\\n70:     # distance / misc\\n71:     \\\"triameter\\\",\\n72:     \\\"power_min_degree_residue_sum\\\", \\\"power_min_degree_annihilation_sum\\\",\\n73:     \\\"power_2_annihilation_sum\\\", \\\"power_3_annihilation_sum\\\",\\n74: ]\\n75: for _t in _NEW_INVARIANTS:\\n76:     TOKEN2SYM.setdefault(_t, _t)\\n77: \\n78: # Tokens, longest first, so e.g. ``total_domination_number`` is preferred over a\\n79: # spurious ``domination_number`` substring (underscores already block most of\\n80: # these, but length ordering is a cheap belt-and-braces).\\n81: INV_TOKENS = sorted(TOKEN2SYM, key=len, reverse=True)\\n82: \\n83: # graphcalc column -> symbol, for extending pipeline.cegis_novelty._GC2TABLE so\\n84: # that *generated* conjectures over these invariants parse into Inequalities.\\n85: GC_COLUMNS: Dict[str, str] = {t: TOKEN2SYM[t] for t in _NEW_INVARIANTS}\\n86: \\n87: # Graph-class words we model; anything else in a hypothesis -> skip the relation.\\n88: _CLASS_WORDS = {\\n89:     \\\"well-covered\\\": \\\"well_covered\\\",\\n90:     \\\"bipartite\\\": \\\"bipartite\\\",\\n91:     \\\"claw-free\\\": \\\"claw_free\\\",\\n92:     \\\"tree\\\": \\\"tree\\\",\\n93:     \\\"triangle-free\\\": \\\"triangle_free\\\",\\n94:     \\\"cubic\\\": \\