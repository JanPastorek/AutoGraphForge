omanDominationNumber {V : Type} [Fintype V] [DecidableEq V]\n37:     (G : SimpleGraph V) [DecidableRel G.Adj] (k : ℕ)\n38:     (h : ∀ f : V → Fin 3, GraphCalc.IsRomanDominatingFunction G f → k ≤ GraphCalc.romanWeight f) :\n39:     k ≤ GraphCalc.romanDominationNumber G := by\n40:   unfold GraphCalc.romanDominationNumber\n41:   have h_ex : ∃ f : V → Fin 3, GraphCalc.IsRomanDominatingFunction G f := by\n42:     use (fun _ => 2)\n43:     intro v hv\n44:     dsimp at hv\n45:     have h_false : False := by\n46:       revert hv\n47:       decide\n48:     contradiction\n49:   rcases h_ex with ⟨f₀, hf₀⟩\n50:   have h_mem : GraphCalc.romanWeight f₀ ∈ (Finset.univ.filter (GraphCalc.IsRomanDominatingFunction G)).image GraphCalc.romanWeight := by\n51:     rw [Finset.mem_image]\n52:     exact ⟨f₀, Finset.mem_filter.mpr ⟨Finset.mem_univ f₀, hf₀⟩, rfl⟩\n53:   have h_nonempty : ((Finset.univ.filter (GraphCalc.IsRomanDominatingFunction G)).image GraphCalc.romanWeight).Nonempty :=\n54:     ⟨GraphCalc.romanWeight f₀, h_mem⟩\n55:   obtain ⟨m, hm⟩ := Finset.min_of_nonempty h_nonempty\n56:   rw [hm]\n57:   dsimp\n58:   have hm_in := Finset.mem_of_min hm\n59:   rw [Finset.mem_image] at hm_in\n60:   rcases hm_in with ⟨f_min, hf_min, rfl⟩\n61:   rw [Finset.mem_filter] at hf_min\n62:   exact h f_min hf_min.2\n63: \n64: \nThe above content shows the entire, complete file contents of the requested file.\n"}
