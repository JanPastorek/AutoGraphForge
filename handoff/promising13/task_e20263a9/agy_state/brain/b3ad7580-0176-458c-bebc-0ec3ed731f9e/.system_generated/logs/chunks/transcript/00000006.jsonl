{"step_index":818,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-11T18:35:48Z","content":"Created At: 2026-09-11T20:35:48+02:00\nCompleted At: 2026-09-11T20:35:48+02:00\nFile Path: `file:///mnt/home/japake298/project/GraphConjecturing/lean_project/LeanProject/GraphInvariantsComputable.lean`\nTotal Lines: 537\nTotal Bytes: 27292\nShowing lines 440 to 490\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n440: def HasEdgeCover (G : SimpleGraph V) [DecidableRel G.Adj] : Prop :=\n441:   ∀ v : V, ∃ u : V, G.Adj v u\n442: \n443: instance (G : SimpleGraph V) [DecidableRel G.Adj] :\n444:     Decidable (HasEdgeCover G) := by unfold HasEdgeCover; infer_instance\n445: \n446: /- ── Roman domination ─────────────────────────────────────────────────────── -/\n447: \n448: /-- `f : V → {0,1,2}` is a Roman dominating function when every vertex labelled\n449: `0` has a neighbour labelled `2`.\n450: \n451: graphcalc solves this as a MIP over binaries `x, y` with `f = x + 2y`,\n452: constraint `x v + y v + Σ_{u ∈ N(v)} y u ≥ 1` and exclusion `x v + y v ≤ 1`;\n453: that is exactly the condition below. -/\n454: def IsRomanDominatingFunction (G : SimpleGraph V) [DecidableRel G.Adj]\n455:     (f : V → Fin 3) : Prop := ∀ v : V, f v = 0 → ∃ u : V, G.Adj v u ∧ f u = 2\n456: \n457: instance (G : SimpleGraph V) [DecidableRel G.Adj] (f : V → Fin 3) :\n458:     Decidable (IsRomanDominatingFunction G f) := by\n459:   unfold IsRomanDominatingFunction; infer_instance\n460: \n461: def romanWeight (f : V → Fin 3) : ℕ := ∑ v : V, (f v : ℕ)\n462: \n463: /-- Total, not partial: the constant function `2` is always Roman dominating\n464: (no vertex is labelled `0`), so a witness always exists. -/\n465: def romanDominationNumber (G : SimpleGraph V) [DecidableRel G.Adj] : ℕ :=\n466:   (((univ.filter (IsRomanDominatingFunction G)).image romanWeight).min).getD 0\n467: \n468: /- ── double Roman domination ──────────────────────────────────────────────── -/\n469: \n470: /-- `f : V → {0,1,2,3}` is double Roman dominating when a vertex labelled `0`\n471: has either a neighbour labelled `3` or two neighbours labelled `2`, and a vertex\n472: labelled `1` has a neighbour labelled `≥ 2`.\n473: \n474: The first clause is written as graphcalc's linearisation\n475: `0.5·|N₂(v)| + |N₃(v)| ≥ 1`, but as two existentials rather than as\n476: `Finset.card` of a filter: \"at least two neighbours labelled 2\" is \"two distinct\n477: neighbours labelled 2\", and the kernel reduces a pair of quantifiers over `V`\n478: far more cheaply than it builds and counts a `Finset`. Written the counting way\n479: first, all seven order-5 checks exhausted their heartbeat budget. -/\n480: def IsDoubleRomanDominatingFunction (G : SimpleGraph V) [DecidableRel G.Adj]\n481:     (f : V → Fin 4) : Prop :=\n482:   (∀ v : V, f v = 0 →\n483:       (∃ u : V, G.Adj v u ∧ f u = 3) ∨\n484:       (∃ u : V, ∃ w : V, u ≠ w ∧ G.Adj v u ∧ G.Adj v w ∧ f u = 2 ∧ f w = 2)) ∧\n485:   (∀ v : V, f v = 1 → ∃ u : V, G.Adj v u ∧ 2 ≤ (f u : ℕ))\n486: \n487: instance (G : SimpleGraph V) [DecidableRel G.Adj] (f : V → Fin 4) :\n488:     Decidable (IsDoubleRomanDominatingFunction G f) := by\n489:   unfold IsDoubleRomanDominatingFunction; infer_instance\n490: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
