{"step_index":144,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-11T18:34:18Z","content":"Created At: 2026-09-11T20:34:18+02:00\nCompleted At: 2026-09-11T20:34:18+02:00\nFile Path: `file:///mnt/home/japake298/project/GraphConjecturing/tools/prove_curated.py`\nTotal Lines: 50\nTotal Bytes: 1918\nShowing lines 1 to 50\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: #!/usr/bin/env python3\n2: \"\"\"\n3: tools/prove_curated.py — validate the full chain (preamble + export header +\n4: local DeepSeek-Prover-V2 + kernel verify) on a few universally-true theorems over\n5: mathlib-native invariants, exactly as the pipeline would export them.\n6: \"\"\"\n7: from __future__ import annotations\n8: import logging, sys\n9: logging.basicConfig(level=logging.INFO, format=\"%(asctime)s | %(message)s\", datefmt=\"%H:%M:%S\")\n10: log = logging.getLogger(\"prove_curated\")\n11: \n12: from config import CONFIG\n13: from conjecture import Conjecture\n14: from pipeline.lean_export import _PREAMBLE, _HEADER_BINDERS\n15: \n16: def thm(name: str, body: str) -> str:\n17:     return (f\"{_PREAMBLE}\\ntheorem {name} {_HEADER_BINDERS}\\n  : {body} :=\\nsorry\")\n18: \n19: CASES = [\n20:     (\"delta_le_Delta\", \"δ ≤ Δ  (minimum_degree ≤ maximum_degree)\",\n21:      \"(G.minDegree : ℝ) ≤ (G.maxDegree : ℝ)\"),\n22:     (\"omega_le_order\", \"ω ≤ n  (clique_number ≤ order)\",\n23:      \"(G.cliqueNum : ℝ) ≤ (G.order : ℝ)\"),\n24:     (\"alpha_le_order\", \"α ≤ n  (independence_number ≤ order)\",\n25:      \"(G.indepNum : ℝ) ≤ (G.order : ℝ)\"),\n26: ]\n27: \n28: def main():\n29:     from pipeline.theorem_prover import NeuralProverClient\n30:     prover = NeuralProverClient(CONFIG)\n31:     proved = []\n32:     for name, informal, body in CASES:\n33:         c = Conjecture(statement=informal, inequality=None,\n34:                        generation_method=\"curated\", lean_statement=thm(name, body))\n35:         log.info(\"[prove] %s\", informal)\n36:         r = prover.prove(c)\n37:         if r.success:\n38:             proved.append((informal, r))\n39:             log.info(\"[prove] ✓ KERNEL-VERIFIED by %s (%.1fs)\", r.model_name, r.elapsed_s or 0)\n40:         else:\n41:             log.info(\"[prove] ✗ %s\", r.error)\n42:     print(\"\\n\" + \"=\" * 70)\n43:     print(\"KERNEL-VERIFIED: %d / %d\" % (len(proved), len(CASES)))\n44:     for informal, r in proved:\n45:         print(\"-\" * 70); print(informal); print(r.proof_tactics)\n46:     return 0\n47: \n48: if __name__ == \"__main__\":\n49:     sys.exit(main())\n50: \nThe above content shows the entire, complete file contents of the requested file.\n"}
