least two: the first and third nodes are different and not connected. -/\n379: lemma Walk.exists_adj_adj_not_adj_ne {p : G.Walk v w} (hp : p.length = G.dist v w)\n380:     (hl : 1 < G.dist v w) : ∃ (x a b : V), G.Adj x a ∧ G.Adj a b ∧ ¬ G.Adj x b ∧ x ≠ b := by\n381:   use v, p.getVert 1, p.getVert 2\n382:   have hnp : ¬p.Nil := by grind [Nil.length_eq_zero]\n383:   have : p.tail.tail.length < p.tail.length := by\n384:     rw [← p.tail.length_tail_add_one (by\n385:       simp only [not_nil_iff_lt_length, ← p.length_tail_add_one hnp] at hp ⊢\n386:       lia)]\n387:     lia\n388:   have : p.tail.length < p.length := by rw [← p.length_tail_add_one hnp]; lia\n389:   by_cases hv : v = p.getVert 2\n390:   · have : G.dist v w ≤ p.tail.tail.length := by\n391:       simpa [hv, p.getVert_tail] using dist_le p.tail.tail\n392:     lia\n393:   by_cases hadj : G.Adj v (p.getVert 2)\n394:   · have : G.dist v w ≤ p.tail.tail.length + 1 :=\n395:       dist_le <| p.tail.tail.cons <| p.getVert_tail ▸ hadj\n396:     lia\n397:   exact ⟨p.adj_snd hnp, p.adj_getVert_succ (hp ▸ hl), hadj, hv⟩\n398: \n399: end dist\n400: \n401: /-! ## Ball -/\n402: \n403: section ball\n404: \n405: /-- The open ball of radius `r` centered at the vertex `c` in the graph extended metric. -/\n406: def ball (c : V) (r : ℕ∞) : Set V :=\n407:   {v | G.edist v c < r}\n408: \n409: variable {G} {c v : V} {r r₁ r₂ : ℕ∞}\n410: \n411: @[simp]\n412: theorem mem_ball : v ∈ G.ball c r ↔ G.edist v c < r := .rfl\n413: \n414: /-- The ball of radius zero is empty. -/\n415: @[simp]\n416: theorem ball_zero : G.ball c 0 = ∅ := by simp [ball]\n417: \n418: /-- The ball of radius one consists of just the center. -/\n419: @[simp]\n420: theorem ball_one : G.ball c 1 = {c} := by\n421:   simp [ball]\n422: \n423: /-- The ball of radius two consists of the center and its neighbors. -/\n424: @[simp]\n425: theorem ball_two : G.ball c 2 = insert c (G.neighborSet c) := by\n426:   ext v\n427:   simp [one_add_one_eq_two.symm, ENat.lt_add_one_iff