{"step_index":348,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-11T18:48:31Z","content":"Created At: 2026-09-11T20:48:31+02:00\nCompleted At: 2026-09-11T20:48:31+02:00\nFile Path: `file:///mnt/home/japake298/project/GraphConjecturing/handoff/promising13/task_e20263a9/scratch.lean`\nTotal Lines: 343\nTotal Bytes: 13405\nShowing lines 1 to 60\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: import Mathlib\n2: import LeanProject.GraphInvariantsComputable\n3: \n4: open SimpleGraph\n5: open GraphCalc\n6: \n7: lemma minUpTo_le {n : ℕ} {p : ℕ → Prop} [DecidablePred p] (k : ℕ) (hk : k ≤ n) (hp : p k) :\n8:     minUpTo n p ≤ k := by\n9:   unfold minUpTo\n10:   have hmem : k ∈ (Finset.range (n + 1)).filter p := by\n11:     rw [Finset.mem_filter, Finset.mem_range]\n12:     exact ⟨Nat.lt_succ_of_le hk, hp⟩\n13:   have hmin := Finset.min_le hmem\n14:   generalize hmin_eq : ((Finset.range (n + 1)).filter p).min = m\n15:   rw [hmin_eq] at hmin\n16:   cases m with\n17:   | top => contradiction\n18:   | coe val =>\n19:     simp only [WithTop.coe_le_coe] at hmin\n20:     exact hmin\n21: \n22: theorem radius_le_eccentricity {V : Type} [Fintype V] [DecidableEq V]\n23:     (G : SimpleGraph V) [DecidableRel G.Adj] (v : V) :\n24:     GraphCalc.radius G ≤ GraphCalc.eccentricity G v := by\n25:   unfold GraphCalc.radius\n26:   have hmem : GraphCalc.eccentricity G v ∈ Finset.image (GraphCalc.eccentricity G) Finset.univ := by\n27:     apply Finset.mem_image_of_mem\n28:     exact Finset.mem_univ v\n29:   obtain ⟨b, hb⟩ := Finset.min_of_mem hmem\n30:   rw [hb]\n31:   have hle : (Finset.image (GraphCalc.eccentricity G) Finset.univ).min ≤ ↑(GraphCalc.eccentricity G v) :=\n32:     Finset.min_le hmem\n33:   rw [hb] at hle\n34:   exact WithTop.coe_le_coe.mp hle\n35: \n36: lemma le_romanDominationNumber {V : Type} [Fintype V] [DecidableEq V]\n37:     (G : SimpleGraph V) [DecidableRel G.Adj] (k : ℕ)\n38:     (h : ∀ f : V → Fin 3, GraphCalc.IsRomanDominatingFunction G f → k ≤ GraphCalc.romanWeight f) :\n39:     k ≤ GraphCalc.romanDominationNumber G := by\n40:   unfold GraphCalc.romanDominationNumber\n41:   have h_ex : ∃ f : V → Fin 3, GraphCalc.IsRomanDominatingFunction G f := by\n42:     use (fun _ => 2)\n43:     intro v hv\n44:     dsimp at hv\n45:     have h_false : False := by\n46:       revert hv\n47:       decide\n48:     contradiction\n49:   rcases h_ex with ⟨f₀, hf₀⟩\n50:   have h_mem : GraphCalc.romanWeight f₀ ∈ (Finset.univ.filter (GraphCalc.IsRomanDominatingFunction G)).image GraphCalc.romanWeight := by\n51:     rw [Finset.mem_image]\n52:     exact ⟨f₀, Finset.mem_filter.mpr ⟨Finset.mem_univ f₀, hf₀⟩, rfl⟩\n53:   have h_nonempty : ((Finset.univ.filter (GraphCalc.IsRomanDominatingFunction G)).image GraphCalc.romanWeight).Nonempty :=\n54:     ⟨GraphCalc.romanWeight f₀, h_mem⟩\n55:   obtain ⟨m, hm⟩ := Finset.min_of_nonempty h_nonempty\n56:   rw [hm]\n57:   dsimp\n58:   have hm_in := Finset.mem_of_min hm\n59:   rw [Finset.mem_image] at hm_in\n60:   rcases hm_in with ⟨f_min, hf_min, rfl⟩\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
