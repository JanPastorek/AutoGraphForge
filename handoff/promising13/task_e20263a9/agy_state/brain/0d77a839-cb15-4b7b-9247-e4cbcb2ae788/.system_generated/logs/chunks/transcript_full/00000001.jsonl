{"step_index":63,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-11T18:31:46Z","content":"Created At: 2026-09-11T20:31:46+02:00\nCompleted At: 2026-09-11T20:31:46+02:00\nFile Path: `file:///mnt/home/japake298/project/GraphConjecturing/tools/prove_new.py`\nTotal Lines: 91\nTotal Bytes: 3611\nShowing lines 1 to 91\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: #!/usr/bin/env python3\n2: \"\"\"\n3: tools/prove_new.py — try to kernel-verify the unconditioned survivors that use the\n4: newly-formalized invariants (zero-forcing family / Slater / annihilation).\n5: \n6: Cross-references the latest cegis_results.json so only actual survivors are tried.\n7: \"\"\"\n8: from __future__ import annotations\n9: import glob, json, logging, os, sys\n10: import dill, pandas as pd\n11: \n12: logging.basicConfig(level=logging.INFO, format=\"%(asctime)s | %(message)s\", datefmt=\"%H:%M:%S\")\n13: log = logging.getLogger(\"prove_new\")\n14: \n15: from config import CONFIG\n16: from pipeline import invariants_graphcalc as battery\n17: from txgraffiti.graffiti3.graffiti3 import Graffiti3\n18: from pipeline.lean_export import make_lean_label, is_supported, SUPPORTED\n19: from pipeline.refute_matrix import Refuter\n20: from pipeline.reporting import sort_conjectures\n21: import run_cegis\n22: \n23: NEW = {\"slater\", \"annihilation_number\", \"zero_forcing_number\",\n24:        \"total_zero_forcing_number\", \"connected_zero_forcing_number\"}\n25: \n26: \n27: def main(argv=None):\n28:     k = int((argv or sys.argv[1:] or [\"6\"])[0])\n29:     frame = battery._coerce(pd.read_parquet(\"database/cache/seed_battery.parquet\"))\n30:     cols = list(frame.columns)\n31:     g3 = Graffiti3(frame, lean_label=make_lean_label(cols))\n32:     cache = sorted(glob.glob(\"database/cache/gen_*.dill\"), key=os.path.getmtime)[-1]\n33:     ineqs, _ = dill.load(open(cache, \"rb\"))\n34:     log.info(\"loaded %d candidates from %s\", len(ineqs), os.path.basename(cache))\n35: \n36:     survivors = set()\n37:     if os.path.exists(\"results/cegis_results.json\"):\n38:         d = json.load(open(\"results/cegis_results.json\"))\n39:         survivors = {c[\"statement\"] for c in d.get(\"conjectures\", [])}\n40:         log.info(\"cross-referencing %d survivor statements\", len(survivors))\n41: \n42:     picked, seen = [], set()\n43:     for c in ineqs:\n44:         try:\n45:             if getattr(c, \"condition\", None) is None and hasattr(c, \"_auto_base\"):\n46:                 c.condition = c._auto_base(frame)        # don't clobber generation conditions\n47:         except Exception:\n48:             pass\n49:         try:\n50:             p = c.pretty()\n51:         except Exception:\n52:             continue\n53:         used = [col for col in cols if col in p]\n54:         is_new_or_conditioned = any(u in NEW for u in used) or \"⇒\" in p\n55:         if (p not in seen and is_supported(c, cols) and is_new_or_conditioned\n56:                 and (not survivors or p in survivors)):\n57:             seen.add(p); picked.append(c)\n58: \n59:     r = Refuter.__new__(Refuter)\n60:     class _R: pass\n61:     res = _R(); res.survivors = picked; res.g3 = g3; res.fixed_point = True; res.rounds_run = 1\n62:     class _S: pass\n63:     res.seed = _S(); res.seed.frame = frame\n64:     res.touches = [r.touch_count(c, frame) for c in picked]\n65:     conjs = [c for c in run_cegis.wrap_survivors(res) if c.lean_statement]\n66:     conjs = sort_conjectures(conjs, by=\"complexity\")[:k]\n67:     log.info(\"proving %d unconditioned new-invariant survivors:\", len(conjs))\n68:     for c in conjs:\n69:         log.info(\"   • %s\", c.statement)\n70: \n71:     from pipeline.theorem_prover import NeuralProverClient\n72:     prover = NeuralProverClient(CONFIG)\n73:     proved = []\n74:     for c in conjs:\n75:         log.info(\"[prove] %s\", c.statement)\n76:         rr = prover.prove(c)\n77:         if rr.success:\n78:             proved.append((c, rr))\n79:             log.info(\"[prove] ✓ KERNEL-VERIFIED by %s (%.1fs)\", rr.model_name, rr.elapsed_s or 0)\n80:         else:\n81:             log.info(\"[prove] ✗ %s\", rr.error)\n82:     print(\"\\n\" + \"=\" * 70)\n83:     print(\"KERNEL-VERIFIED NEW-INVARIANT THEOREMS: %d / %d\" % (len(proved), len(conjs)))\n84:     for c, rr in proved:\n85:         print(\"-\" * 70); print(c.statement); print(rr.proof_tactics)\n86:     return 0\n87: \n88: \n89: if __name__ == \"__main__\":\n90:     sys.exit(main())\n91: \nThe above content shows the entire, complete file contents of the requested file.\n"}
