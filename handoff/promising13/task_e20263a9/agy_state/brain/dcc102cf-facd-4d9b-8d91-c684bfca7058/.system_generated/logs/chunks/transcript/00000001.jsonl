rtices must have diameter >= 4.\\n# Let's search all trees of order 8 (already tested), and graphs obtained by adding edges to trees of order 8.\\nprint('Testing order 8...')\\nfound = False\\nfor T in nx.nonisomorphic_trees(8):\\n    # try all subsets of edges\\n    non_edges = list(nx.non_edges(T))\\n    for r in range(1, len(non_edges) + 1):\\n        # sample some or all\\n        pass\\n\\\"\"","Cwd":"\"/mnt/home/japake298/project/GraphConjecturing/handoff/promising13/task_e20263a9\"","WaitMsBeforeAsync":"5000","toolAction":"\"Test order 8\"","toolSummary":"\"Order 8 test script\""}}]}
