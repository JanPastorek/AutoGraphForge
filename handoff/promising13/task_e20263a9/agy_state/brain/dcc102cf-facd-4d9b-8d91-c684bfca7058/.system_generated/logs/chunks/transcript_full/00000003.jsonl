.cfg = cfg\n531:         if name:\n532:             self.name = name\n533:         self._endpoint_path = endpoint_path\n534:         self._lean = LeanSubprocessProver(cfg)\n535: \n536:     def prove(self, conjecture: Conjecture) -> ProverResponse:\n537:         if conjecture.lean_statement is None:\n538:             return ProverResponse(success=False, error=\"No statement\", model_name=self.name)\n539:         if not self.cfg.prover_api_url:\n540:             return ProverResponse(success=False, _stub=True, model_name=self.name,\n541:                                   error=f\"{self.name}: prover_api_url not configured\")\n542:         try:\n543:             import requests\n544:         except ImportError:\n545:             return ProverResponse(success=False, model_name=self.name,\n546:                                   error=f\"{self.name}: `requests` not installed\")\n547:         t0 = time.time()\n548:         url = self.cfg.prover_api_url.rstrip(\"/\") + self._endpoint_path\n549:         payload = {\n550:             \"statement\": conjecture.lean_statement,\n551:             \"informal_statement\": conjecture.statement,\n552:             \"context\": \"import Mathlib\",\n553:             \"strategy\": \"subgoal_decomposition\",\n554:             \"timeout_s\": self.cfg.prover_timeout_s,\n555:         }\n556:         headers = {}\n557:         if self.cfg.prover_api_key:\n558:             headers[\"Authorization\"] = f\"Bearer {self.cfg.prover_api_key}\"\n559:         try:\n560:             resp = requests.post(url, json=payload, headers=headers,\n561:                                  timeout=self.cfg.prover_timeout_s + 30)\n562:             resp.raise_for_status()\n563:             data = resp.json()\n564:         except Exception as e:                                # network / server\n565:             return ProverResponse(success=False, model_name=self.name,\n566:                                   elapsed_s=time.time() - t0,\n567:                                   error=f\"{self.name}: endpoint call failed: {e}\")\n568:         proof = next((data[k] for k in self._PROOF_KEYS if data.get(k)), None)\n569:         elapsed = time.time() - t0\n570:         if not proof:\n571:             return ProverResponse(success=False, model_name=self.name, elapsed_s=elapsed,\n572:                                   error=f\"{self.name}: no proof returned \"\n573:                                         f\"({data.get('error', 'empty response')})\")\n574:         # The remote model's own success flag is advisory ONLY — we never trust a\n575:         # proof we did not kernel-check ourselves against our pinned mathlib. The\n576:         # preamble import MUST be included (machine-generated goals are stated over\n577:         # the custom GraphInvariants definitions); without it a valid proof fails\n578:         # this re-check with \"unknown identifier\" even though the shim verified it.\n579:         code = proof if proof.lstrip().startswith(\"import\") \\\n580:             else \"import Mathlib\\n\" + self.cfg.lean_preamble_import + \"\\n\\n\" + proof\n581:         if self._lean._available:\n582:             ok, log = self._lean._run_lean(code)\n583:             return ProverResponse(\n584:                 success=ok,\n585:                 proof_tactics=proof if ok else None,\n586:                 proof_text=proof,\n587:                 model_name=data.get(\"model\", self.name),\n588:                 tokens_used=int(data.get(\"num_tokens\", 0) or 0),\n589:                 elapsed_s=elapsed,\n590:                 error=None if ok else f\"failed Lean kernel check: {log[:200]}\",\n591:             )\n592:         return ProverResponse(\n593:             success=False, proof_text=proof, model_name=data.get(\"model\", self.name),\n594:             elapsed_s=elapsed,\n595:             error=\"unverified: no Lean binary to kernel-check the remote proof\",\n596:         )\n597: \n598: \n599: # ------------------------------------------------