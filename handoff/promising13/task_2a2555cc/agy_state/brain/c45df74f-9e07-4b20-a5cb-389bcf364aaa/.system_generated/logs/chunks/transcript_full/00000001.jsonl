\"timeout_s\": 120,\n134:     }\n135:     _EXPECTED_RESPONSE_SCHEMA = {\n136:         \"success\": bool,\n137:         \"proof\": \"str | null\",\n138:         \"model\": \"str\",\n139:         \"num_tokens\": int,\n140:         \"error\": \"str | null\",\n141:     }\n142: \n143:     def __init__(self, cfg: Config = CONFIG):\n144:         self.cfg = cfg\n145: \n146:     def prove(self, conjecture: Conjecture) -> ProverResponse:\n147:         if conjecture.lean_statement is None:\n148:             return ProverResponse(\n149:                 success=False, error=\"No Lean 4 statement available\", model_name=self.name\n150:             )\n151:         t0 = time.time()\n152:         if not self.cfg.prover_api_url:\n153:             return self._stub_response(conjecture, time.time() - t0)\n154: \n155:         # TODO: replace with real HTTP call when API is available\n156:         return self._call_prover_api(conjecture, time.time() - t0)\n157: \n158:     def _call_prover_api(self, conjecture: Conjecture, elapsed: float) -> ProverResponse:\n159:         \"\"\"\n160:         Real API call skeleton.  Uncomment and adapt when endpoint is live.\n161:         \"\"\"\n162:         # import requests\n163:         # payload = {\n164:         #     \"formal_statement\": conjecture.lean_statement,\n165:         #     \"informal_statement\": conjecture.statement,\n166:         #     \"max_attempts\": 8,\n167:         #     \"timeout_s\": self.cfg.prover_timeout_s,\n168:         # }\n169:         # headers = {\"Authorization\": f\"Bearer {self.cfg.prover_api_key}\"}\n170:         # resp = requests.post(\n171:         #     self.cfg.prover_api_url + self._ENDPOINT_PATH,\n172:         #     json=payload, headers=headers,\n173:         #     timeout=self.cfg.prover_timeout_s + 10,\n174:         # )\n175:         # resp.raise_for_status()\n176:         # data = resp.json()\n177:         # return ProverResponse(\n178:         #     success=data[\"success\"],\n179:         #     proof_tactics=data.get(\"proof\"),\n180:         #     model_name=data.get(\"model\", self.name),\n181:         #     tokens_used=data.get(\"num_tokens\", 0),\n182:         #     elapsed_s=elapsed,\n183:         #     error=data.get(\"error\"),\n184:         # )\n185:         return self._stub_response(conjecture, elapsed)\n186: \n187:     def _stub_response(self, conjecture: Conjecture, elapsed: float) -> ProverResponse:\n188:         logger.info(\n189:             \"[GoedelProver] STUB — would call %s for conjecture %s\",\n190:             self.cfg.prover_api_url or \"<no URL configured>\",\n191:             conjecture.id,\n192:         )\n193:         return ProverResponse(\n194:             success=False,\n195:             error=\"Goedel-Prover API not configured (stub mode)\",\n196:             model_name=self.name,\n197:             elapsed_s=elapsed,\n198:             _stub=True,\n199:         )\n200: \n201: \n202: # ---------------------------------------------------------------------------\n203: # DeepSeek-Prover-V2 stub\n204: # ---------------------------------------------------------------------------\n205: \n206: class DeepSeekProverV2(BaseProver):\n207:     \"\"\"\n208:     Stub for DeepSeek-Prover-V2.\n209: \n210:     Reference: Xin et al. \"DeepSeek-Prover-V2: Advancing Formal Mathematical\n211:     Reasoning via Reinforcement Learning for Subgoal Decomposition\" (2024).\n212:     Uses RL-trained subgoal decomposition to construct step-by-step Lean 4 proofs.\n213: \n214:     The prover decomposes the goal into subgoals, solves each independently,\n215:     and assembles a complete proof.  This architecture is particularly effective\n216:     for multi-step graph-theory lemmas.\n217: \n218:     To enable: set cfg.prover_api_url to a DeepSeek-Prover-V2 endpoint.\n219:     \"\"\"\n220: \n221:     name = \"deepseek-prover-v2\"\n222: \n223:     _ENDPOINT_PATH = \"/v1/lean4/prove\"\n224:     _EXPECTED_REQUEST = {\n225:         \"statement\": \"<lean4 theorem string>