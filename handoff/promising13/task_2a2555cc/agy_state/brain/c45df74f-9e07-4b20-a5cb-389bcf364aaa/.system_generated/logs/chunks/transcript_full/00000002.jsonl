{"step_index":133,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-11T18:50:03Z","content":"Created At: 2026-09-11T20:50:03+02:00\nCompleted At: 2026-09-11T20:50:03+02:00\nFile Path: `file:///mnt/home/japake298/project/GraphConjecturing/lean_project/.lake/packages/mathlib/Mathlib/Combinatorics/SimpleGraph/Metric.lean`\nTotal Lines: 455\nTotal Bytes: 17223\nShowing lines 200 to 260\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n200: section dist\n201: \n202: /--\n203: The distance between two vertices is the length of the shortest walk between them.\n204: If no such walk exists, this uses the junk value of `0`.\n205: -/\n206: noncomputable def dist (u v : V) : ℕ :=\n207:   (G.edist u v).toNat\n208: \n209: variable {G} {u v w : V}\n210: \n211: theorem dist_eq_sInf : G.dist u v = sInf (Set.range (Walk.length : G.Walk u v → ℕ)) :=\n212:   ENat.iInf_toNat\n213: \n214: @[grind =]\n215: lemma Reachable.coe_dist_eq_edist (h : G.Reachable u v) : G.dist u v = G.edist u v :=\n216:   ENat.coe_toNat <| edist_ne_top_iff_reachable.mpr h\n217: \n218: protected theorem Reachable.exists_walk_length_eq_dist (hr : G.Reachable u v) :\n219:     ∃ p : G.Walk u v, p.length = G.dist u v :=\n220:   dist_eq_sInf ▸ Nat.sInf_mem (Set.range_nonempty_iff_nonempty.mpr hr)\n221: \n222: protected theorem Connected.exists_walk_length_eq_dist (hconn : G.Connected) (u v : V) :\n223:     ∃ p : G.Walk u v, p.length = G.dist u v :=\n224:   dist_eq_sInf ▸ (hconn u v).exists_walk_length_eq_dist\n225: \n226: theorem dist_le (p : G.Walk u v) : G.dist u v ≤ p.length :=\n227:   dist_eq_sInf ▸ Nat.sInf_le ⟨p, rfl⟩\n228: \n229: @[simp]\n230: theorem dist_eq_zero_iff_eq_or_not_reachable :\n231:     G.dist u v = 0 ↔ u = v ∨ ¬G.Reachable u v := by simp [dist_eq_sInf, Nat.sInf_eq_zero, Reachable]\n232: \n233: @[simp, grind =]\n234: theorem dist_self : dist G v v = 0 := by simp\n235: \n236: protected theorem Reachable.dist_eq_zero_iff (hr : G.Reachable u v) :\n237:     G.dist u v = 0 ↔ u = v := by simp [hr]\n238: \n239: protected theorem Reachable.pos_dist_of_ne (h : G.Reachable u v) (hne : u ≠ v) :\n240:     0 < G.dist u v :=\n241:   Nat.pos_of_ne_zero (by simp [h, hne])\n242: \n243: protected theorem Reachable.one_lt_dist_of_ne_of_not_adj (h : G.Reachable u v) (hne : u ≠ v)\n244:     (hnadj : ¬G.Adj u v) : 1 < G.dist u v :=\n245:   Nat.lt_of_le_of_ne (h.pos_dist_of_ne hne) (by\n246:     by_contra hc\n247:     obtain ⟨p, hp⟩ := Reachable.exists_walk_length_eq_dist h\n248:     exact hnadj (Walk.exists_length_eq_one_iff.mp ⟨p, hc ▸ hp⟩))\n249: \n250: protected theorem Connected.dist_eq_zero_iff (hconn : G.Connected) :\n251:     G.dist u v = 0 ↔ u = v := by simp [hconn u v]\n252: \n253: protected theorem Connected.pos_dist_of_ne (hconn : G.Connected) (hne : u ≠ v) :\n254:     0 < G.dist u v :=\n255:   Nat.pos_of_ne_zero fun h ↦ False.elim <| hne <| (hconn.dist_eq_zero_iff).mp h\n256: \n257: protected theorem Connected.one_lt_dist_of_ne_of_not_adj (h : G.Connected) (hne : u ≠ v)\n258:     (hnadj : ¬G.Adj u v) : 1 < G.dist u v :=\n259:   Reachable.one_lt_dist_of_ne_of_not_adj (h u v) hne hnadj\n260: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
