{"step_index":125,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-11T18:49:28Z","content":"Created At: 2026-09-11T20:49:28+02:00\nCompleted At: 2026-09-11T20:49:28+02:00\nFile Path: `file:///mnt/home/japake298/project/GraphConjecturing/lean_project/.lake/packages/mathlib/Mathlib/Combinatorics/SimpleGraph/Diam.lean`\nTotal Lines: 476\nTotal Bytes: 16993\nShowing lines 330 to 380\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n330: See also `connected_iff_ediam_ne_top` for the extended diameter version. -/\n331: lemma connected_iff_diam_ne_zero [Finite α] [Nontrivial α] : G.Connected ↔ G.diam ≠ 0 := by\n332:   rw [connected_iff_ediam_ne_top, not_iff_not, diam_eq_zero_iff_ediam_eq_top]\n333: \n334: end diam\n335: \n336: section radius\n337: \n338: /-- The radius of a simple graph is the minimum eccentricity of any vertex. -/\n339: noncomputable def radius (G : SimpleGraph α) : ℕ∞ :=\n340:   ⨅ u, G.eccent u\n341: \n342: lemma radius_eq_iInf_iSup_edist : G.radius = ⨅ u, ⨆ v, G.edist u v :=\n343:   rfl\n344: \n345: lemma radius_le_eccent {u : α} : G.radius ≤ G.eccent u :=\n346:   iInf_le G.eccent u\n347: \n348: lemma exists_eccent_eq_radius [Nonempty α] : ∃ u, G.eccent u = G.radius :=\n349:   ENat.exists_eq_iInf G.eccent\n350: \n351: lemma exists_edist_eq_radius_of_finite [Nonempty α] [Finite α] :\n352:     ∃ u v, G.edist u v = G.radius := by\n353:   obtain ⟨w, hw⟩ := G.exists_eccent_eq_radius\n354:   obtain ⟨v, hv⟩ := G.exists_edist_eq_eccent_of_finite w\n355:   use w, v\n356:   rw [hv, hw]\n357: \n358: lemma radius_eq_top_of_not_connected (h : ¬ G.Connected) : G.radius = ⊤ := by\n359:   simp [radius, eccent_eq_top_of_not_connected h]\n360: \n361: lemma radius_eq_top_of_isEmpty [IsEmpty α] : G.radius = ⊤ :=\n362:   iInf_of_empty G.eccent\n363: \n364: lemma radius_ne_top_iff [Nonempty α] [Finite α] : G.radius ≠ ⊤ ↔ G.Connected := by\n365:   refine ⟨Not.imp_symm radius_eq_top_of_not_connected, fun h ↦ ?_⟩\n366:   obtain ⟨u, v, huv⟩ := G.exists_edist_eq_radius_of_finite\n367:   rw [← huv, edist_ne_top_iff_reachable]\n368:   exact h u v\n369: \n370: lemma radius_ne_zero_of_nontrivial [Nontrivial α] : G.radius ≠ 0 := by\n371:   rw [← Order.one_le_iff_ne_zero]\n372:   apply le_iInf\n373:   simp [Order.one_le_iff_ne_zero, G.eccent_ne_zero]\n374: \n375: lemma radius_eq_zero_iff : G.radius = 0 ↔ Nonempty α ∧ Subsingleton α := by\n376:   refine ⟨fun h ↦ ⟨?_, ?_⟩, fun ⟨_, _⟩ ↦ ?_⟩\n377:   · contrapose! h\n378:     simp [radius]\n379:   · contrapose! h\n380:     simp [radius_ne_zero_of_nontrivial]\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
