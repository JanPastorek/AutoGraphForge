{"step_index":670,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-11T23:40:05Z","content":"Created At: 2026-09-12T01:40:05+02:00\nCompleted At: 2026-09-12T01:40:05+02:00\nFile Path: `file:///mnt/home/japake298/project/GraphConjecturing/handoff/promising13/task_2a2555cc/Challenge_2a2555cc.lean`\nTotal Lines: 128\nTotal Bytes: 5589\nShowing lines 1 to 60\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: import Mathlib\n2: import LeanProject.GraphInvariantsComputable\n3: \n4: set_option maxRecDepth 10000\n5: \n6: open SimpleGraph\n7: \n8: -- Conjecture under test: (nontrivial) ⇒ radius ≤ total_domination_number\n9: -- Both declarations refer to the same `Candidate`.\n10: abbrev Candidate : Prop :=\n11:     ∀ {V : Type} [Fintype V] [DecidableEq V]\n12:     (G : SimpleGraph V) [DecidableRel G.Adj],\n13:       GraphCalc.IsNontrivialClass G → GraphCalc.HasRadius G → GraphCalc.HasTotalDominationNumber G → GraphCalc.radius G ≤ GraphCalc.totalDominationNumber G\n14: \n15: lemma ballWithin_zero {V : Type} [Fintype V] [DecidableEq V] (G : SimpleGraph V) [DecidableRel G.Adj] (v : V) :\n16:     GraphCalc.ballWithin G 0 v = {v} := rfl\n17: \n18: lemma ballWithin_subset_succ {V : Type} [Fintype V] [DecidableEq V] (G : SimpleGraph V) [DecidableRel G.Adj] (k : ℕ) (v : V) :\n19:     GraphCalc.ballWithin G k v ⊆ GraphCalc.ballWithin G (k + 1) v := by\n20:   dsimp [GraphCalc.ballWithin]\n21:   exact Finset.subset_union_left\n22: \n23: lemma ballWithin_mono {V : Type} [Fintype V] [DecidableEq V] (G : SimpleGraph V) [DecidableRel G.Adj]\n24:     (v : V) {k m : ℕ} (h : k ≤ m) : GraphCalc.ballWithin G k v ⊆ GraphCalc.ballWithin G m v := by\n25:   obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le h\n26:   clear h\n27:   induction d with\n28:   | zero => exact Finset.Subset.refl _\n29:   | succ d' ih =>\n30:     exact Finset.Subset.trans ih (ballWithin_subset_succ G (k + d') v)\n31: \n32: lemma mem_ballWithin_succ_of_adj {V : Type} [Fintype V] [DecidableEq V] (G : SimpleGraph V) [DecidableRel G.Adj]\n33:     (k : ℕ) (v u w : V) (hu : u ∈ GraphCalc.ballWithin G k v) (hadj : G.Adj u w) :\n34:     w ∈ GraphCalc.ballWithin G (k + 1) v := by\n35:   dsimp [GraphCalc.ballWithin]\n36:   apply Finset.mem_union_right\n37:   apply Finset.mem_biUnion.mpr\n38:   refine ⟨u, hu, ?_⟩\n39:   rw [Finset.mem_filter]\n40:   exact ⟨Finset.mem_univ w, hadj⟩\n41: \n42: lemma mem_ballWithin_of_walk_start {V : Type} [Fintype V] [DecidableEq V] (G : SimpleGraph V) [DecidableRel G.Adj] :\n43:     ∀ {u v : V} (p : G.Walk u v), u ∈ GraphCalc.ballWithin G p.length v\n44:   | u, _, .nil => by\n45:     rw [SimpleGraph.Walk.length_nil, ballWithin_zero]\n46:     exact Finset.mem_singleton_self u\n47:   | u, v, .cons hadj p' => by\n48:     rw [SimpleGraph.Walk.length_cons]\n49:     exact mem_ballWithin_succ_of_adj G p'.length v _ u (mem_ballWithin_of_walk_start G p') hadj.symm\n50: \n51: lemma mem_ballWithin_of_walk {V : Type} [Fintype V] [DecidableEq V] (G : SimpleGraph V) [DecidableRel G.Adj]\n52:     {u v : V} (p : G.Walk u v) : v ∈ GraphCalc.ballWithin G p.length u := by\n53:   have h := mem_ballWithin_of_walk_start G p.reverse\n54:   rw [SimpleGraph.Walk.length_reverse] at h\n55:   exact h\n56: \n57: lemma mem_ballWithin_of_walk_le {V : Type} [Fintype V] [DecidableEq V] (G : SimpleGraph V) [DecidableRel G.Adj]\n58:     {u v : V} (p : G.Walk u v) {k : ℕ} (h : p.length ≤ k) :\n59:     v ∈ GraphCalc.ballWithin G k u :=\n60:   ballWithin_mono G u h (mem_ballWithin_of_walk G p)\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
