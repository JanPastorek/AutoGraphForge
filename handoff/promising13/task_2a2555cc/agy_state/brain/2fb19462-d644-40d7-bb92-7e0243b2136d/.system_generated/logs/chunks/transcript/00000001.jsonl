Calc.minUpTo]\n92:   apply finset_min_getD_le_of_mem (Fintype.card V)\n93:   rw [Finset.mem_filter, Finset.mem_range]\n94:   exact ⟨Nat.lt_succ_of_le hkle, heq⟩\n95: \n96: lemma min_getD_eq_min' {s : Finset ℕ} (hs : s.Nonempty) (d : ℕ) :\n97:     s.min.getD d = s.min' hs := by\n98:   have h := Finset.coe_min' hs\n99:   rw [← h]\n100:   rfl\n101: \n102: lemma exists_totalDominatingSet_card_eq {V : Type} [Fintype V] [DecidableEq V]\n103:     (G : SimpleGraph V) [DecidableRel G.Adj]\n104:     (ht : GraphCalc.HasTotalDominationNumber G) :\n105:     ∃ s : Finset V, GraphCalc.IsTotalDominatingSet G s ∧ s.card = GraphCalc.totalDominationNumber G := by\n106:   dsimp [GraphCalc.HasTotalDominationNumber, GraphCalc.HasWitness] at ht\n107:   rcases ht with ⟨s0, hs0mem, hs0dom⟩\n108:   dsimp [GraphCalc.totalDominationNumber, GraphCalc.minCard]\n109:   have hne : s0.card ∈ Finset.image Finset.card (Finset.filter (GraphCalc.IsTotalDominatingSet G) Finset.univ.powerset) := by\n110:     apply Finset.mem_image.mpr\n111:     refine ⟨s0, ?_, rfl⟩\n112:     rw [Finset.mem_filter]\n113:     exact ⟨hs0mem, hs0dom⟩\n114:   have hnonempty : (Finset.image Finset.card (Finset.filter (GraphCalc.IsTotalDominatingSet G) Finset.univ.powerset)).Nonempty := ⟨s0.card, hne⟩\n115:   have hmin := Finset.min'_mem _ hnonempty\n116:   rw [Finset.mem_image] at hmin\n117:   rcases hmin with ⟨s, hs, hscard⟩\n118:   rw [Finset.mem_filter] at hs\n119:   refine ⟨s, hs.2, ?_⟩\n120:   rw [hscard]\n121:   exact (min_getD_eq_min' hnonempty 0).symm\n122: \n123: theorem prove_2a2555cc : Candidate := by\n124:   sorry\n125: \n126: theorem refute_2a2555cc : ¬ Candidate := by\n127:   sorry\n128: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
