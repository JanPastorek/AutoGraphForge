y\\n371:   rw [← Order.one_le_iff_ne_zero]\\n372:   apply le_iInf\\n373:   simp [Order.one_le_iff_ne_zero, G.eccent_ne_zero]\\n374: \\n375: lemma radius_eq_zero_iff : G.radius = 0 ↔ Nonempty α ∧ Subsingleton α := by\\n376:   refine ⟨fun h ↦ ⟨?_, ?_⟩, fun ⟨_, _⟩ ↦ ?_⟩\\n377:   · contrapose! h\\n378:     simp [radius]\\n379:   · contrapose! h\\n380:     simp [radius_ne_zero_of_nontrivial]\\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\\n\"}\n22: {\"step_index\":126,\"source\":\"MODEL\",\"type\":\"PLANNER_RESPONSE\",\"status\":\"DONE\",\"created_at\":\"2026-09-11T18:49:28Z\",\"tool_calls\":[{\"name\":\"view_file\",\"args\":{\"AbsolutePath\":\"\\\"/mnt/home/japake298/project/GraphConjecturing/lean_project/LeanProject/GraphInvariants.lean\\\"\",\"EndLine\":\"200\",\"StartLine\":\"160\",\"toolAction\":\"\\\"Viewing file\\\"\",\"toolSummary\":\"\\\"View GraphInvariants.lean lines 160-200\\\"\"}}]}\n23: {\"step_index\":127,\"source\":\"MODEL\",\"type\":\"GENERIC\",\"status\":\"DONE\",\"created_at\":\"2026-09-11T18:49:30Z\",\"content\":\"Created At: 2026-09-11T20:49:30+02:00\\nCompleted At: 2026-09-11T20:49:30+02:00\\nFile Path: `file:///mnt/home/japake298/project/GraphConjecturing/lean_project/LeanProject/GraphInvariants.lean`\\nTotal Lines: 222\\nTotal Bytes: 11395\\nShowing lines 160 to 200\\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\\n160:     [DecidableRel G.Adj] : ℕ :=\\n161:   sInf { n | ∃ f : V → Fin 4,\\n162:     G.IsDoubleRomanDominatingFunction f ∧ ∑ v, (f v : ℕ) = n }\\n163: \\n164: -- `radius` is mathlib's (`SimpleGraph.radius : ℕ∞`, the minimum eccentricity);\\n165: -- the exporter reads it as `(G.radius).toNat`. On a disconnected graph it is\\n166: -- `⊤`, and `.toNat` sends that to `0` — which is precisely why the computable\\n167: -- mirror carries `HasRadius` and the exporters emit it as a hypothesis.\\n168: \\n169: /- ── Graph-class predicates (hypotheses for conditioned conjectures) ──────── -/\\n170: \\n171: /-- `G` is regular (every vertex the same degree). -/\\n172: def IsRegularClass (G : SimpleGraph V) [DecidableRel G.Adj] : Prop :=\\n173:   ∃ d, G.IsRegularOfDegree d\\n174: /-- `G` is cubic (3-regular). -/\\n175: def IsCubicClass (G : SimpleGraph V) [DecidableRel G.Adj] : Prop :=\\n176:   G.IsRegularOfDegree 3\\n177: /-- `G` is subcubic (maximum degree ≤ 3). -/\\n178: def IsSubcubicClass (G : SimpleGraph V) [DecidableRel G.Adj] : Prop :=\\n179:   G.maxDegree ≤ 3\\n180: /-- `G` is triangle-free. -/\\n181: def IsTriangleFreeClass (G : SimpleGraph V) : Prop := G.CliqueFree 3\\n182: /-- `G` is `K₄`-free. -/\\n183: def IsK4FreeClass (G : SimpleGraph V) : Prop := G.CliqueFree 4\\n184: /-- `G` is bipartite (2-colourable). -/\\n185: def IsBipartiteClass (G : SimpleGraph V) : Prop := G.Colorable 2\\n186: /-- `G` is Eulerian: connected, with every vertex of even degree.\\n187: \\n188: Connectivity is part of the definition, not an extra: graphcalc's `eulerian`\\n189: column is `networkx.is_eulerian`, which requires a closed Eulerian trail to\\n190: exist and so rejects a disconnected graph even when all its degrees are even.\\n191: Dropping it here would make this predicate strictly weaker than the hypothesis\\n192: the pipeline validated, so a theorem proved against it would not be the\\n193: conjecture. Caught by tools/lean_differential.py on the triangle-plus-isolated\\n194: -vertex graph, whose degrees are 0, 2, 2, 2. -/\\n195: def IsEulerianClass (G : SimpleGraph V) [DecidableRel G.Adj] : Prop :=\\n196:   G.Connected ∧ ∀ v, Even (G.degree v)\\n197: /-- `G` is nontrivial (at least two vertices): the graphcalc `nontrivial`\\n198: flag, `|V(G)| ≥ 2`, i.e. `2 ≤ G.order`. -/\\n199: def IsNontrivialClass (G : SimpleGraph V) : Prop := 2 ≤ G.order\\n200: /-- `G` is connected. -/\\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\\n\"}\n24: {\"step_index\":128,\"source\":\"MODEL\",\"type\":\"PLANNER_RESPONSE\",\"status\":\"DONE\",\"created_at\":\"2026-09-11T18:49:30Z\",\"tool_calls\":[{\"name\":\"view_file\",\"args\":{\"AbsolutePath\":\"\\\"/mnt/home/japake298/project/GraphConjecturing/lean_project/LeanProject/GraphInvariants.lean\\\"\",\"EndLine\":\"222\",\"StartLine\":\"200\",\"toolAction\":\"\\\"Viewing file\\\"\",\"toolSummary\":\"\\\"View GraphInvariants.lean lines 200-222\\\"\"}}]}\n25: {\"step_index\":129,\"source\":\"MODEL\",\"type\":\"GENERIC\",\"status\":\"DONE\",\"created_at\":\"2026-09-11T18:49:33Z\",\"content\":\"Created At: 2026-09-11T20:49:33+02:00\\nCompleted At: 2026-09-11T20:49:33+02:00\\nFile Path: `file:///mnt/home/japake298/project/GraphConjecturing/lean_project/LeanProject/GraphInvariants.lean`\\nTotal Lines: 222\\nTotal Bytes: 11395\\nShowing lines 200 to 222\\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\\n200: /-- `G` is connected. -/\\n201: def IsConnectedClass (G : SimpleGraph V) : Prop := G.Connected\\n202: /-- `G` is a tree: connected and acyclic. -/\\n203: def IsTreeClass (G : SimpleGraph V) : Prop := G.IsTree\\n204: /-- `G` is claw-free: no vertex has three pairwise non-adjacent neighbours,\\n205: i.e. no four vertices induce a `K₁,₃`.\\n206: \\n207: Stated as a forbidden configuration rather than as `¬ (K₁,₃ ⊴ G)` so that the\\n208: computable mirror in `GraphInvariantsComputable.lean` can be the *same*\\n209: condition: the two files then agree by definition, with no unproved bridge\\n210: lemma sitting between the statement we prove and the statement we refute. -/\\n211: def IsClawFreeClass (G : SimpleGraph V) : Prop :=\\n212:   ∀ v a b c : V, G.Adj v a → G.Adj v b → G.Adj v c →\\n213:     a ≠ b → a ≠ c → b ≠ c → G.Adj a b ∨ G.Adj a c ∨ G.Adj b c\\n214: /-- `G` is a cograph: no four vertices induce a path `P₄` (Corneil–Lerchs–\\n215: Stewart Burlingham). Distinctness of `a b c d` is implied by the adjacencies\\n216: and non-adjacencies together with irreflexivity, so it is not assumed. -/\\n217: def IsCographClass (G : SimpleGraph V) : Prop :=\\n218:   ∀ a b c d : V, G.Adj a b → G.Adj b c → G.Adj c d →\\n219:     ¬ G.Adj a c → ¬ G.Adj b d → G.Adj a d\\n220: \\n221: end SimpleGraph\\n222: \\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\\n\"}\n26: \nThe above content shows the entire, complete file contents of the requested file.\n"}
