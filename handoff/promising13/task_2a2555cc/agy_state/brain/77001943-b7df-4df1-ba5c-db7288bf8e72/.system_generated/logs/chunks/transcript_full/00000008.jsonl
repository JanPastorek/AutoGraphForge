{"step_index":889,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-11T23:30:09Z","content":"Created At: 2026-09-12T01:30:09+02:00\nCompleted At: 2026-09-12T01:30:09+02:00\nFile Path: `file:///mnt/home/japake298/project/GraphConjecturing/tools/antigravity_handoff.py`\nTotal Lines: 348\nTotal Bytes: 15551\nShowing lines 1 to 348\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: #!/usr/bin/env python\n2: \"\"\"tools/antigravity_handoff.py — run the prover benchmark through Antigravity.\n3: \n4: Antigravity's `/teamwork-preview` is a slash command inside its IDE, not an API,\n5: so the integration is a file handoff: export the challenges, run the team over\n6: them there, drop what comes back into a directory, verify it here.\n7: \n8: The verification deliberately reuses the *same* path as the seven-model\n9: campaign — `LeanSubprocessProver._run_lean(..., audit_axioms=True)` over a\n10: challenge file whose `prove`/`refute` declarations are two directions of one\n11: `Candidate` — so the result is directly comparable to that baseline rather than\n12: being a differently-scored number.\n13: \n14: Why that matters here specifically: every formalization bug this repository has\n15: found produced an *apparent success*. A model \"proved\" three items that were\n16: `Fin 0` artefacts; another exploited `minCard`'s 0 fallback on an undefined\n17: invariant. A stronger agent team is more likely to find such holes, not less, so\n18: nothing is counted as resolved unless the kernel accepts it under an axiom\n19: audit, and `--strict` additionally re-checks that the accepted direction agrees\n20: with the ground-truth label the benchmark carries.\n21: \n22: Usage:\n23:     python tools/antigravity_handoff.py export --partition gold --out handoff/\n24:     # ... run /teamwork-preview over handoff/, save results into handoff/solved/\n25:     python tools/antigravity_handoff.py verify --partition gold --dir handoff/solved\n26: \"\"\"\n27: from __future__ import annotations\n28: \n29: import argparse\n30: import collections\n31: import json\n32: import os\n33: import re\n34: import sys\n35: \n36: sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))\n37: \n38: from config import CONFIG  # noqa: E402\n39: \n40: BRIEF = \"\"\"\\\n41: # AutoGraphForge — prover benchmark handoff\n42: \n43: Each `Challenge_<id>.lean` states one conjecture once, as `Candidate`, and asks\n44: for **either** direction:\n45: \n46:     theorem prove_<id>  :   Candidate := by sorry\n47:     theorem refute_<id> : ¬ Candidate := by sorry\n48: \n49: Close exactly one, editing the file in place and keeping its name. Leave the\n50: other declaration untouched, `sorry` and all — the verifier removes it.\n51: \n52: What makes a result count:\n53: \n54: * Nothing above the first `theorem` may change: imports, options, `Candidate`.\n55:   Helper lemmas go after `Candidate`, as top-level `theorem`/`lemma`/`def`.\n56: * The chosen theorem keeps its exact name and type. The verifier re-checks the\n57:   type by elaborating `_root_.prove_<id> : _root_.Candidate` itself.\n58: * No `sorry`, `admit`, `axiom`, `native_decide`, `namespace`, `section`,\n59:   `variable`, custom `notation`/`macro`/`syntax`, or metaprogramming; only\n60:   `propext`, `Classical.choice` and `Quot.sound` may appear among the axioms.\n61: * Never run `lake` in this project — it deletes Mathlib.\n62: \n63: `decide` evaluates the invariants on an explicit small graph\n64: (`GraphCalc.ofEdges n [(0, 1), ...]`), so a refutation is usually a witness plus\n65: `decide`. Ground truth is withheld. {n} items in this partition.\n66: \"\"\"\n67: \n68: \n69: def _index(bench: str, partition: str):\n70:     path = os.path.join(bench, f\"challenges_{partition}\", \"index.json\")\n71:     if not os.path.exists(path):\n72:         raise SystemExit(f\"no challenge index at {path} — run \"\n73:                          f\"tools/prover_eval/challenge.py --partition {partition}\")\n74:     return json.load(open(path)), os.path.dirname(path)\n75: \n76: \n77: def do_export(args) -> int:\n78:     index, src = _index(args.benchmark, args.partition)\n79:     os.makedirs(args.out, exist_ok=True)\n80:     os.makedirs(os.path.join(args.out, \"solved\"), exist_ok=True)\n81:     import shutil\n82:     for item in index:\n83:         shutil.copy(os.path.join(src, item[\"file\"]), os.path.join(args.out, item[\"file\"]))\n84:     with open(os.path.join(args.out, \"README.md\"), \"w\") as fh:\n85:         fh.write(BRIEF.format(n=len(index)))\n86:     # The labels stay on this side of the handoff.\n87:     with open(os.path.join(args.out, \".ground_truth.json\"), \"w\") as fh:\n88:         json.dump({i[\"id\"]: {\"label\": i[\"label\"], \"witness_g6\": i.get(\"witness_g6\"),\n89:                              \"statement\": i[\"statement\"]} for i in index}, fh, indent=1)\n90:     print(f\"exported {len(index)} challenges → {args.out}\")\n91:     print(f\"  brief:       {os.path.join(args.out, 'README.md')}\")\n92:     print(f\"  put results in: {os.path.join(args.out, 'solved')}\")\n93:     return 0\n94: \n95: \n96: def _candidate_of(text: str):\n97:     \"\"\"The `abbrev Candidate : Prop := …` body, normalised for comparison.\"\"\"\n98:     m = re.search(r\"abbrev\\s+Candidate\\s*:\\s*Prop\\s*:=(.*?)(?=\\n\\ntheorem )\", text, re.S)\n99:     return re.sub(r\"\\s+\", \" \", m.group(1)).strip() if m else None\n100: \n101: \n102: # ── admissibility ─────────────────────────────────────────────────────────────\n103: #\n104: # An answer is compiled as the *returned file*, helper lemmas included — pasting\n105: # only the proof body back into the original, as the model campaign did, drops\n106: # every lemma a real proof needs and turns a correct proof into \"unresolved\".\n107: #\n108: # Compiling the returned file is only sound if nothing in it can change what is\n109: # being proved. The checks below close the routes that exist in Lean for that:\n110: # editing `Candidate` or anything it elaborates against; extending its term past\n111: # where it ended (a term does not stop at a newline); re-declaring `Candidate` or\n112: # the target inside a namespace; adding `variable` hypotheses the target silently\n113: # absorbs; redefining the tokens `Candidate` parses as; and bypassing the kernel.\n114: # The target's type is then re-checked by Lean itself, and the axiom audit rejects\n115: # `sorryAx` and anything non-standard.\n116: \n117: _CMD_START = (\"theorem\", \"lemma\", \"def\", \"abbrev\", \"example\", \"instance\", \"open\",\n118:               \"set_option\", \"attribute\", \"noncomputable\", \"private\", \"protected\",\n119:               \"@[\", \"#check\", \"#print\", \"structure\", \"inductive\", \"class\")\n120: \n121: _FORBIDDEN_CMD = re.compile(\n122:     r\"(?m)^\\s*(?:(?:private|protected|noncomputable|local|scoped)\\s+)*\"\n123:     r\"(namespace|section|variable|universe|notation\\w*|infixl?|infixr|prefix|postfix|\"\n124:     r\"macro\\w*|syntax\\w*|declare_syntax_cat|elab\\w*|initialize|builtin_initialize|\"\n125:     r\"run_cmd|run_elab|run_meta)\\b\")\n126: \n127: # Lean elaboration can run arbitrary code: `#eval IO.Process.run …`, `run_cmd`,\n128: # a user `elab`, an `@[init]` hook. Agents are only allowed to run the checker,\n129: # and the verifier compiles their files with full user privileges, so anything\n130: # that reaches IO or the metaprogramming API is refused *before* Lean sees the\n131: # file — that refusal is what makes \"only check.sh may run\" an actual boundary.\n132: _FORBIDDEN_TOKEN = re.compile(\n133:     r\"\\b(native_decide|ofReduceBool|trustCompiler|skipKernelTC|implemented_by|\"\n134:     r\"extern|axiom|unsafe\\w*|run_tac|run_cmd|run_elab|run_meta|addDecl\\w*|\"\n135:     r\"Lean|\\w*IO|System|Process|MetaM|CoreM|TermElabM|CommandElabM|TacticM|\"\n136:     r\"macro\\w*|elab\\w*|syntax\\w*|notation\\w*|initialize|builtin_initialize)\\b\"\n137:     r\"|#eval|#exit|\\bdebug\\.|@\\[\\s*(?:init|builtin_init|command_elab|term_elab|\"\n138:     r\"tactic|extern|implemented_by)\")\n139: \n140: _ALLOWED_IMPORTS = {\"Mathlib\", \"LeanProject.GraphInvariantsComputable\",\n141:                     \"LeanProject.GraphInvariants\"}\n142: \n143: \n144: def _norm(text: str) -> str:\n145:     return \"\\n\".join(line.rstrip() for line in text.replace(\"\\r\\n\", \"\\n\").split(\"\\n\"))\n146: \n147: \n148: def _strip_comments(src: str) -> str:\n149:     src = re.sub(r\"/-.*?-/\", \" \", src, flags=re.S)\n150:     return re.sub(r\"--[^\\n]*\", \" \", src)\n151: \n152: \n153: def _prefix(original: str):\n154:     \"\"\"Everything up to the first theorem: imports, options, `Candidate`.\"\"\"\n155:     i = original.find(\"abbrev Candidate\")\n156:     j = original.find(\"\\n\\ntheorem \", i) if i >= 0 else -1\n157:     return original[:j] if j >= 0 else None\n158: \n159: \n160: def structural_check(original: str, returned: str):\n161:     \"\"\"(ok, reason): may the returned file be compiled as an answer at all?\"\"\"\n162:     orig, ret = _norm(original), _norm(returned)\n163:     pre = _prefix(orig)\n164:     if pre is None:\n165:         return False, \"original challenge is malformed\"\n166:     if not ret.startswith(pre):\n167:         return False, \"statement changed: text above the first theorem differs\"\n168:     rest = ret[len(pre):]\n169:     if rest and not rest.startswith(\"\\n\"):\n170:         return False, \"statement changed: Candidate's last line was extended\"\n171:     code = _strip_comments(rest)\n172:     head = code.lstrip()\n173:     if head and not head.startswith(_CMD_START):\n174:         return False, \"statement changed: Candidate continues past its original end\"\n175:     m = _FORBIDDEN_CMD.search(code)\n176:     if m:\n177:         return False, f\"forbidden command `{m.group(1)}`\"\n178:     m = _FORBIDDEN_TOKEN.search(code)\n179:     if m:\n180:         return False, f\"forbidden construct `{m.group(0)}`\"\n181:     return True, \"\"\n182: \n183: \n184: def lint_text(text: str, original=None):\n185:     \"\"\"(ok, reason) for any Lean file an agent asks to elaborate.\n186: \n187:     A challenge file is held to `structural_check` against its original. Any\n188:     other file (scratch lemmas) gets the same code-execution screen plus an\n189:     import whitelist, since `import` is the other way to pull in code.\n190:     \"\"\"\n191:     if original is not None:\n192:         return structural_check(original, text)\n193:     code = _strip_comments(_norm(text))\n194:     for m in re.finditer(r\"(?m)^\\s*import\\s+(\\S+)\", code):\n195:         if m.group(1) not in _ALLOWED_IMPORTS:\n196:             return False, f\"import `{m.group(1)}` is not allowed\"\n197:     m = _FORBIDDEN_CMD.search(code)\n198:     if m:\n199:         return False, f\"forbidden command `{m.group(1)}`\"\n200:     m = _FORBIDDEN_TOKEN.search(code)\n201:     if m:\n202:         return False, f\"forbidden construct `{m.group(0)}`\"\n203:     return True, \"\"\n204: \n205: \n206: def solution_file(returned: str, ident: str, direction: str):\n207:     \"\"\"The returned file prepared to check one direction, or None.\n208: \n209:     The other direction's untouched `sorry` block is removed, and a declaration\n210:     is appended that forces Lean to confirm the target has exactly the type\n211:     asked for — `_root_`-qualified, so a same-named `Candidate` or target in some\n212:     other namespace cannot stand in for it.\n213:     \"\"\"\n214:     ret = _norm(returned)\n215:     other = \"refute\" if direction == \"prove\" else \"prove\"\n216:     header = {\"prove\": rf\"(?m)^theorem\\s+prove_{ident}\\s*:\\s*Candidate\\s*:=\",\n217:               \"refute\": rf\"(?m)^theorem\\s+refute_{ident}\\s*:\\s*¬\\s*Candidate\\s*:=\"}\n218:     pristine = {\"prove\": f\"theorem prove_{ident} : Candidate := by\\n  sorry\",\n219:                 \"refute\": f\"theorem refute_{ident} : ¬ Candidate := by\\n  sorry\"}\n220:     if not re.search(header[direction], _strip_comments(ret)):\n221:         return None\n222:     if pristine[direction] in ret:\n223:         return None\n224:     body = ret.replace(pristine[other], \"\")\n225:     ty = \"_root_.Candidate\" if direction == \"prove\" else \"¬ _root_.Candidate\"\n226:     return (body.rstrip() + \"\\n\\n-- verifier: the target must have exactly this type\\n\"\n227:             f\"theorem agf_verify_{direction} : {ty} := _root_.{direction}_{ident}\\n\")\n228: \n229: \n230: def do_verify(args) -> int:\n231:     from pipeline.theorem_prover import LeanSubprocessProver\n232:     from tools.prover_eval.w16 import is_timeout\n233: \n234:     index, src = _index(args.benchmark, args.partition)\n235:     truth = {}\n236:     gt = os.path.join(os.path.dirname(args.dir.rstrip(\"/\")), \".ground_truth.json\")\n237:     if os.path.exists(gt):\n238:         truth = json.load(open(gt))\n239: \n240:     CONFIG.lean_timeout_s = args.timeout\n241:     lean = LeanSubprocessProver(CONFIG)\n242:     if not lean._available:\n243:         print(\"ERROR: no Lean available — cannot verify.\")\n244:         return 2\n245: \n246:     results, counts = [], collections.Counter()\n247:     for item in index:\n248:         ident, fname = item[\"id\"], item[\"file\"]\n249:         path = os.path.join(args.dir, fname)\n250:         if not os.path.exists(path):\n251:             continue\n252:         returned = open(path).read()\n253:         original = open(os.path.join(src, fname)).read()\n254:         rec = {\"id\": ident, \"statement\": item[\"statement\"],\n255:                \"label\": (truth.get(ident) or {}).get(\"label\", item.get(\"label\"))}\n256: \n257:         ok, why = structural_check(original, returned)\n258:         if not ok:\n259:             rec.update(status=\"rejected\", reason=why)\n260:             counts[\"rejected\"] += 1\n261:             print(f\"  {ident}  REJECTED — {why}\")\n262:             results.append(rec)\n263:             continue\n264: \n265:         verified, timed_out = [], False\n266:         for direction in (\"prove\", \"refute\"):\n267:             sol = solution_file(returned, ident, direction)\n268:             if sol is None:\n269:                 continue\n270:             good, log = lean._run_lean(sol, audit_axioms=True)\n271:             if good:\n272:                 verified.append(direction)\n273:             else:\n274:                 timed_out = timed_out or is_timeout(log)\n275:                 rec[f\"{direction}_log_tail\"] = log.strip()[-800:]\n276: \n277:         if len(verified) == 2:\n278:             # Both `Candidate` and `¬ Candidate` accepted means the environment\n279:             # proves False. Never report that as a resolution.\n280:             rec.update(status=\"INCONSISTENT\", reason=\"both directions kernel-verified\")\n281:             counts[\"INCONSISTENT\"] += 1\n282:             print(f\"  {ident}  !!! BOTH DIRECTIONS VERIFIED — inconsistency, investigate\")\n283:         elif verified:\n284:             d = verified[0]\n285:             expected = {\"true\": \"prove\", \"false\": \"refute\"}.get(str(rec[\"label\"]).lower())\n286:             if args.strict and expected and d != expected:\n287:                 rec.update(status=\"wrong_direction\", direction=d)\n288:                 counts[\"wrong_direction\"] += 1\n289:                 print(f\"  {ident}  WRONG DIRECTION: {d} but label={rec['label']}\")\n290:             else:\n291:                 rec.update(status=\"resolved\", direction=d)\n292:                 counts[\"resolved\"] += 1\n293:                 print(f\"  {ident}  RESOLVED by {d}\")\n294:         else:\n295:             status = \"timeout\" if timed_out else \"unresolved\"\n296:             rec.update(status=status)\n297:             counts[status] += 1\n298:             print(f\"  {ident}  {status}\")\n299:         results.append(rec)\n300: \n301:     out = os.path.join(args.dir, f\"verification_{args.partition}.json\")\n302:     json.dump(results, open(out, \"w\"), indent=1)\n303:     print(f\"\\npartition '{args.partition}': {len(index)} items, {len(results)} files returned\")\n304:     for k in (\"resolved\", \"unresolved\", \"timeout\", \"rejected\", \"wrong_direction\",\n305:               \"INCONSISTENT\"):\n306:         print(f\"  {k:16s}: {counts[k]}\")\n307:     print(f\"  -> {out}\")\n308:     return 0\n309: \n310: \n311: def do_lint(args) -> int:\n312:     try:\n313:         text = open(args.file).read()\n314:     except Exception as e:\n315:         print(f\"LINT: cannot read {args.file}: {e}\")\n316:         return 2\n317:     original = open(args.original).read() if args.original else None\n318:     ok, why = lint_text(text, original)\n319:     print(\"LINT: ok\" if ok else f\"LINT: REJECTED — {why}\")\n320:     return 0 if ok else 1\n321: \n322: \n323: def main() -> int:\n324:     ap = argparse.ArgumentParser()\n325:     sub = ap.add_subparsers(dest=\"cmd\", required=True)\n326:     e = sub.add_parser(\"export\"); e.set_defaults(fn=do_export)\n327:     e.add_argument(\"--benchmark\", default=\"benchmark\")\n328:     e.add_argument(\"--partition\", default=\"gold\")\n329:     e.add_argument(\"--out\", default=\"handoff\")\n330:     v = sub.add_parser(\"verify\"); v.set_defaults(fn=do_verify)\n331:     v.add_argument(\"--benchmark\", default=\"benchmark\")\n332:     v.add_argument(\"--partition\", default=\"gold\")\n333:     v.add_argument(\"--dir\", required=True)\n334:     v.add_argument(\"--timeout\", type=int, default=3600,\n335:                    help=\"seconds per Lean check; decide-heavy refutations can need minutes\")\n336:     v.add_argument(\"--strict\", action=\"store_true\", default=True,\n337:                    help=\"reject a resolution whose direction contradicts the label\")\n338:     li = sub.add_parser(\"lint\"); li.set_defaults(fn=do_lint)\n339:     li.add_argument(\"--original\", default=None,\n340:                     help=\"the untouched challenge, when FILE is one\")\n341:     li.add_argument(\"file\")\n342:     args = ap.parse_args()\n343:     return args.fn(args)\n344: \n345: \n346: if __name__ == \"__main__\":\n347:     raise SystemExit(main())\n348: \nThe above content shows the entire, complete file contents of the requested file.\n"}
