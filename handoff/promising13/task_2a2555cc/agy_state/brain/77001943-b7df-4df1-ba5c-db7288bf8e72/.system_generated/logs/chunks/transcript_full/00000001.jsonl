{"step_index":127,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-11T18:39:48Z","content":"Created At: 2026-09-11T20:39:48+02:00\nCompleted At: 2026-09-11T20:39:48+02:00\nFile Path: `file:///mnt/home/japake298/project/GraphConjecturing/tools/export_disproofs.py`\nTotal Lines: 109\nTotal Bytes: 4071\nShowing lines 1 to 100\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: #!/usr/bin/env python\n2: \"\"\"tools/export_disproofs.py — formal Lean 4 disproofs from refuted conjectures.\n3: \n4: The generate--refute loop discards far more conjectures than it keeps, and for\n5: each one it knows the graph that killed it (``results/refutations.json``). That\n6: pair is a theorem: ``¬∀ G, hypotheses → bound``, proved by evaluating both sides\n7: on the witness. This script emits one self-contained ``.lean`` file per\n8: formalizable refutation and (optionally) kernel-checks each one.\n9: \n10: A disproof counts only if the kernel accepts it here — same discipline as\n11: ``tools/verify_proofs.py`` for the positive direction.\n12: \n13: Usage:\n14:     python tools/export_disproofs.py [--limit N] [--verify] [--out DIR]\n15: Exit code is the number of emitted disproofs that FAILED verification.\n16: \"\"\"\n17: from __future__ import annotations\n18: \n19: import argparse\n20: import json\n21: import os\n22: import re\n23: import sys\n24: \n25: sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))\n26: \n27: from config import CONFIG  # noqa: E402\n28: from pipeline import lean_disproof  # noqa: E402\n29: \n30: \n31: def _columns(refutations) -> list:\n32:     \"\"\"Invariant/class identifiers appearing in the refuted statements.\"\"\"\n33:     toks = set()\n34:     for r in refutations:\n35:         toks |= set(re.findall(r\"[A-Za-z_][A-Za-z_0-9]*\", r.get(\"statement\") or \"\"))\n36:     return sorted(toks)\n37: \n38: \n39: def main() -> int:\n40:     ap = argparse.ArgumentParser()\n41:     ap.add_argument(\"--refutations\",\n42:                     default=os.path.join(\"results\", \"refutations.json\"))\n43:     ap.add_argument(\"--out\", default=os.path.join(\"results\", \"disproofs\"))\n44:     ap.add_argument(\"--limit\", type=int, default=None,\n45:                     help=\"stop after this many formalizable refutations\")\n46:     ap.add_argument(\"--verify\", action=\"store_true\",\n47:                     help=\"kernel-check each emitted disproof\")\n48:     args = ap.parse_args()\n49: \n50:     if not os.path.exists(args.refutations):\n51:         print(f\"No refutation record at {args.refutations}. Run the CEGIS loop \"\n52:               f\"first (refutations are written alongside cegis_results.json).\")\n53:         return 0\n54: \n55:     with open(args.refutations) as fh:\n56:         payload = json.load(fh)\n57:     refutations = payload.get(\"refutations\", payload if isinstance(payload, list) else [])\n58:     if not refutations:\n59:         print(\"Refutation record is empty — nothing to export.\")\n60:         return 0\n61: \n62:     cols = _columns(refutations)\n63:     exported = lean_disproof.export_refutations(refutations, cols, limit=args.limit)\n64:     total_with_witness = sum(1 for r in refutations if r.get(\"witness_graph6\"))\n65:     print(f\"{len(refutations)} refuted, {total_with_witness} with a witness, \"\n66:           f\"{len(exported)} formalizable → {args.out}\")\n67:     if not exported:\n68:         return 0\n69: \n70:     os.makedirs(args.out, exist_ok=True)\n71:     paths = []\n72:     for i, (rec, src) in enumerate(exported):\n73:         path = os.path.join(args.out, f\"disproof_{i:04d}.lean\")\n74:         with open(path, \"w\") as fh:\n75:             fh.write(src)\n76:         paths.append((path, rec))\n77: \n78:     if not args.verify:\n79:         print(f\"Wrote {len(paths)} disproof file(s). Re-run with --verify to \"\n80:               f\"kernel-check them.\")\n81:         return 0\n82: \n83:     from pipeline.theorem_prover import LeanSubprocessProver\n84:     lean = LeanSubprocessProver(CONFIG)\n85:     if not lean._available:\n86:         print(\"ERROR: no Lean binary available to kernel-check — aborting \"\n87:               \"(an unverifiable run must not report success).\")\n88:         return 2\n89: \n90:     failed = 0\n91:     for path, rec in paths:\n92:         with open(path) as fh:\n93:             ok, log = lean._run_lean(fh.read())\n94:         name = os.path.basename(path)\n95:         if ok:\n96:             print(f\"  ✓ {name}  (n={rec.get('witness_order')}) \"\n97:                   f\"{(rec.get('statement') or '')[:70]}\")\n98:         else:\n99:             failed += 1\n100:             first = next((ln for ln in log.splitlines() if \"error\" in ln.lower()),\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
