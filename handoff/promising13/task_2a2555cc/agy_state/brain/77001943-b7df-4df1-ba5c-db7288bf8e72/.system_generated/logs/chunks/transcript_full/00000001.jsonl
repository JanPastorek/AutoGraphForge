t names or names <= set(CLASS_PREDICATES):\n176:         return None\n177:     if any(n not in SUPPORTED for n in names):\n178:         return None\n179:     rendered = linear_form.render_comparison(body, SUPPORTED)\n180:     if rendered is None:\n181:         return None\n182:     return classes, rendered, definedness_hyps(names, lambda h: f\"GraphCalc.{h} G\")\n183: \n184: \n185: def _parse_necessary(statement: str) -> Optional[Tuple[str, str]]:\n186:     \"\"\"(lean_hypothesis, lean_conclusion) for an ``(inequality) ⇒ classes``\n187:     survivor, else None.\n188: \n189:     The hypothesis is normalised to ℕ by ``linear_form`` — the same rewriting the\n190:     positive exporter applies, so the theorem and its disproof are statements\n191:     about the same proposition.\n192:     \"\"\"\n193:     if \"⇒\" not in statement:\n194:         return None\n195:     cond, concl = statement.split(\"⇒\", 1)\n196:     clauses = linear_form.parse_class_conclusion(concl)\n197:     if not clauses or any(c not in CLASS_PREDICATES for _, c in clauses):\n198:         return None\n199:     names = set(linear_form.invariants(cond))\n200:     if not names or names <= set(CLASS_PREDICATES):\n201:         return None                        # class-conditioned shape, not this one\n202:     if any(n not in SUPPORTED for n in names):\n203:         return None\n204:     hyp = linear_form.render_comparison(cond, SUPPORTED)\n205:     if hyp is None:\n206:         return None\n207:     goal = \" ∧ \".join(\n208:         f\"¬ {CLASS_PREDICATES[c]} G\" if neg else f\"{CLASS_PREDICATES[c]} G\"\n209:         for neg, c in clauses)\n210:     # Mirror the theorem: the conjecture is about non-trivial graphs, so a\n211:     # disproof must exhibit one. Omitting this made every statement of this\n212:     # shape refutable by Fin 0, where the class predicates hold vacuously.\n213:     guards = [f\"{CLASS_PREDICATES['nontrivial']} G\"] + \\\n214:         definedness_hyps(names, lambda h: f\"GraphCalc.{h} G\")\n215:     return \" → \".join(guards + [hyp]), goal\n216: \n217: \n218: def is_supported(statement: str, columns, witness_graph6: Optional[str]) -> bool:\n219:     \"\"\"True iff ``render`` would produce a disproof for this refutation.\"\"\"\n220:     return render(statement, columns, witness_graph6) is not None\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
