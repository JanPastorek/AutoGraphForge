{"step_index":93,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-11T18:38:43Z","content":"Created At: 2026-09-11T20:38:43+02:00\nCompleted At: 2026-09-11T20:38:43+02:00\nFile Path: `file:///mnt/home/japake298/project/GraphConjecturing/pipeline/invariants_graphcalc.py`\nTotal Lines: 310\nTotal Bytes: 12839\nShowing lines 1 to 100\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: \"\"\"\n2: pipeline/invariants_graphcalc.py — the invariant battery for CEGIS.\n3: \n4: Single source of truth for \"all invariants in graphcalc\": wraps\n5: ``graphcalc.graphs.all_properties`` (59 numeric + boolean columns in graphcalc\n6: 2.0) into a robust, NaN-tolerant table builder, plus a best-effort metadata\n7: registry (category / notation / display-name) read from each invariant's\n8: ``@invariant_metadata`` decorator.\n9: \n10: Design choices (see docs/CEGIS_PLAN.md):\n11:   * Per-graph computation with a wall-clock cap, so one slow/huge graph (the NP-\n12:     hard ILP invariants blow up past n≈18) never stalls a build — it just\n13:     contributes a partial / empty row. **Incomplete tables are expected and OK**;\n14:     refutation is NaN-aware.\n15:   * The union of all rows' keys defines the columns; missing cells are NaN.\n16: \"\"\"\n17: from __future__ import annotations\n18: \n19: import logging\n20: import os\n21: import signal\n22: from functools import lru_cache\n23: from typing import Dict, List, Optional, Sequence\n24: \n25: import networkx as nx\n26: import numpy as np\n27: import pandas as pd\n28: \n29: logger = logging.getLogger(__name__)\n30: \n31: # graphcalc's full-battery entry point (accepts plain networkx graphs); the\n32: # per-invariant entry point + the property name list are used for the salvage\n33: # path (compute each invariant under its own timeout so one slow NP-hard\n34: # invariant blanks only its own cell, not the whole row).\n35: from graphcalc.graphs import all_properties as _all_properties\n36: from graphcalc.graphs import compute_knowledge_table as _ckt\n37: from graphcalc.graphs import GRAPHCALC_PROPERTY_LIST as _PROPS\n38: \n39: \n40: # --------------------------------------------------------------------------- #\n41: # per-graph timeout\n42: # --------------------------------------------------------------------------- #\n43: class _Timeout(Exception):\n44:     pass\n45: \n46: \n47: def _on_alarm(signum, frame):           # pragma: no cover - signal handler\n48:     raise _Timeout()\n49: \n50: \n51: # per-invariant cap (seconds) for the salvage path; a single slow invariant\n52: # blanks only its own cell instead of discarding the whole row. Kept small so a\n53: # big witness with a few intractable invariants does not dominate round time.\n54: _PER_INVARIANT_CAP_S = 3\n55: \n56: \n57: def _battery_salvage(G: nx.Graph, per_s: int) -> Dict[str, float]:\n58:     \"\"\"Compute each invariant independently under its own timeout, returning a\n59:     *partial* row: every invariant that finishes in time is kept, the rest are\n60:     simply absent (→ NaN). This is what keeps big/hard graphs from becoming\n61:     all-NaN rows, which would poison graffiti3 generation; partial rows are\n62:     coverage-masked per target by both refutation and generation.\"\"\"\n63:     row: Dict[str, float] = {}\n64:     have_alarm = hasattr(signal, \"SIGALRM\")\n65:     if have_alarm:\n66:         old = signal.signal(signal.SIGALRM, _on_alarm)\n67:     try:\n68:         for name in _PROPS:\n69:             if have_alarm:\n70:                 signal.alarm(int(per_s))\n71:             try:\n72:                 row.update(_ckt([name], [G]).iloc[0].to_dict())\n73:             except Exception:                       # timeout / ILP blow-up / numeric\n74:                 pass                                # leave this cell blank (NaN)\n75:             finally:\n76:                 if have_alarm:\n77:                     signal.alarm(0)\n78:     finally:\n79:         if have_alarm:\n80:             signal.signal(signal.SIGALRM, old)\n81:     return row\n82: \n83: \n84: def _battery_one(G: nx.Graph, cap_s: int, max_n: Optional[int] = None) -> Dict[str, float]:\n85:     \"\"\"Full graphcalc battery for one graph.\n86: \n87:     Fast path (graphs within the exact tier ``max_n``): the whole battery in one\n88:     call under a single ``cap_s`` alarm. On timeout/error, or for graphs beyond\n89:     the exact tier, fall back to the per-invariant *salvage* path so the row is\n90:     partial (cheap invariants kept) rather than empty — i.e. NaN means \"unknown\n91:     for this graph\", never \"this graph is unusable\".\"\"\"\n92:     n = G.number_of_nodes()\n93:     have_alarm = hasattr(signal, \"SIGALRM\")\n94:     # Graphs above the exact tier: skip the (doomed) whole-battery call and go\n95:     # straight to per-invariant salvage, which still recovers order/size/degree/\n96:     # spectral/… (polynomial) invariants even at large n.\n97:     if max_n is not None and n > max_n:\n98:         return _battery_salvage(G, _PER_INVARIANT_CAP_S)\n99:     if have_alarm:\n100:         old = signal.signal(signal.SIGALRM, _on_alarm)\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
