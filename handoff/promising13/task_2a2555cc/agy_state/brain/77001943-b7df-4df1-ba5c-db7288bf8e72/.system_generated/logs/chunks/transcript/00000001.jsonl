difications.\n8:   VNSFalsifier          — Variable Neighborhood Search.\n9:   CrossEntropyFalsifier — Probabilistic edge-distribution optimisation.\n10: \n11: FalsificationOrchestrator runs all four in sequence and returns the first\n12: counterexample found (or None if all strategies fail).\n13: \"\"\"\n14: \n15: from __future__ import annotations\n16: \n17: import logging\n18: import math\n19: import random\n20: import time\n21: from dataclasses import dataclass, field\n22: from typing import Dict, List, Optional, Tuple\n23: \n24: import networkx as nx\n25: import numpy as np\n26: \n27: from config import Config, CONFIG\n28: from conjecture import Conjecture, Counterexample\n29: from graphs.invariants import evaluate_all, evaluate_fast, evaluate_named, INVARIANTS\n30: \n31: logger = logging.getLogger(__name__)\n32: \n33: \n34: # ---------------------------------------------------------------------------\n35: # Result type\n36: # ---------------------------------------------------------------------------\n37: \n38: @dataclass\n39: class FalsificationResult:\n40:     falsified: bool = False\n41:     counterexample_graph: Optional[nx.Graph] = None\n42:     counterexample_name: str = \"\"\n43:     invariant_values: Dict[str, float] = field(default_factory=dict)\n44:     violation: float = 0.0          # |slack| when negative\n45:\n<truncated 473 bytes>\nnt_values=self.invariant_values,\n57:             violation_magnitude=self.violation,\n58:             edge_list=list(G.edges()),\n59:         )\n60: \n61: \n62: # ---------------------------------------------------------------------------\n63: # Shared helpers\n64: # ---------------------------------------------------------------------------\n65: \n66: def _evaluate_conjecture(\n67:     G: nx.Graph, conjecture: Conjecture\n68: ) -> Tuple[Optional[bool], Optional[float]]:\n69:     \"\"\"\n70:     Return (holds, slack) for a conjecture evaluated on G.\n71:     slack < 0  ⟹  conjecture violated  ⟹  G is a counterexample.\n72:     \"\"\"\n73:     if conjecture.inequality is None:\n74:         return None, None\n75:     # Evaluate exactly the invariants this conjecture reads — including the\n76:     # hypothesis boolean and any multivariable RHS terms, which the fast subset\n77:     # would otherwise omit (leaving the conjecture untestable).\n78:     inv = evaluate_named(G, conjecture.inequality.referenced_invariants())\n79:     holds = conjecture.inequality.evaluate(inv)\n80:     slack = conjecture.inequality.slack(inv)\n81:     return holds, slack\n82: \n83: \n84: def _result_from_graph(\n85:     G: nx.Graph, conjecture: Conjecture, strategy: str, t: float\n86: ) -> Optional[FalsificationResult]:\n87:     \"\"\"Build a FalsificationResult if G violates the conjecture, else None.\"\"\"\n88:     holds, slack = _evaluate_conjecture(G, conjecture)\n89:     if holds is False and slack is not None:\n90:         inv = evaluate_all(G)\n91:         return FalsificationResult(\n92:             falsified=True,\n93:             counterexample_graph=G.copy(),\n94:             counterexample_name=f\"cex_{strategy}\",\n95:             invariant_values=inv,\n96:             violation=abs(slack),\n97:             strategy_used=strategy,\n98:             time_s=t,\n99:         )\n100:     return None\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n","truncated_fields":["content"]}
