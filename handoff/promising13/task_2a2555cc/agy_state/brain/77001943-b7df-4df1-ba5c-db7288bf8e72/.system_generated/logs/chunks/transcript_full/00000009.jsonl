{"step_index":1071,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-11T23:36:36Z","content":"Created At: 2026-09-12T01:36:36+02:00\nCompleted At: 2026-09-12T01:36:36+02:00\nFile Path: `file:///mnt/home/japake298/project/GraphConjecturing/config.py`\nTotal Lines: 353\nTotal Bytes: 21872\nShowing lines 1 to 353\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: \"\"\"\n2: config.py — centralised configuration for the conjecture pipeline.\n3: All knobs are readable from environment variables or set programmatically.\n4: \"\"\"\n5: \n6: from __future__ import annotations\n7: import os\n8: from dataclasses import dataclass, field\n9: from typing import Optional\n10: \n11: \n12: @dataclass\n13: class Config:\n14:     # ------------------------------------------------------------------ LLM --\n15:     anthropic_api_key: str = field(\n16:         default_factory=lambda: os.environ.get(\"ANTHROPIC_API_KEY\", \"\")\n17:     )\n18:     model: str = \"claude-opus-4-6\"\n19:     llm_max_tokens: int = 4096\n20: \n21:     # -------------------------------------------------------- Graph database --\n22:     db_min_vertices: int = 3\n23:     db_max_vertices: int = 14\n24:     db_random_graphs: int = 15      # extra ER graphs to add beyond named ones\n25:     db_random_seed: int = 42\n26:     # Persistent invariant databases loaded by default (HoG rich invariants +\n27:     # the SRG / minimal-Ramsey / Cayley / cages / cographs / nauty / rigid\n28:     # families in graph_database_enriched.csv, plus the exhaustive n≤9 census).\n29:     # Empty ⇒ auto-resolve to whichever of these exist; falls back to a small\n30:     # synthetic build only if none are found.\n31:     db_csv_paths: tuple = (\n32:         \"database/graph_database_enriched.csv\",\n33:         \"database/census_le9.csv\",\n34:         \"database/txgraffiti_data.csv\",    # graph datasets bundled with TxGraffiti\n35:                                             # (sync_txgraffiti_data.py)\n36:         \"database/counterexamples.csv\",   # graphs found by the falsifiers (grows)\n37:     )\n38:     # Counterexamples discovered during a run are appended here so the dataset\n39:     # learns permanently (this file is also one of the db_csv_paths above).\n40:     counterexample_csv: str = \"database/counterexamples.csv\"\n41: \n42:     # ----------------------------------------------------- Adversarial filter --\n43:     adversarial_enabled: bool = True   # permanent counterexample-search stage\n44:     adversarial_max_n: int = 18        # max order of pool graphs (exact invariants)\n45:     adversarial_seed: int = 2025\n46:     # Also fold class-aware random models (random regular / G(n,p) / trees /\n47:     # bipartite …, several orders) into the adversarial pool, so refutation\n48:     # probes the typical interior of each class, not just structured witnesses.\n49:     adversarial_random_models: bool = True\n50:     adversarial_random_per: int = 4    # random graphs per (class, order)\n51: \n52:     # ----------------------------------------------- Hypothesis generation --\n53:     txgraffiti_max_conjectures: int = 30\n54:     txgraffiti_max_offset: float = 5.0\n55:     txgraffiti_coefficients: tuple = (0.5, 1.0, 1.5, 2.0, 3.0)\n56:     # Generation engine:\n57:     #   \"txgraffiti\" — the txgraffiti package (convex_hull/ratios/LP); finds the\n58:     #                  optimal real coefficients per facet (slower per call).\n59:     #   \"numpy\"      — the in-house vectorised fit over a fixed coefficient grid\n60:     #                  (txgraffiti_coefficients); much faster, coarser.\n61:     #   \"both\"       — union of the two (deduplicated by statement).\n62:     txgraffiti_engine: str = \"txgraffiti\"\n63:     # Generate bounds conditioned on graph classes (bipartite, regular, …),\n64:     # i.e. \"for all G with property P: f(G) ≤ …\".\n65:     txgraffiti_condition_on_classes: bool = True\n66:     # Allow multivariable right-hand sides:  f(G) ≤ a·g(G) + b·h(G) + c.\n67:     txgraffiti_multivariable: bool = True\n68:     txgraffiti_max_rhs_terms: int = 2   # 2 ⇒ permit one extra RHS invariant\n69:     txgraffiti_min_support: int = 5     # min graphs in a context before fitting\n70:     # Drop bounds that are an equality across the whole class (identities /\n71:     # within-class tautologies such as Δ = δ on regular graphs).\n72:     txgraffiti_drop_identities: bool = True\n73:     # Hide conjectures that merely rediscover a classical/trivial theorem\n74:     # (Whitney, Brooks, ω ≤ χ, ν ≤ n/2, …) so only novel bounds are kept.\n75:     txgraffiti_filter_known: bool = True\n76:     funsearch_conjectures: int = 5   # LLM-generated conjectures per call\n77:     use_funsearch: bool = True\n78: \n79:     # --------------------------------------------- Graffiti3 (native expr) --\n80:     # txgraffiti's Graffiti3 system: native-Python nonlinear conjecturing\n81:     # (ratio/LP/poly/products/sqrt/log + Sophie sufficient-conditions + Lean\n82:     # export). Runs on a SMALL exact corpus (the graph atlas, n ≤ max_n), since\n83:     # its STANDARD/DEEP runners are far too slow on large data.\n84:     graffiti3_enabled: bool = True\n85:     graffiti3_mode: str = \"fast\"     # \"fast\" (cheap) | \"standard\" | \"deep\"\n86:     graffiti3_max_n: int = 7         # corpus = connected atlas graphs up to this\n87:     graffiti3_sophie: bool = True    # also mine Sophie sufficient-conditions\n88:     # Generation-depth knobs for the CEGIS loop (pipeline.cegis._generate). These\n89:     # map directly onto graffiti3.conjecture(): `cegis_gen_mode` picks the FAST/\n90:     # STANDARD/DEEP preset (complexity + feature defaults), and the four feature\n91:     # toggles override that preset when set (None = inherit the preset). DEEP per\n92:     # round is far too slow on a large seed (its product/LP3 stages blow up), so\n93:     # the default stays FAST; raise these only on a small seed, or use the\n94:     # one-shot final-deep pass below. cegis_gen_complexity overrides the stage\n95:     # depth directly (0=CONSTANT, 1=+RATIO/LP1, 2=+LP2/POLY/SQRT/LOG, 3=+LP3/\n96:     # SQRT_LOG, ≥4=+MIXED/SQRT_PAIR/GEOM_MEAN/SQRT_SUM/LOG_SUM).\n97:     cegis_gen_mode: str = \"fast\"             # \"fast\" | \"standard\" | \"deep\"\n98:     cegis_gen_complexity: Optional[int] = None       # None = inherit from mode\n99:     cegis_gen_products: Optional[bool] = None        # include_invariant_products\n100:     cegis_gen_abs: Optional[bool] = None             # include_abs\n101:     cegis_gen_min_max: Optional[bool] = None         # include_min_max\n102:     cegis_gen_log: Optional[bool] = None             # include_log\n103:     cegis_gen_quick: Optional[bool] = None           # cheap correlation prefilter\n104:     # One-shot deep extraction: after the (cheap) FAST CEGIS loop converges the\n105:     # seed, run ONE richer generation pass on the final hardened seed, refute it,\n106:     # and merge its survivors. Gets DEEP's richness once per shard without paying\n107:     # it every round. Disabled by default.\n108:     cegis_final_deep_pass: bool = False\n109:     cegis_final_deep_mode: str = \"deep\"      # mode for the one-shot final pass\n110:     cegis_final_deep_complexity: Optional[int] = None\n111:     graffiti3_refute_random: bool = True   # refute against random models too\n112:     graffiti3_max_per_target: int = 40     # keep top-N (by touches) per target\n113:                                            # before the (per-candidate) refutation\n114: \n115:     # Sage Conjecturing stage: kept as an option; tune its grid coefficients to\n116:     # the optimal real values by LP (pipeline.tuning) when enabled.\n117:     sage_enabled: bool = True\n118:     sage_tune_coefficients: bool = True\n119:     # Ranking used when printing the final survivors: \"score\" | \"complexity\"\n120:     # (simplest first) | \"touches\".\n121:     report_sort_by: str = \"score\"\n122: \n123:     # ============================================ CEGIS mode (run_cegis.py) ==\n124:     # Counterexample-guided loop: generate on a small \"expressible\" seed (the\n125:     # TxGraffiti expressive graphs, full graphcalc battery), refute against\n126:     # tiered pools + active search, add witnesses back to the seed, repeat to a\n127:     # fixed point. See docs/CEGIS_PLAN.md.\n128:     cegis_rounds: int = 8               # max generate→refute passes (or fixed point)\n129:     cegis_workers: int = 16             # parallel workers for the per-candidate\n130:                                         # refute + active-search phases (fork; 0/1\n131:                                         # = serial). The pool/SA evals are\n132:                                         # embarrassingly parallel across candidates.\n133:     cegis_targets: tuple = ()           # restrict target invariants ((), = all numeric)\n134:     cegis_max_targets: int = 0          # cap #targets per round (0 = no cap)\n135:     cegis_filter_known: bool = True     # drop classical/trivial bounds\n136:     cegis_dalmatian: bool = True        # Dalmatian significance filter on the seed\n137:                                         # (prunes graffiti3's ~10^5 raw product\n138:                                         #  candidates to the non-dominated envelope)\n139:     cegis_morgan: bool = True           # Morgan hypothesis-maximality filter\n140:                                         # (drops over-conditioned redundant bounds)\n141:     cegis_drop_constant_bounds: bool = True   # drop degenerate invariant-vs-constant\n142:                                         # bounds (clique_number ≤ 20, 9 ≤ size, …);\n143:                                         # Sophie sufficient-conditions are exempt\n144:     # ---- optional evidence gates (both OFF by default) ---------------------\n145:     # These trade recall for precision, so they are opt-in rather than assumed.\n146:     #\n147:     # Support gate: a bound asserted on a class with only a handful of seed\n148:     # representatives survives for lack of counterexamples, not because it is\n149:     # true. Measured on the first sharded run, a threshold of 20 drops 4.3% of\n150:     # class-conditioned survivors and removes every one resting on <5 graphs.\n151:     # 0 disables. Risk: a genuine discovery about a rare class is discarded\n152:     # along with the noise, since both look identical from support alone.\n153:     cegis_min_hypothesis_support: int = 0\n154:     # Decorative gate: drop a conditioned bound whose relation holds on *every*\n155:     # seed graph, in or out of the class — the hypothesis restricts nothing.\n156:     # Risk: \"holds on every graph we have\" is not \"holds for every graph\", so a\n157:     # class-specific truth can be dropped when the corpus fails to separate the\n158:     # class from its complement. Prefer proposing the unconditioned form and\n159:     # letting refutation decide; see docs.\n160:     cegis_drop_decorative: bool = False\n161:     cegis_report_top: int = 40          # survivors to print/formalize/prove\n162:     # Seed corpus\n163:     exact_tier_max_n: int = 14          # graphs ≤ this get the full battery (≈1s/graph)\n164:     battery_cap_s: int = 90             # per-graph wall-clock cap for graphcalc\n165:     persist_seed: bool = True           # accumulate hard witnesses across runs\n166:     hard_seed_dir: str = \"database/hard_seed\"\n167:     cache_dir: str = \"database/cache\"\n168:     # Witness sharing between concurrent shards. A counterexample refutes\n169:     # conjectures about *any* invariant, so it is evidence for every shard,\n170:     # whereas a conjecture belongs to exactly one. Shards therefore keep private\n171:     # conjectures but publish witnesses to a single append-only log, which each\n172:     # re-reads at the start of every round. Without this each shard converges to\n173:     # its own local fixed point: the first sharded run left 2,350 survivors that\n174:     # another shard's witness already refuted.\n175:     shared_witness_log: str = \"database/hard_seed/shared_witnesses.g6\"\n176:     share_witnesses: bool = True\n177:     # Tier batteries are large, identical across shards and never written during\n178:     # a run, so they can live in one shared read-only directory while each shard\n179:     # keeps its own (frequently written) seed battery. Empty ⇒ use cache_dir.\n180:     tier_cache_dir: str = \"\"\n181:     # Where to look for battery rows a *peer* shard has already computed, so a\n182:     # shared witness is not re-measured once per shard. Safe without locking\n183:     # because each of these files has exactly one writer and is published by\n184:     # atomic rename (SeedCorpus._save_cache). Empty ⇒ never read peers.\n185:     peer_battery_glob: str = \"\"\n186:     # Refutation tiers (cheap → expensive); each is NaN-aware + coverage-masked\n187:     refute_symbolic: bool = True        # tier 0: constructively refute constant/\n188:                                         # degree bounds (order≤14, Δ≤3, …) by\n189:                                         # building an extremal witness — catches\n190:                                         # false bounds a bounded-order search misses\n191:     refute_use_families: bool = True    # atlas + named families (exact battery)\n192:     refute_use_random: bool = True      # class-aware random models (exact battery)\n193:     # Disconnected / edgeless / isolate-bearing graphs. Only 0.28% of the usable\n194:     # pool is disconnected (the census tier is connected by construction), so\n195:     # without this tier a bound false only on a degenerate graph survives for\n196:     # want of a witness. Cheap: a few hundred small graphs.\n197:     refute_use_degenerate: bool = True\n198:     refute_random_per: int = 6\n199:     refute_families_max_n: int = 12     # cap n for the (expensive) family battery\n200:     # Ingest the HoG enriched export's *already-computed* invariants directly\n201:     # (partial, NaN-aware) — covers BIG graphs the n≤14 battery can't, at ~zero\n202:     # cost (no recomputation). The mapped subset (~28 invariants) is enough to\n203:     # refute any conjecture phrased over them; others are coverage misses.\n204:     refute_use_hog: bool = True\n205:     refute_hog_csv: str = \"database/graph_database_enriched.csv\"\n206:     refute_hog_max_n: int = 60          # cap witness order (memory/relevance)\n207:     refute_use_bigdb: bool = True       # offline full-battery tier (n≤14, recomputed)\n208:     cegis_max_sophie: int = 400         # keep the top-N most significant Sophie\n209:                                         # sufficient-conditions (graffiti3 emits\n210:                                         # ~10^4; ranked by support, not arbitrary).\n211:                                         # Dalmatian/Morgan are inequality-only, so\n212:                                         # Sophie gets its own significance filter.\n213:     # Active counterexample search (run on survivors of pool refutation), tried\n214:     # cheapest-first per candidate: z3 (exact, encodable invariants) → vns → sa →\n215:     # cross_entropy → mcts → rl. All but z3 are black-box over the graphcalc\n216:     # battery. The trial budget is *order-adaptive*: the orders sweep from small\n217:     # to large and the per-order trial count is scaled down ∝ ref/n, so big\n218:     # graphs (expensive evals) get proportionally fewer trials.\n219:     cegis_searchers: tuple = (\"z3\", \"cross_entropy\", \"vns\", \"sa\", \"mcts\", \"rl\")\n220:     cegis_max_search: int = 40          # max pool-survivors/round given active\n221:                                         # search (rest kept as pool-survivors)\n222:     # Per-candidate wall-clock budget across ALL its searchers; bounds round time\n223:     # regardless of invariant cost, so big orders below are safe to probe.\n224:     search_time_budget_s: int = 15\n225:     # Search sweeps small→large orders; big graphs cost seconds/eval (exact ILP\n226:     # invariants) but the per-candidate time budget above means a candidate just\n227:     # runs out of budget instead of stalling, so probing large orders is safe.\n228:     search_orders: tuple = (6, 8, 10, 12, 14, 16, 20, 24, 30, 40, 50)\n229:     search_order_ref: int = 6           # reference order for trial scaling\n230:     search_min_trials: int = 12         # floor on per-order trials at large n\n231:     search_eval_cap_s: int = 3          # per-graph invariant-eval timeout\n232:     # Keep the searchers inside the conjecture's hypothesis class: class-aware\n233:     # starts, class-preserving moves, and a restricted action set / RL action\n234:     # mask where the class is an edge-set restriction (pipeline/search/\n235:     # class_moves.py). A conjecture conditioned on a class says nothing about\n236:     # graphs outside it, so `violation` scores those -inf; the median survivor's\n237:     # hypothesis holds on 0.07% of the refutation pool, which made that -inf the\n238:     # whole landscape. Set False to reproduce the unconstrained search that\n239:     # produced the published run.\n240:     search_class_constrained: bool = True\n241:     sa_iterations: int = 120            # base SA steps (scaled down per order)\n242:     sa_restarts: int = 1\n243:     rl_episodes: int = 40               # rlgt deep-CE / REINFORCE iterations\n244:     rl_candidates: int = 200            # rlgt candidates_count per iteration\n245:     rl_agent: str = \"deep_cross_entropy\"    # \"deep_cross_entropy\" | \"reinforce\"\n246:     rl_enabled: bool = True             # set False to skip torch/rlgt entirely\n247:     rl_max_search: int = 8              # RL is heavy (torch agent per conjecture),\n248:                                         # so it runs only as a bounded post-phase on\n249:                                         # the top-K pool/SA survivors per round\n250:     # Wall-clock self-limit (0 = unlimited): lets a long depth-first run on a\n251:     # shared cluster bound itself to fit inside a SLURM --time allocation\n252:     # instead of relying on a hard kill (which would lose whatever the round/\n253:     # prove loop hadn't persisted yet). Checked once per round / per prove\n254:     # attempt; breaks cleanly and keeps whatever was already computed.\n255:     cegis_time_budget_s: int = 0\n256:     prove_time_budget_s: int = 0\n257:     # Concurrency for the survivor reprove loop. The loop was sequential (1\n258:     # request in flight → no vLLM batching → ~5 min/generation), so a full pass@k\n259:     # sweep took hours. Running N proofs concurrently lets vLLM batch them; with N\n260:     # small enough that each request still completes inside the shim timeout, we\n261:     # get both throughput and completion. Thread-safe: each prove() is an\n262:     # independent HTTP call + a unique-tempfile bare-lean check.\n263:     prove_concurrency: int = 8\n264:     # Hard per-phase wall-clock cap (seconds) for the parallel refute/search\n265:     # pools. Guards against a single eval hanging a worker forever: the per-eval\n266:     # SIGALRM cannot interrupt a C-extension ILP solver (exact χ/ω/α on a large\n267:     # search graph), but the pool deadline + terminate() (SIGTERM) can. On\n268:     # timeout, unfinished candidates are kept as survivors (never false-refuted).\n269:     # 0 = no cap.\n270:     cegis_phase_timeout_s: int = 2400        # 40 min/phase\n271: \n272:     # --------------------------------------------------- Falsification loop --\n273:     falsification_rounds: int = 2    # retry passes after db augmentation\n274:     z3_enabled: bool = True\n275:     z3_timeout_ms: int = 10_000     # per Z3 solver call\n276:     z3_max_n: int = 9               # max graph size for Z3 search\n277:     mcts_iterations: int = 800\n278:     mcts_c: float = 1.41            # UCT exploration constant\n279:     mcts_n_vertices: int = 9\n280:     vns_iterations: int = 600\n281:     vns_k_max: int = 4              # max neighbourhood size\n282:     ce_iterations: int = 200\n283:     ce_population: int = 60\n284:     ce_elite_frac: float = 0.2\n285:     ce_n_vertices: int = 10\n286: \n287:     # ---------------------------------------------- Autoformalization stub --\n288:     # Lean 4 + mathlib kernel-checking. `lean_binary` is resolved via PATH or an\n289:     # absolute elan path; when `lean_project_root` points at a mathlib-backed\n290:     # lake project, proofs are compiled with `lake env lean` (so the mathlib\n291:     # search path + `import Mathlib` are available and kernel-verified).\n292:     lean_binary: str = field(\n293:         default_factory=lambda: (\n294:             os.path.expanduser(\"~/.elan/bin/lean\")\n295:             if os.path.exists(os.path.expanduser(\"~/.elan/bin/lean\")) else \"lean\"\n296:         )\n297:     )\n298:     lake_binary: str = field(\n299:         default_factory=lambda: (\n300:             os.path.expanduser(\"~/.elan/bin/lake\")\n301:             if os.path.exists(os.path.expanduser(\"~/.elan/bin/lake\")) else \"lake\"\n302:         )\n303:     )\n304:     lean_timeout_s: int = 180        # mathlib import + elaboration can be slow\n305:     lean_project_root: str = field(\n306:         default_factory=lambda: (\n307:             p if os.path.isdir(p := os.path.join(\n308:                 os.path.dirname(os.path.abspath(__file__)), \"lean_project\")) else \"\"\n309:         )\n310:     )\n311: \n312:     # ------------------------------------------------------- Provers --------\n313:     # Ordered ensemble of prover backends tried per conjecture (first success\n314:     # wins). Registered names: \"lean\" (local Lean tactics), \"claude\" (Anthropic\n315:     # API, kernel-verified when a Lean binary is present), \"goedel\"/\"deepseek\"\n316:     # (HTTP stubs — point prover_api_url at a self-hosted GPU endpoint to enable).\n317:     prover_backends: tuple = (\"lean\", \"deepseek-local\", \"claude\", \"goedel\", \"deepseek\")\n318:     prover_api_url: str = \"\"        # e.g. \"https://goedel-prover.example.com/v1\"\n319:     prover_api_key: str = field(\n320:         default_factory=lambda: os.environ.get(\"PROVER_API_KEY\", \"\")\n321:     )\n322:     prover_timeout_s: int = 120\n323:     # Local GPU prover: DeepSeek-Prover-V2 loaded in-process via 🤗 transformers\n324:     # (no API tokens). Heavy — pulls ~14 GB of weights and needs a CUDA GPU — so\n325:     # it is import/availability-guarded and only the \"deepseek-local\" backend\n326:     # activates it. The Lean theorems are kernel-verified against the pinned\n327:     # mathlib + the GraphInvariants preamble, exactly like the other backends.\n328:     deepseek_local_enabled: bool = True\n329:     deepseek_model_id: str = \"deepseek-ai/DeepSeek-Prover-V2-7B\"\n330:     deepseek_max_new_tokens: int = 4096       # plan+proof for these short goals;\n331:     # 8192 caused a timeout death-spiral on the 671B vLLM server (a full\n332:     # generation at ~3.5 tok/s solo ≈ 2340s ≈ the shim's 2400s cap → attempts\n333:     # time out, but vLLM keeps generating them server-side → zombie requests pile\n334:     # up, dilute the GPU to ~1 tok/s each, and cascade: 38/43 timed out). 4096\n335:     # completes in ~1200s solo, well inside the cap.\n336:     deepseek_dtype: str = \"bfloat16\"          # \"bfloat16\" | \"float16\"\n337:     deepseek_seed: int = 30\n338:     deepseek_attempts: int = 4                # pass@k sampled proof attempts\n339:     deepseek_temperature: float = 1.0         # sampling temperature (attempts ≥2)\n340:     # Lean preamble module imported by every generated theorem so the graph\n341:     # invariants (order/size/min-max degree/clique/independence/domination …)\n342:     # resolve to real mathlib-backed definitions.\n343:     lean_preamble_import: str = \"import LeanProject.GraphInvariants\"\n344: \n345:     # --------------------------------------------------------------- Output --\n346:     output_dir: str = \"results\"\n347:     verbose: bool = True\n348:     save_graphs: bool = False       # save networkx graphs to JSON (large)\n349: \n350: \n351: # Module-level singleton — replace or monkey-patch as needed.\n352: CONFIG = Config()\n353: \nThe above content shows the entire, complete file contents of the requested file.\n"}
