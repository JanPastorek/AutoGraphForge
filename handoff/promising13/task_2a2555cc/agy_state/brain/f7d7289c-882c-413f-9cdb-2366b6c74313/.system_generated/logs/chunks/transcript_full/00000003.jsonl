ype} [Fintype V] [DecidableEq V] (G : SimpleGraph V) [DecidableRel G.Adj]\n+    {v w : V} (p : G.Walk v w) : w ∈ GraphCalc.ballWithin G p.length v := by\n+  have h := mem_ballWithin_of_walk_reverse G p.reverse\n+  rw [SimpleGraph.Walk.length_reverse] at h\n+  exact h\n+\n+lemma finset_min_getD_le {s : Finset ℕ} {b : ℕ} (hb : b ∈ s) :\n+    s.min.getD 0 ≤ b := by\n+  have h : s.min ≤ WithTop.some b := Finset.inf_le hb\n+  cases hm : s.min with\n+  | top =>\n+    rw [hm] at h\n+    simp at h\n+  | coe m =>\n+    rw [hm] at h\n+    exact WithTop.coe_le_coe.mp h\n+\n+lemma radius_le_eccentricity {V : Type} [Fintype V] [DecidableEq V]\n+    (G : SimpleGraph V) [DecidableRel G.Adj] (v : V) :\n+    GraphCalc.radius G ≤ GraphCalc.eccentricity G v := by\n+  apply finset_min_getD_le\n+  apply Finset.mem_image.mpr\n+  exact ⟨v, Finset.mem_univ v, rfl⟩\n+\n+lemma finset_min_getD_le_of_mem (n : ℕ) {s : Finset ℕ} {b : ℕ} (hb : b ∈ s) :\n+    s.min.getD n ≤ b := by\n+  have h : s.min ≤ WithTop.some b := Finset.inf_le hb\n+  cases hm : s.min with\n+  | top =>\n+    rw [hm] at h\n+    simp at h\n+  | coe m =>\n+    rw [hm] at h\n+    exact WithTop.coe_le_coe.mp h\n+\n+lemma eccentricity_le_of_ballWithin_eq_univ {V : Type} [Fintype V] [DecidableEq V]\n+    (G : SimpleGraph V) [DecidableRel G.Adj] (v : V) (k : ℕ)\n+    (hkle : k ≤ Fintype.card V) (heq : GraphCalc.ballWithin G k v = Finset.univ) :\n+    GraphCalc.eccentricity G v ≤ k := by\n+  dsimp [GraphCalc.eccentricity, GraphCalc.minUpTo]\n+  apply finset_min_getD_le_of_mem (Fintype.card V)\n+  rw [Finset.mem_filter, Finset.mem_range]\n+  exact ⟨Nat.lt_succ_of_le hkle, heq⟩\n+\n+lemma ballWithin_univ_of_subset {V : Type} [Fintype V] [DecidableEq V]\n+    (G : SimpleGraph V) [DecidableRel G.Adj] (v : V) (k : ℕ) (S : Finset V)\n+    (hdom : GraphCalc.IsTotalDominatingSet G S)\n+    (hsub : S ⊆ GraphCalc.ballWithin G k v) :\n+    GraphCalc.ballWithin G (k + 1) v = Finset.univ := by\n+  apply Finset.eq_univ_of_forall\n+  intro u\n+  obtain ⟨s, hs, hadj⟩ := hdom u\n+  have hsb : s ∈ GraphCalc.ballWithin G k v := hsub hs\n+  exact mem_ballWithin_succ_of_adj G k v s u hsb hadj.symm\n \n[diff_block_end]\n\nPlease note that the above snippet only shows the MODIFIED lines from the last change. It shows up to 3 lines of unchanged lines before and after the modified lines. The actual file contents may have many more lines not shown.\n\nWe did our best to apply changes despite some inaccuracies. Double check if the edit applied is what you intended."}
