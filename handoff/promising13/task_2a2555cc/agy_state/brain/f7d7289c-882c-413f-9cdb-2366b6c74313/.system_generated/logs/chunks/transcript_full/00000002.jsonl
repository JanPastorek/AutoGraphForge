ind =]\n234: theorem dist_self : dist G v v = 0 := by simp\n235: \n236: protected theorem Reachable.dist_eq_zero_iff (hr : G.Reachable u v) :\n237:     G.dist u v = 0 ↔ u = v := by simp [hr]\n238: \n239: protected theorem Reachable.pos_dist_of_ne (h : G.Reachable u v) (hne : u ≠ v) :\n240:     0 < G.dist u v :=\n241:   Nat.pos_of_ne_zero (by simp [h, hne])\n242: \n243: protected theorem Reachable.one_lt_dist_of_ne_of_not_adj (h : G.Reachable u v) (hne : u ≠ v)\n244:     (hnadj : ¬G.Adj u v) : 1 < G.dist u v :=\n245:   Nat.lt_of_le_of_ne (h.pos_dist_of_ne hne) (by\n246:     by_contra hc\n247:     obtain ⟨p, hp⟩ := Reachable.exists_walk_length_eq_dist h\n248:     exact hnadj (Walk.exists_length_eq_one_iff.mp ⟨p, hc ▸ hp⟩))\n249: \n250: protected theorem Connected.dist_eq_zero_iff (hconn : G.Connected) :\n251:     G.dist u v = 0 ↔ u = v := by simp [hconn u v]\n252: \n253: protected theorem Connected.pos_dist_of_ne (hconn : G.Connected) (hne : u ≠ v) :\n254:     0 < G.dist u v :=\n255:   Nat.pos_of_ne_zero fun h ↦ False.elim <| hne <| (hconn.dist_eq_zero_iff).mp h\n256: \n257: protected theorem Connected.one_lt_dist_of_ne_of_not_adj (h : G.Connected) (hne : u ≠ v)\n258:     (hnadj : ¬G.Adj u v) : 1 < G.dist u v :=\n259:   Reachable.one_lt_dist_of_ne_of_not_adj (h u v) hne hnadj\n260: \n261: theorem dist_eq_zero_of_not_reachable (h : ¬G.Reachable u v) : G.dist u v = 0 := by\n262:   simp [h]\n263: \n264: theorem nonempty_of_pos_dist (h : 0 < G.dist u v) :\n265:     (Set.univ : Set (G.Walk u v)).Nonempty := by\n266:   rw [dist_eq_sInf] at h\n267:   simpa [Set.range_nonempty_iff_nonempty, Set.nonempty_iff_univ_nonempty] using\n268:     Nat.nonempty_of_pos_sInf h\n269: \n270: protected theorem Connected.dist_triangle (hconn : G.Connected) :\n271:     G.dist u w ≤ G.dist u v + G.dist v w := by\n272:   obtain ⟨p, hp⟩ := hconn.exists_walk_length_eq_dist u v\n273:   obtain ⟨q, hq⟩ := hconn.exists_walk_length_eq_dist v w\n274:   rw [← hp, ← hq, ← Walk.length_append]\n275:   apply