132: theorem edist_eq_one_iff_adj : G.edist u v = 1 ↔ G.Adj u v := by\n133:   refine ⟨fun h ↦ ?_, fun h ↦ ?_⟩\n134:   · obtain ⟨w, hw⟩ := exists_walk_of_edist_ne_top <| by rw [h]; simp\n135:     exact w.adj_of_length_eq_one <| Nat.cast_eq_one.mp <| h ▸ hw\n136:   · exact le_antisymm (edist_le h.toWalk) (Order.one_le_iff_pos.mpr <| edist_pos_of_ne h.ne)\n137: \n138: lemma edist_le_one_iff_adj_or_eq : G.edist u v ≤ 1 ↔ G.Adj u v ∨ u = v := by\n139:   by_cases huv : u = v\n140:   · simp [huv]\n141:   · simp only [huv, or_false]\n142:     have h : 0 < G.edist u v := edist_pos_of_ne huv\n143:     rw [(Order.one_le_iff_pos.mpr h).ge_iff_eq']\n144:     exact edist_eq_one_iff_adj\n145: \n146: lemma edist_eq_two_iff {u v : V} :\n147:     G.edist u v = 2 ↔ u ≠ v ∧ ¬ G.Adj u v ∧ (G.commonNeighbors u v).Nonempty := by\n148:   refine ⟨fun h ↦ ⟨?_, ?_, ?_⟩, fun h ↦ le_antisymm ?_ ?_⟩\n149:   · simp +decide [← G.edist_eq_zero_iff.not (b := u = v), h]\n150:   · simp +decide [← edist_eq_one_iff_adj, h]\n151:   · obtain ⟨w, hw⟩ := exists_walk_of_edist_eq_coe h\n152:     use w.getVert 1\n153:     suffices w.getVert 1 ∈ G.commonNeighbors (w.getVert 0) (w.getVert w.length) by simpa\n154:     refine hw ▸ G.mem_commonNeighbors.mp ?_\n155:     exact ⟨w.adj_getVert_succ (by simp [hw]), (w.adj_getVert_succ (by simp [hw])).symm⟩\n156:   · obtain ⟨w, hw⟩ := h.2.2\n157:     rw [mem_commonNeighbors] at hw\n158:     have := (Walk.cons hw.1 <| .cons hw.2.symm .nil).edist_le\n159:     simp_all\n160:   · by_contra\n161:     simp_all [Order.le_one_iff]\n162: \n163: lemma two_lt_edist_iff {u v : V} :\n164:     2 < G.edist u v ↔ u ≠ v ∧ ¬ G.Adj u v ∧ (G.commonNeighbors u v) = ∅ := by\n165:   refine ⟨fun h ↦ ?_, fun h ↦ lt_of_le_of_ne ?_ (Ne.symm ?_)⟩\n166:   · have hn : u ≠ v := fun hc ↦ by simp [hc] at h\n167:     have : ¬ G.Adj u v := fun hc ↦ by simp +decide [edist_eq_one_iff_adj.mpr hc] at h\n168:     use hn, this\n169:     by_contra! hc\n170:     simp [edist_eq_two_iff.mpr ⟨hn, this, hc⟩] at h\n17