sion. -/\n331: lemma connected_iff_diam_ne_zero [Finite α] [Nontrivial α] : G.Connected ↔ G.diam ≠ 0 := by\n332:   rw [connected_iff_ediam_ne_top, not_iff_not, diam_eq_zero_iff_ediam_eq_top]\n333: \n334: end diam\n335: \n336: section radius\n337: \n338: /-- The radius of a simple graph is the minimum eccentricity of any vertex. -/\n339: noncomputable def radius (G : SimpleGraph α) : ℕ∞ :=\n340:   ⨅ u, G.eccent u\n341: \n342: lemma radius_eq_iInf_iSup_edist : G.radius = ⨅ u, ⨆ v, G.edist u v :=\n343:   rfl\n344: \n345: lemma radius_le_eccent {u : α} : G.radius ≤ G.eccent u :=\n346:   iInf_le G.eccent u\n347: \n348: lemma exists_eccent_eq_radius [Nonempty α] : ∃ u, G.eccent u = G.radius :=\n349:   ENat.exists_eq_iInf G.eccent\n350: \n351: lemma exists_edist_eq_radius_of_finite [Nonempty α] [Finite α] :\n352:     ∃ u v, G.edist u v = G.radius := by\n353:   obtain ⟨w, hw⟩ := G.exists_eccent_eq_radius\n354:   obtain ⟨v, hv⟩ := G.exists_edist_eq_eccent_of_finite w\n355:   use w, v\n356:   rw [hv, hw]\n357: \n358: lemma radius_eq_top_of_not_connected (h : ¬ G.Connected) : G.radius = ⊤ := by\n359:   simp [radius, eccent_eq_top_of_not_connected h]\n360: \n361: lemma radius_eq_top_of_isEmpty [IsEmpty α] : G.radius = ⊤ :=\n362:   iInf_of_empty G.eccent\n363: \n364: lemma radius_ne_top_iff [Nonempty α] [Finite α] : G.radius ≠ ⊤ ↔ G.Connected := by\n365:   refine ⟨Not.imp_symm radius_eq_top_of_not_connected, fun h ↦ ?_⟩\n366:   obtain ⟨u, v, huv⟩ := G.exists_edist_eq_radius_of_finite\n367:   rw [← huv, edist_ne_top_iff_reachable]\n368:   exact h u v\n369: \n370: lemma radius_ne_zero_of_nontrivial [Nontrivial α] : G.radius ≠ 0 := by\n371:   rw [← Order.one_le_iff_ne_zero]\n372:   apply le_iInf\n373:   simp [Order.one_le_iff_ne_zero, G.eccent_ne_zero]\n374: \n375: lemma radius_eq_zero_iff : G.radius = 0 ↔ Nonempty α ∧ Subsingleton α := by\n376:   refine ⟨fun h ↦ ⟨?_, ?_⟩, fun ⟨_, _⟩ ↦ ?_⟩\n377:   · contrapose! h\n378:     simp [radius]\n379:   · contrapose! h\n380:     simp [radius_ne_zero_of_nontrivial]\n381:   · rw [radius, ENat.iInf_eq_zero]\n382:     use Classical.ofNonempty\n383:     simpa [eccent] using Subsingleton.elim _\n384: \n385: lemma radius_le_ediam [Nonempty α] : G.radius ≤ G.ediam :=\n386:   iInf_le_iSup\n387: \n388: lemma ediam_eq_top_iff_radius_eq_top [Nonempty α] : G.ediam = ⊤ ↔ G.radius = ⊤ := by\n389:   refine ⟨?_, fun hr ↦ eq_top_iff.mpr (hr ▸ radius_le_ediam)⟩\n390:   contrapose\n391:   intro hr\n392:   obtain ⟨w, hw⟩ := G.exists_eccent_eq_radius\n393:   have hdiam : G.ediam ≤ 2 * G.eccent w := ediam_le_two_mul_eccent w\n394:   exact ne_top_of_lt <| lt_of_le_of_lt hdiam <| WithTop.mul_lt_top (ENat.coe_lt_top 2) <|\n395:     lt_top_iff_ne_top.mpr (hw ▸ hr)\n396: \n397: lemma ediam_le_two_mul_radius : G.ediam ≤ 2 * G.radius := by\n398:   cases isEmpty_or_nonempty α\n399:   · rw [radius_eq_top_of_isEmpty]\n400:     exact le_top\n401:   · by_cases hdiam : G.ediam = ⊤\n402:     · simp [hdiam, ediam_eq_top_iff_radius_eq_top.mp hdiam]\n403:     · obtain ⟨w, hw⟩ := G.exists_eccent_eq_radius\n404:       obtain ⟨_, _, h⟩ := G.exists_edist_eq_ediam_of_ne_top hdiam\n405:       apply le_trans (h ▸ G.edist_triangle (v := w))\n406:       rw [two_mul]\n407:       exact hw ▸ add_le_add (G.edist_comm ▸ G.edist_le_eccent) G.edist_le_eccent\n408: \n409: lemma radius_eq_ediam_iff [Nonempty α] :\n410:     G.radius = G.ediam ↔ ∃ e, ∀ u, G.eccent u = e := by\n411:   refine ⟨fun h ↦ ?_, fun h ↦ ?_⟩\n412:   · use G.radius\n413:     intro u\n414:     exact le_antisymm (h ▸ eccent_le_ediam) radius_le_eccent\n415:   · obtain ⟨e, h⟩ := h\n416:     have ediam_eq : G.ediam = e :=\n417:       le_antisymm (iSup_le fun u ↦ (h u).le) ((h Classical.ofNonempty) ▸ eccent_le_ediam)\n418:     rw [ediam_eq]\n419:     exact le_antisymm ((h Classical.ofNonempty) ▸ radius_le_eccent) (le_iInf fun u ↦ (h u).ge)\n420: \n421: @[simp]\n422: lemma radius_bot [Nontrivial α] : (⊥ : SimpleGraph α).radius = ⊤ :=\n423:   radius_eq_top_of_not_connected not_connected_bot\n424: \n425: @[simp]\n426: lemma radius_top [Nontrivial α] : (⊤ : SimpleGraph α).radius = 1 := by\n427:   simp [radius]\n428: \n429: end radius\n430: \n431: section center\n432: \n433: /-- The center of a simple graph is the set of vertices with eccentricity equal to the radius. -/\n434: def center (G : SimpleGraph α) : Set α :=\n435:   {u | G.eccent u = G.radius}\n436: \n437: lemma center_nonempty [Nonempty α] : G.center.Nonempty :=\n438:   exists_eccent_eq_radius\n439: \n440: lemma mem_center_iff (u : α) : u ∈ G.center ↔ G.eccent u = G.radius := .rfl\n441: \n442: lemma center_eq_univ_iff_radius_eq_ediam [Nonempty α] :\n443:     G.center = Set.univ ↔ G.radius = G.ediam := by\n444:   rw [radius_eq_ediam_iff, ← Set.univ_subset_iff]\n445:   refine ⟨fun h ↦ ?_, fun h ↦ ?_⟩\n446:   · use G.radius\n447:     exact fun _ ↦ h trivial\n448:   · obtain ⟨e, h⟩ := h\n449:     intro u hu\n450:     rw [mem_center_iff, h u]\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
